{
  "name": "the-porters",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:facts": "node scripts/check-facts.mjs",
    "check:forbidden": "node scripts/check-forbidden-content.mjs",
    "cms:discover": "astro build && node scripts/generate-cms-registry.mjs && node scripts/verify-cms-discovery.mjs",
    "cms:seed": "node scripts/generate-cms-registry.mjs",
    "cms:check": "node scripts/verify-cms-discovery.mjs && node scripts/verify-reveal.mjs",
    "cms:verify": "node scripts/verify-cms.mjs",
    "cms:admin": "node scripts/create-cms-admin.mjs",
    "cms:backup": "node scripts/cms-backup.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.0",
    "flexsearch": "^0.8.212",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "linkedom": "^0.18.13",
    "typescript": "^6.0.3"
  }
}
