---
import PageLayout from '../layouts/PageLayout.astro';
import { pageSeo } from '../data/seo.data';

const entities = [
  {
    year: '2016',
    name: 'The Porters',
    role: 'Le portage salarial',
    text: 'Pour les consultants qui ont trouvé leur mission et veulent conserver leur autonomie avec un contrat de travail, une paie et une protection sociale.',
    cta: 'Comprendre le portage',
    href: '/portage-salarial',
  },
  {
    year: '2018',
    name: 'The Big Porters',
    role: 'L’ESN spécialisée IT',
    text: 'Pour les entreprises qui cherchent une expertise : cadrage du besoin, sélection des profils et suivi de la mission.',
    cta: 'Découvrir l’offre entreprises',
    href: '/entreprises',
  },
];

const principles = [
  {
    title: 'Comprendre le métier',
    text: 'Nous partons du rôle, de l’environnement technique et des responsabilités réelles.',
  },
  {
    title: 'Rendre le cadre lisible',
    text: 'Contrats, frais, facturation et paie sont expliqués avant le démarrage.',
  },
  {
    title: 'Laisser l’expert autonome',
    text: 'Le consultant choisit ses missions, négocie son TJM et garde la relation opérationnelle.',
  },
  {
    title: 'Rester joignable',
    text: 'Un interlocuteur identifié suit la mission et ses sujets administratifs.',
  },
];
---

<PageLayout seo={pageSeo.quiSommesNous} breadcrumbs={[{ label: 'Qui sommes-nous' }]}>
  <section class="bg-porters-navy py-24 text-porters-white lg:py-32">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-4xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Le groupe Porters</p>
        <h1 class="max-w-4xl text-porters-white">Deux métiers. Une même exigence&nbsp;: bien cadrer les missions IT.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-porters-white/75">
          Nous accompagnons les consultants qui veulent exercer librement et les entreprises qui cherchent
          une expertise qualifiée. Le statut change&nbsp;; l’exigence de clarté reste la même.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Notre structure</p>
        <h2>La bonne porte selon votre besoin</h2>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        {entities.map((entity) => (
          <article class="border-t-2 border-porters-gold bg-porters-navy/[0.03] p-7 reveal lg:p-9">
            <div class="mb-6 flex items-start justify-between gap-6">
              <div>
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-porters-gold">{entity.role}</p>
                <h3 class="mb-0 text-2xl">{entity.name}</h3>
              </div>
              <span class="font-mono text-sm font-semibold text-porters-navy/45">{entity.year}</span>
            </div>
            <p class="text-porters-black/66">{entity.text}</p>
            <a class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-porters-navy" href={entity.href}>
              {entity.cta} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Notre façon de travailler</p>
        <h2>Quatre principes, sans grand discours</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {principles.map((principle, index) => (
          <article class="border-t border-porters-navy/15 pt-5 reveal">
            <span class="font-mono text-xs font-semibold text-porters-gold">0{index + 1}</span>
            <h3 class="mt-4 text-lg">{principle.title}</h3>
            <p class="mb-0 mt-3 text-sm leading-relaxed text-porters-black/64">{principle.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-12 max-w-3xl border-l-2 border-porters-gold pl-5 text-sm leading-relaxed text-porters-black/65 reveal">
        The Porters est adhérente à la Fédération des Entreprises de Portage Salarial. Le portage salarial
        est encadré par le Code du travail, l’accord national interprofessionnel de 2008 et l’ordonnance du
        2&nbsp;avril&nbsp;2015.
      </p>
    </div>
  </section>

  <section class="bg-porters-navy py-16 text-porters-white">
    <div class="container mx-auto flex flex-col gap-7 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div class="max-w-2xl reveal">
        <h2 class="mb-2 text-porters-white">Consultant ou entreprise&nbsp;: partons de votre besoin.</h2>
        <p class="mb-0 text-porters-white/65">Un échange suffit pour identifier le bon cadre et la prochaine étape.</p>
      </div>
      <a href="/rendez-vous" class="btn btn-gold shrink-0">Parler à l’équipe</a>
    </div>
  </section>
</PageLayout>
