---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import SiteIcon from '../components/ui/SiteIcon.astro';
import TeamPortraitHero from '../components/about/TeamPortraitHero.astro';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import LogoMarquee from '../components/ui/LogoMarquee.astro';
import { pageSeo } from '../data/seo.data';
import { expertiseSections } from '../data/expertise-sections.data';
import bigPortersLogo from '../assets/brands/big-porters-wordmark.png';
import ericTwoOffers from '../assets/about/eric-two-offers.png';
import lisaExpertiseGuide from '../assets/about/lisa-expertise-guide.png';

const history = [
  { marker: '2016', title: 'Le portage salarial, dès l’origine', text: 'The Porters est créée pour porter l’activité de consultants indépendants : un contrat de travail, une paie, une protection sociale, et la liberté de choisir ses missions.' },
  { marker: '2018', title: 'Une seconde façon d’intervenir', text: 'The Big Porters rejoint le groupe. C’est une ESN spécialisée IT : là où le portage salarie un consultant qui a trouvé sa mission, l’ESN répond à une entreprise qui cherche encore son profil.' },
  { marker: 'Aujourd’hui', title: 'Un écosystème spécialisé', text: 'The Porters et The Big Porters articulent deux façons d’intervenir : le portage salarial pour le consultant, la prestation IT pour l’entreprise. Un même vivier, un même niveau d’exigence.' },
  { marker: 'Notre cadre', title: 'Adhérents de la FEPS', text: 'The Porters adhère à la Fédération des Entreprises de Portage Salarial. Le portage y est encadré par le Code du travail, l’ANI de 2008 et l’ordonnance du 2 avril 2015.' },
];

const ecosystemExpertises = ['Cybersécurité', 'Big Data / Cloud / IA', 'DevOps', 'Agilité'];
const ecosystemPartners = [
  { name: 'Atos', url: '/images/logos/partners/atos.svg' },
  { name: 'Capgemini', url: '/images/logos/partners/capgemini.svg' },
  { name: 'BPCE', url: '/images/logos/partners/partner-1-320.avif' },
  { name: 'Groupama', url: '/images/logos/partners/partner-2-320.avif' },
  { name: 'Airbus', url: '/images/logos/partners/partner-3-320.avif' },
  { name: 'GFI', url: '/images/logos/partners/gfi.svg' },
  { name: 'Safran', url: '/images/logos/partners/partner-4-320.avif' },
  { name: 'Thales', url: '/images/logos/partners/partner-5-320.avif' },
  { name: 'SGI', url: '/images/logos/partners/sgi.svg' },
];

const responsibilityCommitments = [
  { title: 'Numérique responsable', text: 'Une charte, un référent désigné et des pratiques d’éco-conception inspirées du RGESN et du Green IT.' },
  { title: 'Accessibilité', text: 'Les prestations qui touchent aux interfaces s’appuient sur le RGAA et les recommandations WCAG dès la conception.' },
  { title: 'Sobriété opérationnelle', text: 'Gestion administrative dématérialisée, train privilégié et équipements réparés ou reconditionnés lorsque c’est possible.' },
  { title: 'Diversité', text: 'Le groupe est signataire de la Charte de la diversité et évalue les candidatures sur les compétences, l’expérience et le savoir-être.' },
];
---

<PageLayout seo={pageSeo.quiSommesNous} noBreadcrumbs>
  <section class="about-section ecosystem-section brand-ambient-host" aria-labelledby="ecosystem-title" data-ecosystem-intro>
    <div class="about-shell">
      <header class="section-head" data-ecosystem-text>
        <p>L’écosystème Porters</p>
        <h1 id="ecosystem-title">Un groupe,<br />deux façons de travailler.</h1>
        <strong>Selon que vous êtes consultant ou entreprise, vous ne frappez pas à la même porte.</strong>
      </header>

      <div class="ecosystem-stage" data-motion-scene>
        <div class="ecosystem-stage-shape ecosystem-stage-shape--gold" aria-hidden="true"></div>
        <div class="ecosystem-stage-shape ecosystem-stage-shape--navy" aria-hidden="true"></div>
        <div class="ecosystem-stage-label" data-ecosystem-label>Nos domaines d’expertise</div>
        <div class="ecosystem-offers">
        <article class="ecosystem-offer ecosystem-offer--portage" data-ecosystem-card="left">
          <div class="ecosystem-offer-glow" aria-hidden="true"></div>
          <div class="ecosystem-logo ecosystem-logo--porters" aria-label="The Porters">
            <span class="brand-wordmark" aria-hidden="true">
              <span class="brand-wordmark-the">The</span>
              <span class="brand-wordmark-porters">Porters</span>
            </span>
          </div>
          <div class="ecosystem-offer-copy">
            <small>Portage salarial</small>
            <h3>The Porters</h3>
            <p>The Porters accompagne les consultants qui ont trouvé leur mission : contrat de travail, facturation, paie, protection sociale et suivi personnalisé, sans renoncer à leur autonomie.</p>
          </div>
          <div class="ecosystem-expertises" aria-label="Domaines d’expertise">
            {ecosystemExpertises.map((expertise) => <span>{expertise}</span>)}
          </div>
          <a class="ecosystem-offer-link" href="/portage-salarial">Comment fonctionne le portage <b aria-hidden="true">↗</b></a>
        </article>

        <figure class="ecosystem-guide" aria-hidden="true" data-ecosystem-eric>
          <Image
            src={ericTwoOffers}
            alt=""
            widths={[560, 720, 900, 1024]}
            sizes="(max-width: 760px) 80vw, 48rem"
            format="webp"
            quality={94}
            loading="eager"
          />
        </figure>

        <article class="ecosystem-offer ecosystem-offer--esn" data-ecosystem-card="right">
          <div class="ecosystem-offer-glow" aria-hidden="true"></div>
          <div class="ecosystem-logo ecosystem-logo--big-porters">
            <img src={bigPortersLogo.src} alt="The Big Porters" width="1254" height="1254" loading="eager" decoding="async" />
          </div>
          <div class="ecosystem-offer-copy">
            <small>ESN spécialisée IT</small>
            <h3>The Big Porters</h3>
            <p>The Big Porters accompagne les entreprises à la recherche de talents IT qualifiés, avec une sélection attentive des profils, un cadrage précis et un suivi de mission dédié.</p>
          </div>
          <div class="ecosystem-expertises" aria-label="Domaines d’expertise">
            {ecosystemExpertises.map((expertise) => <span>{expertise}</span>)}
          </div>
          <a class="ecosystem-offer-link" href="/entreprises">Notre offre pour les entreprises <b aria-hidden="true">↗</b></a>
        </article>
        </div>
      </div>
    </div>
  </section>

  <div class="about-partner-tape" aria-label="Écosystème partenaires">
    <LogoMarquee title="Écosystème partenaires" logos={ecosystemPartners} speed="26s" />
  </div>

  <section class="about-hero" data-team-intro data-motion-scene>
    <div class="about-hero-visual" aria-hidden="false">
      <TeamPortraitHero />
    </div>
  </section>

  <!-- Positional CMS placeholder: keeps legacy section keys from sliding onto expertises. -->
  <section class="removed-section-placeholder" hidden data-cms-ignore aria-hidden="true"></section>

  <section class="about-section expertise-section" id="expertises">
    <div class="about-shell">
      <header class="section-head light reveal"><p>Nos expertises</p><h2>Cinq domaines,<br />et les profils qui vont avec.</h2></header>
      <div class="expertise-lab reveal" data-expertise-lab>
        <figure class="expertise-lisa" aria-hidden="true">
          <Image
            src={lisaExpertiseGuide}
            alt=""
            widths={[420, 560, 720]}
            sizes="(max-width: 760px) 72vw, 22rem"
            format="webp"
            quality={94}
            loading="lazy"
          />
        </figure>
        {expertiseSections.map((expertise, index) => (
          <div class:list={['expertise-entry', { 'is-active': index === 0 }]} data-expertise-entry>
            <button
              type="button"
              class="expertise-node"
              id={`expertise-tab-${expertise.id}`}
              role="tab"
              aria-selected={index === 0}
              aria-expanded={index === 0}
              aria-controls={`expertise-panel-${expertise.id}`}
              data-expertise-index={index}
              style={`--selector-offset: ${index * 6.1}rem`}
            >
              <span class="expertise-node-copy">
                <span><strong>{expertise.title}</strong><small>{expertise.shortSubtitle}</small></span>
              </span>
              <b class="expertise-node-arrow" aria-hidden="true">↗</b>
            </button>

            <article
              id={`expertise-panel-${expertise.id}`}
              class="expertise-detail expertise-panel"
              role="tabpanel"
              aria-labelledby={`expertise-tab-${expertise.id}`}
              data-expertise-panel
              hidden={index !== 0}
            >
              <header class="expertise-panel-header">
                <p>Domaine sélectionné</p>
                <h3>{expertise.title}</h3>
                <div class="detail-line"></div>
              <div class="expertise-source-note expertise-live-block" data-live-block>
                  <div>
                    <span>L’approche en bref</span>
                    <p>{expertise.sourceSummary}</p>
                  </div>
                  <a href={expertise.ctaHref} aria-label={expertise.ctaLabel}>
                    Plus de détails <b aria-hidden="true">↗</b>
                  </a>
                </div>
                <div class="expertise-intro-grid expertise-live-block" data-live-block>
                  <p class="expertise-introduction">{expertise.introduction}</p>
                  <div class="expertise-description">{expertise.description.map((paragraph) => <p>{paragraph}</p>)}</div>
                </div>
              </header>

              <section class="expertise-panel-section expertise-live-block" data-live-block>
                <div class="expertise-section-title"><SiteIcon name="users" /><h4>Profils accompagnés</h4></div>
                <div class="expertise-profile-marquee" aria-label={expertise.profiles.join(', ')}>
                  <div class="expertise-profile-track">
                    <div class="expertise-profile-group">{expertise.profiles.map((profile) => <span>{profile}</span>)}</div>
                    <div class="expertise-profile-group" aria-hidden="true" data-cms-ignore>{expertise.profiles.map((profile) => <span>{profile}</span>)}</div>
                  </div>
                </div>
              </section>

              <div class="expertise-panel-columns">
                <section class="expertise-panel-section expertise-live-block" data-live-block>
                  <div class="expertise-section-title"><SiteIcon name="compass" /><h4>Missions les plus fréquentes</h4></div>
                  <ul class="expertise-mission-list">
                    {expertise.missions.map((mission) => <li><div><strong>{mission.title}</strong><p>{mission.description}</p></div></li>)}
                  </ul>
                </section>
                <section class="expertise-panel-section expertise-live-block" data-live-block>
                  <div class="expertise-section-title"><SiteIcon name="clipboard" /><h4>Responsabilités et livrables</h4></div>
                  <ul class="expertise-check-list">{expertise.responsibilities.map((item) => <li><SiteIcon name="check" /><span>{item}</span></li>)}</ul>
                </section>
              </div>

              <section class="expertise-panel-section expertise-live-block" data-live-block>
                <div class="expertise-section-title"><SiteIcon name="spark" /><h4>Compétences et environnements</h4></div>
                <div class="expertise-tags expertise-tags--skills">{expertise.skills.map((skill) => <span>{skill}</span>)}</div>
              </section>

              <div class="expertise-panel-columns expertise-panel-columns--compact">
                {/* Secteurs non publiés : fact-base F-S01 est DO_NOT_PUBLISH. */}
                {expertise.sectors.length > 0 && (
                  <section class="expertise-panel-section expertise-live-block" data-live-block>
                    <div class="expertise-section-title"><SiteIcon name="building" /><h4>Secteurs concernés</h4></div>
                    <div class="expertise-tags">{expertise.sectors.map((sector) => <span>{sector}</span>)}</div>
                  </section>
                )}
                <section class="expertise-panel-section expertise-why expertise-live-block" data-live-block>
                  <div class="expertise-section-title"><SiteIcon name="scale" /><h4>Pourquoi le portage pour ce profil ?</h4></div>
                  <p>{expertise.whyPortage}</p>
                </section>
              </div>

              <section class="expertise-support expertise-live-block" data-live-block>
                <div class="expertise-section-title"><SiteIcon name="shield" /><h4>L’accompagnement Porters</h4></div>
                <ul class="expertise-support-list">{expertise.portersSupport.map((item) => <li><SiteIcon name="check" /><span>{item}</span></li>)}</ul>
              </section>

            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Positional CMS placeholder: preserves the former values section slot. -->
  <section class="removed-section-placeholder" hidden data-cms-ignore aria-hidden="true"></section>

  <section class="about-section history-section brand-ambient-host" id="histoire">
    <BrandAmbientShapes placement="split" />
    <div class="about-shell">
      <header class="section-head reveal"><p>Notre histoire</p><h2>D’un consultant porté<br />à un groupe de deux sociétés.</h2></header>
      <div class="history-timeline" data-history-schema>
        {history.map((item, index) => (
          <div
            class:list={['history-node', `history-node--${index % 2 === 0 ? 'left' : 'right'}`, 'reveal', { 'is-active': index === 0 }]}
            data-history-step
            data-marker={item.marker}
            data-title={item.title}
            style={`--step:${index}; --reveal-delay: ${index * 120}ms`}
          >
            <div class="history-dot-wrap">
              <span class="history-dot" aria-hidden="true"></span>
            </div>
            <article class="history-card">
              <div class="history-card-accent" aria-hidden="true"></div>
              <div class="history-card-inner">
                <span class="history-card-marker">{item.marker}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Positional CMS placeholder: preserves the former team-functions section slot. -->
  <section class="removed-section-placeholder" hidden data-cms-ignore aria-hidden="true"></section>

  <section class="about-section responsibility-integrated-section">
    <div class="about-shell responsibility-integrated-grid">
      <header class="section-head light reveal">
        <p>Responsabilité</p>
        <h2>Ce que nous nous imposons au quotidien.</h2>
        <strong>L’essentiel de notre démarche RSE tient en quatre points ; le détail est sur la page dédiée.</strong>
      </header>
      <div class="responsibility-commitments reveal">
        {responsibilityCommitments.map((item) => (
          <article>
            <div><h3>{item.title}</h3><p>{item.text}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Positional CMS placeholder: preserves the former final CTA section slot. -->
  <section class="removed-section-placeholder" hidden data-cms-ignore aria-hidden="true"></section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-expertise-lab]').forEach((lab) => {
    const entries = Array.from(lab.querySelectorAll<HTMLElement>('[data-expertise-entry]'));
    const tabs = entries.map((entry) => entry.querySelector<HTMLButtonElement>('[role="tab"]')).filter((tab): tab is HTMLButtonElement => Boolean(tab));
    const panels = entries.map((entry) => entry.querySelector<HTMLElement>('[data-expertise-panel]')).filter((panel): panel is HTMLElement => Boolean(panel));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const liveObserver = !reducedMotion && 'IntersectionObserver' in window
      ? new IntersectionObserver((observed) => {
          observed.forEach((item) => {
            if (!item.isIntersecting) return;
            item.target.classList.add('is-live');
            liveObserver?.unobserve(item.target);
          });
        }, { threshold: .16, rootMargin: '0px 0px -8% 0px' })
      : null;

    const prepareLiveBlocks = (panel: HTMLElement) => {
      panel.querySelectorAll<HTMLElement>('[data-live-block]').forEach((block, index) => {
        block.style.setProperty('--live-delay', `${Math.min(index * 70, 350)}ms`);
        if (reducedMotion || !liveObserver) block.classList.add('is-live');
        else liveObserver.observe(block);
      });
    };

    const select = (position: number, options: { focus?: boolean; updateHash?: boolean } = {}) => {
      const nextPosition = (position + tabs.length) % tabs.length;
      tabs.forEach((tab, index) => {
        const selected = index === nextPosition;
        tab.setAttribute('aria-selected', String(selected));
        tab.setAttribute('aria-expanded', String(selected));
        tab.closest<HTMLElement>('[data-expertise-entry]')?.classList.toggle('is-active', selected);
      });
      panels.forEach((panel, index) => {
        const selected = index === nextPosition;
        panel.hidden = !selected;
        panel.classList.toggle('detail-pop', selected && !reducedMotion);
        if (selected) requestAnimationFrame(() => prepareLiveBlocks(panel));
      });
      if (options.focus) tabs[nextPosition]?.focus();
      if (options.updateHash) history.replaceState(null, '', `#expertise-${tabs[nextPosition]?.id.replace('expertise-tab-', '')}`);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, { updateHash: true }));
      tab.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        if (!['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft', 'Home', 'End'].includes(key)) return;
        event.preventDefault();
        const next = key === 'Home' ? 0 : key === 'End' ? tabs.length - 1 : index + (key === 'ArrowUp' || key === 'ArrowLeft' ? -1 : 1);
        select(next, { focus: true, updateHash: true });
      });
    });

    const hash = window.location.hash.replace('#expertise-', '');
    const hashIndex = tabs.findIndex((tab) => tab.id === `expertise-tab-${hash}`);
    if (hashIndex >= 0) select(hashIndex);
    else if (panels[0]) prepareLiveBlocks(panels[0]);
  });
  document.querySelectorAll<HTMLDetailsElement>('.values-list details').forEach((detail) => {
    const summary = detail.querySelector('summary');
    detail.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(detail.open));
    });
  });
  document.querySelectorAll<HTMLElement>('[data-history-schema]').forEach((schema) => {
    const steps = Array.from(schema.querySelectorAll<HTMLElement>('[data-history-step]'));

    const setActive = (step: HTMLElement) => {
      steps.forEach((item) => item.classList.toggle('is-active', item === step));
    };

    steps.forEach((step) => {
      step.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') setActive(step);
      });
      step.addEventListener('focusin', () => setActive(step));
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = steps.indexOf(entry.target as HTMLElement);
          if (index >= 0) setActive(entry.target as HTMLElement);
        });
      }, { rootMargin: '-25% 0px -55% 0px', threshold: 0.2 });
      steps.forEach((step) => observer.observe(step));
    }

    const updateDrawProgress = () => {
      const vh = window.innerHeight;
      steps.forEach((step) => {
        const rect = step.getBoundingClientRect();
        const start = vh * 0.85;
        const end = vh * 0.35;
        let progress = (start - rect.top) / (start - end);
        progress = Math.max(0, Math.min(1, progress));
        step.style.setProperty('--draw', progress.toString());
      });
    };
    window.addEventListener('scroll', updateDrawProgress, { passive: true });
    updateDrawProgress();
  });
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-motion-scene]').forEach((scene) => {
      scene.addEventListener('pointermove', (event) => {
        const rect = scene.getBoundingClientRect();
        scene.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width - .5) * 10}px`);
        scene.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height - .5) * 10}px`);
      });
      scene.addEventListener('pointerleave', () => { scene.style.setProperty('--mx', '0px'); scene.style.setProperty('--my', '0px'); });
    });
  }

  const reducedIntroMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const introSections = Array.from(document.querySelectorAll<HTMLElement>('[data-ecosystem-intro], [data-team-intro]'));

  if (!reducedIntroMotion && 'IntersectionObserver' in window) {
    introSections.forEach((section) => section.classList.add('intro-ready'));
    const introObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const section = entry.target as HTMLElement;
        section.classList.add('is-intro-visible');
        introObserver.unobserve(section);
        window.setTimeout(() => {
          section.classList.remove('intro-ready', 'is-intro-visible');
        }, section.hasAttribute('data-ecosystem-intro') ? 1700 : 1550);
      });
    }, { threshold: .16, rootMargin: '0px 0px -8% 0px' });
    introSections.forEach((section) => introObserver.observe(section));
  }
</script>

<style>
  .about-shell{width:min(100% - 3rem,82rem);margin:auto}.about-hero{position:relative;overflow:hidden;padding:clamp(3.6rem,7vw,6.4rem) 0;background:radial-gradient(circle at 82% 16%,rgba(198,164,90,.13),transparent 30%),linear-gradient(145deg,#f4f6f7,#f8f5ee 68%,#eef1f2)}.about-hero-grid{position:relative;display:grid;grid-template-columns:minmax(19rem,.62fr) minmax(38rem,1.38fr);align-items:center;gap:clamp(2.4rem,5vw,5.5rem)}.about-hero-copy{position:relative;z-index:2}.eyebrow,.section-head>p,.about-cta p{margin-bottom:1rem;color:#b79245;font-size:.72rem;font-weight:750;letter-spacing:.15em;text-transform:uppercase}.about-hero h2{max-width:12ch;margin:0;color:#203440;font-size:clamp(3rem,5vw,5.3rem);line-height:.96;letter-spacing:-.055em}.about-hero-copy>p:last-of-type{max-width:34rem;margin:1.6rem 0 0;color:rgba(32,52,64,.64);font-size:clamp(.98rem,1.35vw,1.12rem);line-height:1.72}.about-hero-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.about-hero-actions a{display:inline-flex;min-height:3.1rem;align-items:center;justify-content:center;gap:.75rem;border:1px solid rgba(32,52,64,.18);border-radius:999px;padding:.75rem 1.2rem;color:#203440;font-size:.72rem;font-weight:760;transition:background 180ms ease,border-color 180ms ease,color 180ms ease,transform 220ms cubic-bezier(.2,.8,.2,1)}.about-hero-actions a:first-child{border-color:#c6a45a;background:#c6a45a}.about-hero-actions a:hover,.about-hero-actions a:focus-visible{border-color:#203440;background:#203440;color:#fff;outline:none;transform:translateY(-2px)}.about-hero-team{min-width:0}.about-section{padding:clamp(5rem,10vw,9rem) 0}.section-head{max-width:52rem;margin-bottom:4rem}.section-head h1,.section-head h2{font-size:clamp(2.3rem,4.5vw,4.5rem);line-height:1.03;letter-spacing:-.045em}.section-head.light h2{color:#fff}
  .about-hero{display:flex;min-height:clamp(34rem,40vw,39rem);align-items:center;border-block:1px solid rgba(32,52,64,.08);padding:1.5rem 0;background:radial-gradient(circle at 50% 43%,rgba(198,164,90,.12),transparent 34%),linear-gradient(180deg,#fbf9f4 0%,#f6f2e9 100%)}
  .about-hero-visual{--team-center-position:50%;position:relative;z-index:2;width:min(100% - 3rem,78rem);height:clamp(32rem,37vw,37rem);margin:auto;overflow:visible;background:transparent}
  .about-partner-tape{position:relative;z-index:10;overflow:hidden;border-block:1px solid rgba(32,52,64,.1);background:rgba(255,255,255,.97);box-shadow:0 15px 38px rgba(32,52,64,.08)}
