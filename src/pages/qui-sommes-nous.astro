  .history-section {
    overflow: hidden;
    padding-top: clamp(4rem, 7vw, 6.5rem);
    background: linear-gradient(180deg, #f6f3ec 0%, #faf9f6 22%, #f7f5f0 68%, #f4f6f7 100%);
  }
  .history-section .section-head {
    text-align: center;
    max-width: 38rem;
    margin-inline: auto;
  }
  .history-timeline {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    max-width: 62rem;
    margin-inline: auto;
    padding-block: 2rem;
  }
  /* weaving road line background */
  .history-node::after {
    content: '';
    position: absolute;
    top: 3.7rem;
    height: calc(100% + clamp(2.5rem, 5vw, 4rem));
    width: clamp(3rem, 12vw, 8rem);
    border: 3px dashed rgba(198, 164, 90, 0.15);
    z-index: 0;
  }
  /* weaving road line foreground fill */
  .history-node::before {
    content: '';
    position: absolute;
    top: 3.7rem;
    height: calc(100% + clamp(2.5rem, 5vw, 4rem));
    width: clamp(3rem, 12vw, 8rem);
    border: 3px dashed #c6a45a;
    z-index: 1;
    clip-path: inset(0 0 calc(100% - (var(--draw, 0) * 100%)) 0);
  }
  .history-node:last-child::after,
  .history-node:last-child::before {
    display: none;
  }
  .history-node--left::after,
  .history-node--left::before {
    left: 50%;
    border-left: none;
    border-radius: 0 120px 120px 0;
  }
  .history-node--right::after,
  .history-node--right::before {
    right: 50%;
    border-right: none;
    border-radius: 120px 0 0 120px;
  }
  /* each node row */
  .history-node {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    align-items: start;
    z-index: 1;
  }
  /* dot in center column */
  .history-dot-wrap {
    grid-column: 2;
    display: flex;
    justify-content: center;
    padding-top: 1.8rem;
    position: relative;
    z-index: 2;
  }
  .history-dot {
    display: grid;
    width: 3.8rem;
    height: 3.8rem;
    place-items: center;
    border-radius: 50%;
    border: 2px solid rgba(198, 164, 90, 0.5);
    background: #fff;
    color: #203440;
    box-shadow: 0 0 0 0.6rem rgba(247, 244, 237, 0.9);
    transition: 0.38s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .history-dot::after { width: .58rem; height: .58rem; border-radius: 50%; background: #c6a45a; content: ""; box-shadow: 0 0 0 .35rem rgba(198,164,90,.13); }
  .history-node.is-active .history-dot,
  .history-node:hover .history-dot {
    background: #203440;
    color: #fff;
    border-color: #c6a45a;
    box-shadow: 0 0 0 0.6rem rgba(198, 164, 90, 0.12);
    transform: scale(1.1);
  }
  /* card placement — left nodes */
  .history-node--left .history-card {
    grid-column: 1;
    grid-row: 1;
  }
  .history-node--left .history-dot-wrap {
    grid-row: 1;
  }
  .history-node--left::after {
    content: '';
    grid-column: 3;
    grid-row: 1;
  }
  /* card placement — right nodes */
  .history-node--right .history-card {
    grid-column: 3;
    grid-row: 1;
  }
  .history-node--right .history-dot-wrap {
    grid-row: 1;
  }
  .history-node--right::before {
    content: '';
    grid-column: 1;
    grid-row: 1;
  }
  /* the card itself */
  .history-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(32, 52, 64, 0.08);
    border-radius: 12px;
    background: #fff;
    margin: 0 1.5rem;
    transition: 0.38s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .history-card-accent {
    height: 4px;
    background: linear-gradient(90deg, #c6a45a 0%, #203440 100%);
  }
  .history-node--right .history-card-accent {
    background: linear-gradient(90deg, #203440 0%, #c6a45a 100%);
  }
  .history-card-inner {
    padding: clamp(1.4rem, 2.5vw, 2rem);
  }
  .history-card-marker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgba(198, 164, 90, 0.12);
    color: #b79245;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .history-card h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.25;
    color: #203440;
  }
  .history-card p {
    margin-top: 0.75rem;
    color: rgba(32, 52, 64, 0.6);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .history-node.is-active .history-card,
  .history-node:hover .history-card {
    border-color: rgba(198, 164, 90, 0.45);
    box-shadow: 0 20px 50px rgba(32, 52, 64, 0.1);
    transform: translateY(-4px);
  }
