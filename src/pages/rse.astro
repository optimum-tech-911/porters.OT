---
import PageLayout from '../layouts/PageLayout.astro';
import workshopImage from '../../images/team-workshop.webp';

const commitments = [
  {
    title: 'Une charte Numérique Responsable, et un référent désigné',
    // F-D10 (PUBLISHABLE)
    text: 'Une charte fixe les principes de sobriété, d’éco-conception et d’accessibilité. Un référent Numérique Responsable est désigné.',
  },
  {
    title: 'Éco-conception logicielle',
    // F-D10 (PUBLISHABLE) — référentiels nommés, jamais présentés comme certifications
    text: 'Les équipes s’appuient sur le RGESN et les pratiques Green IT pour réduire le poids du code, des requêtes et des dépendances.',
  },
  {
    title: 'Accessibilité numérique',
    // F-D09 (PUBLISHABLE)
    text: 'Les prestations qui touchent à une interface s’appuient sur le RGAA et les recommandations WCAG dès la conception.',
  },
  {
    title: 'Déplacements à faible impact',
    // F-D14 (PUBLISHABLE)
    text: 'Train en priorité sur les longues distances, transports en commun ou mobilités douces en proximité.',
  },
  {
    title: 'Équipements réparés, reconditionnés, donnés',
    // F-D15 (PUBLISHABLE)
    text: 'Réparation quand elle est possible, périphériques reconditionnés, recyclage et dons par des filières identifiées.',
  },
  {
    title: 'Diversité et égalité des chances',
    // F-D11 (PUBLISHABLE)
    text: 'Le groupe est signataire de la Charte de la diversité. Le recrutement repose sur les compétences, l’expérience et le savoir-être.',
  },
];

// Gouvernance : ce qui rend la démarche vérifiable plutôt que déclarative.
const governance = [
  {
    label: 'Dématérialisation',
    // F-D13 (PUBLISHABLE)
    text: 'Gestion administrative entièrement dématérialisée : contrats, bons de commande, comptes rendus d’activité et facturation sont traités sans papier.',
  },
  {
    label: 'Indicateurs',
    // F-D16 (PUBLISHABLE)
    text: 'Des indicateurs RSE sont suivis en comité de pilotage : niveau de dématérialisation des échanges, maîtrise des déplacements, actions de formation et de partage de connaissances.',
  },
  {
    label: 'Formation',
    // MT-LOT1 §6 (PUBLISHABLE) — ateliers, e-learning, retours d'expérience
    text: 'Ateliers, e-learning et retours d’expérience réguliers sur la mobilité, le travail à distance, la sobriété des outils et l’éco-conception.',
  },
  {
    label: 'Sous-traitance',
    // MT-LOT1 §6 (PUBLISHABLE)
    text: 'Lorsqu’un prestataire est mobilisé, des critères de numérique responsable entrent dans sa sélection.',
  },
];
---

<PageLayout
  seo={{
    title: 'Engagements RSE et numérique responsable — The Porters',
    description:
      'Charte Numérique Responsable et référent désigné, éco-conception RGESN, accessibilité RGAA et WCAG, matériel reconditionné, Charte de la diversité.',
  }}
  breadcrumbs={[{ label: 'Démarche RSE' }]}
>
  <section class="relative min-h-[39rem] overflow-hidden bg-porters-navy text-porters-white">
    <img
      src={workshopImage.src}
      width={workshopImage.width}
      height={workshopImage.height}
      alt="Équipe réunie autour d’un atelier de travail."
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(18,35,48,0.98)_0%,rgba(18,35,48,0.85)_48%,rgba(18,35,48,0.34)_100%)]"></div>
    <div class="container relative mx-auto flex min-h-[39rem] items-center px-6 py-20 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Responsabilité sociale et environnementale</p>
        <h1 class="max-w-3xl text-porters-white">Notre démarche RSE.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-porters-white/78">
          Les référentiels sur lesquels nous nous appuyons, et ce que nous ne revendiquons pas.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Nos engagements</p>
        <h2 class="mb-6">Ce sur quoi nous nous appuyons</h2>
        <p class="text-lg leading-relaxed text-porters-black/70">
          Une charte Numérique Responsable est diffusée en interne et un référent est désigné.
          Nos pratiques s’appuient sur le RGESN pour l’éco-conception, ainsi que sur le RGAA et
          les recommandations WCAG pour l’accessibilité numérique.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-porters-black/70">
          The Porters est signataire de la Charte de la diversité : le recrutement repose sur les
          compétences, l’expérience et le savoir-être.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-porters-black/70">
          Nous distinguons les référentiels que nous utilisons dans nos pratiques des labels
          effectivement détenus. Notre démarche est une trajectoire structurée : à ce jour, nous
          ne revendiquons aucune certification.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
