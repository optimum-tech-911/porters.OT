---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeProofMetrics from '../components/home/HomeProofMetrics.astro';
import GoogleReviewsBadge from '../components/ui/GoogleReviewsBadge.astro';
import GoogleReviewsMarquee from '../components/ui/GoogleReviewsMarquee.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import { faqGroups } from '../data/faq.data';
import { pageSeo } from '../data/seo.data';
import { helloWorkJobs, helloWorkUrl } from '../data/hello-work.data';
import { googleReviewHighlights } from '../content/pages/home';
import { cmsAttrs, cmsText } from '../cms/content';
import welcomePortersImage from '../assets/home/welcome-porters.png';

const partnerLogos = [
  { name: 'BPCE', url: '/images/logos/partners/partner-1.png', optimizedUrl: '/images/logos/partners/partner-1-320.avif' },
  { name: 'Groupama', url: '/images/logos/partners/partner-2.png', optimizedUrl: '/images/logos/partners/partner-2-320.avif' },
  { name: 'Airbus', url: '/images/logos/partners/partner-3.png', optimizedUrl: '/images/logos/partners/partner-3-320.avif' },
  { name: 'Safran', url: '/images/logos/partners/partner-4.png', optimizedUrl: '/images/logos/partners/partner-4-320.avif' },
  { name: 'Thales', url: '/images/logos/partners/partner-5.png', optimizedUrl: '/images/logos/partners/partner-5-320.avif' },
  { name: 'Capgemini', url: '/images/logos/partners/capgemini.svg', optimizedUrl: null },
];

// The IT specialism leads: it is the differentiator, and it used to sit last
// (copy-plan §9.1). Order here drives both the grid and the detail panel below.
const offerItems = [
  { key: 'home.offer.it', title: cmsText('home.offer.it.title'), text: cmsText('home.offer.it.description'), icon: 'network' as const, href: '/expertises', cta: 'Explorer les expertises' },
  { key: 'home.offer.employee', title: cmsText('home.offer.employee.title'), text: cmsText('home.offer.employee.description'), icon: 'shield' as const, href: '/portage-salarial', cta: 'Comprendre le cadre' },
  { key: 'home.offer.admin', title: cmsText('home.offer.admin.title'), text: cmsText('home.offer.admin.description'), icon: 'clipboard' as const, href: '/consultants', cta: 'Voir l’accompagnement' },
  { key: 'home.offer.human', title: cmsText('home.offer.human.title'), text: cmsText('home.offer.human.description'), icon: 'user' as const, href: '/equipe', cta: 'Rencontrer l’équipe' },
];

const faqPreview = faqGroups.flatMap((group) => group.items).slice(0, 4);
---

<PageLayout seo={pageSeo.home} noBreadcrumbs>
  <HomeHero jobs={helloWorkJobs} />

  <section class="light-logo-strip" aria-label="Écosystème professionnel" data-motion-section>
    <div
      class="light-logo-marquee auto-marquee"
      data-motion-item="fade"
      tabindex="0"
      role="region"
      aria-label="Logos des partenaires et clients présentés en défilement"
    >
      <div class="light-logo-track auto-marquee-track">
        <div class="light-logo-group">
          {partnerLogos.map((logo) => (
            <picture>
              {logo.optimizedUrl && <source srcset={logo.optimizedUrl} type="image/avif" />}
              <img src={logo.url} alt={logo.name} width="320" height="107" loading="lazy" decoding="async" />
            </picture>
          ))}
        </div>
        <div class="light-logo-group" aria-hidden="true">
          {partnerLogos.map((logo) => (
            <picture>
              {logo.optimizedUrl && <source srcset={logo.optimizedUrl} type="image/avif" />}
              <img src={logo.url} alt="" width="320" height="107" loading="lazy" decoding="async" />
            </picture>
          ))}
        </div>
      </div>
    </div>
  </section>

  <HomeProofMetrics />

  <section class="light-section light-offer-section reveal-fade" data-reveal data-motion-section data-motion-hold="3500">
    <div class="light-container light-offer-layout">
      <div class="light-offer-copy reveal-up" data-reveal>
        <p data-motion-item="left" style="--motion-order:0" {...cmsAttrs('home.offer.eyebrow')}>{cmsText('home.offer.eyebrow')}</p>
        <h2 data-motion-item="left" style="--motion-order:1" {...cmsAttrs('home.offer.title')}>{cmsText('home.offer.title')}</h2>
        <span data-motion-item="left" style="--motion-order:2" {...cmsAttrs('home.offer.description')}>{cmsText('home.offer.description')}</span>
        <a data-motion-item="pop" style="--motion-order:3" href="/portage-salarial"><span {...cmsAttrs('home.offer.cta')}>{cmsText('home.offer.cta')}</span> <span aria-hidden="true">→</span></a>
        <figure class="light-offer-welcome reveal-scale" data-reveal data-motion-item="wipe" style="--motion-order:4" aria-label="Bienvenue chez The Porters">
          <Image
            src={welcomePortersImage}
            alt="Une carte Bienvenue chez The Porters tenue entre deux mains"
            widths={[480, 720, 960]}
            sizes="(max-width: 960px) min(90vw, 42rem), 34vw"
            format="webp"
            quality={88}
            loading="lazy"
          />
        </figure>
      </div>
      <div class="light-offer-schema stagger-children" data-offer-schema>
        <div class="light-offer-flow" data-motion-item="right" style="--motion-order:3" aria-label="Schéma d’accompagnement The Porters">

        {offerItems.map((item, index) => item && (
          <button
            type="button"
            class:list={['light-offer-item', 'reveal-up', { 'is-active': index === 0 }]}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-reveal
            data-motion-item="pop"
            data-offer-step
            data-offer-title={item.title}
            data-offer-text={item.text}
            data-offer-href={item.href}
            data-offer-cta={item.cta}
            style={`--reveal-delay: ${index * 90}ms; --motion-order:${index + 4}; --offer-pop-delay:${1250 + index * 270}ms; --step:${index}`}
          >
            <span class="light-offer-icon"><SiteIcon name={item.icon} class="h-5 w-5" /></span>
            <div>
              <h3 {...cmsAttrs(`${item.key}.title`, 'data-offer-title')}>{item.title}</h3>
              <p {...cmsAttrs(`${item.key}.description`, 'data-offer-text')}>{item.text}</p>
            </div>
          </button>
        ))}
        </div>
        <aside class="light-offer-detail" data-motion-item="up" style="--motion-order:8" aria-live="polite">
          <h3 {...cmsAttrs('home.offer.it.title')}>{offerItems[0]?.title}</h3>
          <p {...cmsAttrs('home.offer.it.description')}>{offerItems[0]?.text}</p>
          <a href={offerItems[0].href} data-offer-link><span>{offerItems[0].cta}</span> <b aria-hidden="true">→</b></a>
        </aside>
      </div>
    </div>
  </section>

  <section class="light-section light-hellowork-section reveal-fade" data-reveal data-motion-section>
    <div class="light-container">
      <div class="light-hellowork-card reveal-up" data-reveal data-motion-item="fade" style="--motion-order:0">
        <div class="light-hellowork-layout">
          <div class="light-hellowork-copy">
            <p data-motion-item="left" style="--motion-order:1" {...cmsAttrs('home.jobs.eyebrow')}>{cmsText('home.jobs.eyebrow')}</p>
            <h2 data-motion-item="left" style="--motion-order:2" {...cmsAttrs('home.jobs.title')}>{cmsText('home.jobs.title')}</h2>
            <strong data-motion-item="left" style="--motion-order:3" {...cmsAttrs('home.jobs.description')}>{cmsText('home.jobs.description')}</strong>
            <ul class="light-hellowork-points" aria-label="Repères recrutement">
              <li data-motion-item="chip" style="--motion-order:4" {...cmsAttrs('home.jobs.point.current')}>{cmsText('home.jobs.point.current')}</li>
              <li data-motion-item="chip" style="--motion-order:5" {...cmsAttrs('home.jobs.point.direct')}>{cmsText('home.jobs.point.direct')}</li>
              <li data-motion-item="chip" style="--motion-order:6" {...cmsAttrs('home.jobs.point.full')}>{cmsText('home.jobs.point.full')}</li>
            </ul>
            <div data-motion-item="pop" style="--motion-order:7">
              <a href={helloWorkUrl} target="_blank" rel="noopener noreferrer"><span {...cmsAttrs('home.jobs.external_cta')}>{cmsText('home.jobs.external_cta')}</span> <b aria-hidden="true">→</b></a>
            </div>
          </div>
          <div class="light-hellowork-preview" data-motion-item="right" style="--motion-order:3" aria-hidden="true">
            <div class="light-hellowork-orbit"></div>
            <article class="light-hellowork-panel light-hellowork-panel--primary">
              <small {...cmsAttrs('home.jobs.preview.platform')}>{cmsText('home.jobs.preview.platform')}</small>
              <strong {...cmsAttrs('home.jobs.preview.company')}>{cmsText('home.jobs.preview.company')}</strong>
              <span {...cmsAttrs('home.jobs.preview.status')}>{cmsText('home.jobs.preview.status')}</span>
            </article>
            <article class="light-hellowork-panel light-hellowork-panel--floating">
              <small {...cmsAttrs('home.jobs.preview.focus')}>{cmsText('home.jobs.preview.focus')}</small>
              <strong {...cmsAttrs('home.jobs.preview.profiles')}>{cmsText('home.jobs.preview.profiles')}</strong>
            </article>
            <div class="light-hellowork-tags">
              <span>Rendez-vous</span>
              <span>RH</span>
              <span>Conseil</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="light-section light-reviews brand-ambient-host reveal-fade" data-reveal data-motion-section>
    <BrandAmbientShapes placement="right" />
    <div class="light-container">
      <div class="light-reviews-header reveal-up" data-reveal data-motion-item="left" style="--motion-order:0">
        <div>
          <p {...cmsAttrs('home.reviews.eyebrow')}>{cmsText('home.reviews.eyebrow')}</p>
          <h2 {...cmsAttrs('home.reviews.title')}>{cmsText('home.reviews.title')}</h2>
        </div>
        <GoogleReviewsBadge />
      </div>
      <div class="reveal-fade" data-reveal data-motion-item="wipe" style="--motion-order:2"><GoogleReviewsMarquee reviews={googleReviewHighlights} speed="34s" /></div>
    </div>
  </section>

  <section class="light-section light-faq brand-ambient-host reveal-fade" data-reveal data-motion-section>
    <BrandAmbientShapes placement="left" />
    <div class="light-container light-faq-layout">
      <div class="light-faq-copy reveal-up" data-reveal>
        <p data-motion-item="left" style="--motion-order:0" {...cmsAttrs('home.faq.eyebrow')}>{cmsText('home.faq.eyebrow')}</p>
        <h2 data-motion-item="left" style="--motion-order:1" {...cmsAttrs('home.faq.title')}>{cmsText('home.faq.title')}</h2>
        <span data-motion-item="left" style="--motion-order:2" {...cmsAttrs('home.faq.description')}>{cmsText('home.faq.description')}</span>
        <a data-motion-item="pop" style="--motion-order:3" href="/faq"><span {...cmsAttrs('home.faq.cta')}>{cmsText('home.faq.cta')}</span> <b aria-hidden="true">→</b></a>
      </div>
      <div class="light-faq-list reveal-up" data-reveal>
        {faqPreview.map((faq, index) => (
          <details data-motion-item="pop" style={`--motion-order:${index + 2}`}>
            <summary aria-expanded="false">{faq.question}<span aria-hidden="true">+</span></summary>
            <div class="light-faq-answer"><div><p>{faq.answer}</p></div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-offer-schema]').forEach((schema) => {
    const steps = schema.querySelectorAll<HTMLButtonElement>('[data-offer-step]');
    const detail = schema.querySelector<HTMLElement>('.light-offer-detail');
    const detailTitle = detail?.querySelector<HTMLElement>('h3');
    const detailText = detail?.querySelector<HTMLElement>('p');
    const detailLink = detail?.querySelector<HTMLAnchorElement>('[data-offer-link]');
    const detailLinkText = detailLink?.querySelector<HTMLElement>('span');

    const selectStep = (step: HTMLButtonElement) => {
      steps.forEach((item) => {
        const active = item === step;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      if (detailTitle) detailTitle.textContent = step.dataset.offerTitle || '';
      if (detailText) detailText.textContent = step.dataset.offerText || '';
      if (detailLink) detailLink.href = step.dataset.offerHref || '/rendez-vous';
      if (detailLinkText) detailLinkText.textContent = step.dataset.offerCta || 'En savoir plus';
      detail?.classList.remove('is-switching');
      requestAnimationFrame(() => detail?.classList.add('is-switching'));
    };

    steps.forEach((step) => {
      step.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') selectStep(step);
      });
      step.addEventListener('focus', () => selectStep(step));
      step.addEventListener('click', () => selectStep(step));
    });
  });

  document.querySelectorAll('.light-faq-list details').forEach((detail) => {
    const summary = detail.querySelector('summary');
    detail.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(detail.hasAttribute('open')));
    });
  });
</script>

<style>
  .light-container {
    width: min(100% - 2.5rem, 78rem);
    margin-inline: auto;
  }
  .light-section {
    padding-block: clamp(5rem, 8vw, 8rem);
  }
  .light-section-heading {
    max-width: 46rem;
    margin-bottom: 3rem;
  }

  .light-final-cta p {
    margin-bottom: 0.8rem;
    color: var(--color-porters-gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .light-section-heading h2,
  .light-offer-copy h2,
  .light-proximity-copy h2,
  .light-faq-copy h2,
  .light-final-cta h2 {
    margin-bottom: 1rem;
    font-size: clamp(2.3rem, 4.4vw, 4.2rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .light-section-heading > span,
  .light-proximity-copy > span,
  .light-faq-copy > span,
  .light-final-cta > .light-container > span {
    display: block;
    color: rgba(40, 55, 67, 0.6);
    line-height: 1.7;
  }
  .light-logo-strip {
    min-height: 8.5rem;
    border-block: 1px solid rgba(40, 55, 67, 0.08);
    background: white;
  }
  .light-logo-marquee {
    min-width: 0;
    padding-block: 2.25rem;
  }
  .light-logo-marquee:focus-visible,
  .light-jobs-marquee:focus-visible {
    outline: 2px solid var(--color-porters-gold);
    outline-offset: -3px;
  }
  .light-logo-track {
    --marquee-duration: 38s;
    gap: 0;
  }
  .light-logo-group {
    display: flex;
    min-width: max-content;
    align-items: center;
    gap: clamp(4rem, 7vw, 7.5rem);
    padding-right: clamp(4rem, 7vw, 7.5rem);
  }
  .light-logo-group picture {
    display: contents;
  }
  .light-logo-group img {
    width: clamp(7rem, 10vw, 10rem);
    max-width: 10rem;
    max-height: 3.5rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.68;
    transition: opacity var(--motion-fast) ease, transform var(--motion-medium) var(--ease-soft), filter var(--motion-fast) ease;
  }
  .light-logo-group img:hover {
    filter: grayscale(0.25);
    opacity: 0.92;
    transform: scale(1.05);
  }
  .light-offer-item > span,
  .light-city-list a > span {
    color: var(--color-porters-gold);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .light-offer-section {
    background: #f7f4ed;
  }
  .light-offer-layout,
  .light-proximity-layout,
  .light-faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 8vw, 7rem);
  }
  .light-offer-copy,
  .light-proximity-copy,
  .light-faq-copy {
    align-self: start;
  }
  .light-offer-copy h2,
  .light-proximity-copy h2,
  .light-faq-copy h2 {
    font-size: clamp(2.2rem, 3.6vw, 3.5rem);
  }
  .light-offer-copy > span {
    display: block;
    max-width: 30rem;
    color: rgba(40, 55, 67, 0.62);
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .light-offer-copy > a,
  .light-proximity-copy > a,
  .light-faq-copy > a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    color: var(--color-porters-navy);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .light-offer-welcome {
    width: min(100%, 31rem);
    margin: clamp(2rem, 4vw, 3.25rem) 0 0;
    opacity: 0.98;
    transform-origin: 42% 58%;
    -webkit-mask-image: radial-gradient(ellipse 94% 91% at 50% 49%, #000 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 94% 91% at 50% 49%, #000 70%, transparent 100%);
  }
  .light-offer-welcome img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.88) contrast(0.98);
  }
  .light-offer-schema {
    display: grid;
    gap: 1.1rem;
  }
  .light-offer-flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    min-height: 25rem;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid rgba(40, 55, 67, 0.1);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 50%, rgba(190, 158, 88, 0.13), transparent 28%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.18));
  }
  .light-offer-flow::before,
  .light-offer-flow::after {
    position: absolute;
    inset: 50% 1.35rem auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(190, 158, 88, 0.46), transparent);
    content: "";
    pointer-events: none;
  }
  .light-offer-flow::after {
    inset: 1.35rem auto 1.35rem 50%;
    width: 1px;
    height: auto;
    background: linear-gradient(180deg, transparent, rgba(190, 158, 88, 0.46), transparent);
  }
  .light-offer-item {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    min-height: 10.7rem;
    border: 1px solid rgba(40, 55, 67, 0.1);
    border-radius: 8px;
    padding: 1.1rem;
    background: rgba(255, 255, 255, 0.62);
    color: var(--color-porters-navy);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      transform var(--motion-medium) var(--ease-soft),
      box-shadow var(--motion-medium) ease,
      background-color var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }

  /* This section has an intentional second act: its framing and editorial copy
     arrive first, then the four service "puces" wait long enough to be noticed
     before popping in individually. */
  .light-offer-section.motion-section-ready .light-offer-item[data-motion-item] {
    opacity: 0;
    filter: blur(11px);
    transform: translateY(3.4rem) scale(.58) rotate(-3deg);
    transition: none;
  }

  .light-offer-section.motion-section-ready.is-motion-visible .light-offer-item[data-motion-item] {
    animation: offer-puce-intro .9s var(--offer-pop-delay, 1250ms) cubic-bezier(.16,1,.3,1) both;
  }

  .light-offer-section.motion-section-ready .light-offer-detail[data-motion-item] {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(2.4rem) scale(.94);
    transition: none;
  }

  .light-offer-section.motion-section-ready.is-motion-visible .light-offer-detail[data-motion-item] {
    animation: offer-detail-intro .78s 2.55s cubic-bezier(.16,1,.3,1) both;
  }

  @keyframes offer-puce-intro {
    0% { opacity:0;filter:blur(11px);transform:translateY(3.4rem) scale(.58) rotate(-3deg); }
    62% { opacity:1;filter:blur(0);transform:translateY(-.65rem) scale(1.075) rotate(1deg); }
    82% { opacity:1;filter:none;transform:translateY(.2rem) scale(.985) rotate(0); }
    100% { opacity:1;filter:none;transform:none; }
  }

  @keyframes offer-detail-intro {
    from { opacity:0;filter:blur(8px);transform:translateY(2.4rem) scale(.94); }
    to { opacity:1;filter:none;transform:none; }
  }
  .light-offer-item:hover,
  .light-offer-item:focus-visible,
  .light-offer-item.is-active {
    border-color: rgba(190, 158, 88, 0.48);
    background: #fff;
    box-shadow: 0 18px 42px rgba(40, 55, 67, 0.1);
    outline: none;
    transform: translateY(-5px);
  }
  .light-offer-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgba(190, 158, 88, 0.4);
    border-radius: 50%;
    color: var(--color-porters-gold);
    transform: scale(0.92);
    transition:
      color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      transform var(--motion-medium) var(--ease-soft);
  }
  .light-offer-item:hover .light-offer-icon,
  .light-offer-item:focus-visible .light-offer-icon,
  .light-offer-item.is-active .light-offer-icon {
    background: var(--color-porters-gold);
    color: var(--color-porters-navy);
    transform: scale(1) rotate(-4deg);
  }
  .light-offer-item h3 {
    margin-bottom: 0.45rem;
    font-size: 1.1rem;
  }
  .light-offer-item p {
    margin: 0;
    color: rgba(40, 55, 67, 0.6);
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .light-offer-detail {
    position: relative;
    overflow: hidden;
    min-height: 12rem;
    border: 1px solid rgba(40, 55, 67, 0.1);
    border-radius: 8px;
    padding: clamp(1.25rem, 2vw, 1.8rem);
    background: #fff;
    box-shadow: 0 18px 42px rgba(40, 55, 67, 0.06);
  }
  .light-offer-detail::after {
    position: absolute;
    right: -4rem;
    bottom: -5rem;
    width: 13rem;
    aspect-ratio: 1;
    border: 1px solid rgba(190, 158, 88, 0.24);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }
  .light-offer-detail h3 {
    margin-top: 0;
    color: var(--color-porters-navy);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
  }
  .light-offer-detail p {
