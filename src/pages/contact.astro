---
import PageLayout from '../layouts/PageLayout.astro';
import ContactFormStatic from '../components/forms/ContactFormStatic.astro';
import ContactDirectory from '../components/contact/ContactDirectory';
import { pageSeo } from '../data/seo.data';
import contactImage from '../../images/enterprise-collaboration.webp';
---

<PageLayout
  seo={pageSeo.contact}
  breadcrumbs={[{ label: 'Contact' }]}
>
  <section class="section pt-8 lg:pt-16 pb-20">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-16 grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(18rem,0.62fr)] lg:items-center">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-wider text-porters-gold mb-4">Contact</p>
          <h1 class="mb-4">Posez votre question. <span class="gold-underline">Nous y répondons précisément.</span></h1>
          <p class="text-porters-black/60 max-w-2xl text-lg leading-relaxed">
            Mission déjà trouvée, statut à comparer, simulation à relire, ou un besoin de profil à couvrir. Plus le contexte est précis, plus la réponse l’est&nbsp;— et plus vite elle arrive.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <span class="pill">Mission et statut</span>
            <span class="pill">Simulation et frais</span>
            <span class="pill">Besoin d’expertise</span>
          </div>
        </div>
        <div class="reveal overflow-hidden rounded-lg border border-porters-navy/10 bg-white shadow-[0_18px_50px_rgba(25,43,99,0.08)]">
          <img
            src={contactImage.src}
            width={contactImage.width}
            height={contactImage.height}
            alt="Échange professionnel dans un bureau lumineux."
            class="h-72 w-full object-cover lg:h-80"
          />
        </div>
      </div>

      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16 max-w-6xl mx-auto">
        <!-- Contact Form -->
        <div class="lg:col-span-3 reveal">
          <div class="card p-8 lg:p-10">
            <h2 class="text-2xl font-heading font-semibold text-porters-navy mb-8">Où en êtes-vous&nbsp;?</h2>
            <ContactFormStatic />
          </div>
        </div>

        <!-- Contact information is a structured CMS block so agencies can be added, reordered or removed. -->
        <ContactDirectory client:load />
      </div>
    </div>
  </section>
</PageLayout>
