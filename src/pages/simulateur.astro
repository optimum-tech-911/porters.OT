---
import PageLayout from '../layouts/PageLayout.astro';
import SimulatorForm from '../components/forms/SimulatorForm.tsx';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import { pageSeo } from '../data/seo.data';
import simulatorImage from '../../images/financial-calculator.webp';
import calculatorImage from '../../images/business-meeting.webp';

const seo = {
  title: pageSeo.simulateur.title,
  description: pageSeo.simulateur.description,
};

const breadcrumbs = [{ label: 'Simulateur' }];
const faqItems = [
  {
    question: 'Comment est calculé le résultat de la simulation ?',
    answer: 'La simulation combine le chiffre d\'affaires, les frais professionnels et des paramètres sociaux estimatifs. Le résultat est indicatif et doit être affiné avec un conseiller.',
  },
  {
    question: 'Le résultat de la simulation est-il garanti ?',
    answer: 'Non, cette simulation fournit une estimation indicative. Votre rémunération réelle dépend notamment de votre situation, des frais professionnels déclarés et des paramètres contractuels. Contactez-nous pour une simulation personnalisée.',
  },
  {
    question: 'Quel TJM minimum faut-il pratiquer ?',
    answer: 'Il n’y en a pas. Votre tarif dépend de votre expertise, de la tension sur votre métier, de la durée de la mission et du net que vous visez. Le simulateur sert justement à tester plusieurs scénarios avant d’en parler.',
  },
];
---

<PageLayout seo={{
  ...seo,
  structuredData: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
}} breadcrumbs={breadcrumbs}>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-porters-navy text-porters-white">
    <div class="absolute inset-0">
      <img
        src={simulatorImage.src}
        width={simulatorImage.width}
        height={simulatorImage.height}
        alt=""
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(25,43,99,0.96)_0%,rgba(25,43,99,0.84)_42%,rgba(25,43,99,0.38)_72%,rgba(25,43,99,0.12)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(11,16,32,0.18)_0%,rgba(11,16,32,0.42)_100%)]"></div>
    </div>
    <div class="container relative mx-auto px-6 py-20 lg:px-8 lg:py-28 simulator-hero-content">
      <div class="max-w-2xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Décider avec des chiffres</p>
        <h1 class="mb-6 max-w-[36rem] text-porters-white">
          Votre TJM en net, <span class="gold-underline">ligne par ligne</span>
        </h1>
        <p class="max-w-xl text-base leading-relaxed text-porters-white/82 sm:text-lg">
          Chiffre d’affaires, frais de gestion, frais professionnels, cotisations, net : chaque ligne apparaît séparément. Le résultat reste une estimation tant que votre situation n’a pas été validée.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-porters-white/78">Portage & activité autonome</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-porters-white/78">Résultat en direct</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-porters-white/78">Sans créer de compte</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Simulator -->
  <section class="section bg-porters-navy/[0.02] brand-ambient-host">
    <BrandAmbientShapes placement="right" />
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-10 grid gap-8 lg:grid-cols-[minmax(0,0.72fr)_minmax(18rem,0.28fr)] lg:items-end">
        <div class="reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Votre projection</p>
          <h2 class="mb-4">Partez de vos vrais chiffres</h2>
          <p class="max-w-2xl text-porters-black/62">
            Le parcours portage part de votre chiffre d’affaires mensuel. Le parcours freelance part de
            votre TJM et de vos jours facturés. Dans les deux cas, le chiffre d’affaires n’est jamais
            présenté comme un net.
          </p>
        </div>
        <div class="reveal overflow-hidden rounded-lg border border-porters-navy/10 bg-white shadow-sm">
          <img
            src={calculatorImage.src}
            width={calculatorImage.width}
            height={calculatorImage.height}
            alt="Main utilisant une calculatrice sur des documents financiers."
            class="h-48 w-full object-cover"
          />
        </div>
      </div>
      <SimulatorForm client:load />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section brand-ambient-host" style="background-color: rgba(25, 43, 99, 0.03);">
    <BrandAmbientShapes placement="left" />
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12 reveal">
          <h2>Questions sur la <span class="gold-underline">simulation</span></h2>
        </div>
        <div class="space-y-4 reveal">
          {faqItems.map((faq) => (
            <details class="group border rounded-lg" style="border-color: rgba(25, 43, 99, 0.1);">
              <summary class="flex items-center justify-between p-5 cursor-pointer font-heading font-semibold text-porters-navy hover:text-porters-gold transition-colors">
                <span>{faq.question}</span>
                <span class="ml-4 shrink-0 transition-transform group-open:rotate-45 text-porters-gold text-xl">+</span>
              </summary>
              <div class="px-5 pb-5" style="color: rgba(11, 16, 32, 0.7);">
                <p class="mb-0">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-porters-navy text-porters-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-porters-white mb-4">
          Un chiffre sans explication ne vaut rien. <span class="gold-underline">Faisons-le relire.</span>
        </h2>
        <p class="text-lg mb-8" style="color: rgba(250, 248, 243, 0.8);">
          Un conseiller reprend vos hypothèses avec vos vrais paramètres de mission et vous dit ce qui bougera.
        </p>
        <a href="/rendez-vous" class="btn btn-gold">Je parle à un conseiller</a>
      </div>
    </div>
  </section>

</PageLayout>
