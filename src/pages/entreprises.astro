---
import PageLayout from '../layouts/PageLayout.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import { pageSeo } from '../data/seo.data';
import enterpriseHeroImage from '../../images/team-workshop.webp';
import { enterprisePage } from '../content/pages/entreprises';

const scoping = [
  { label: 'Technique', detail: 'Stack et environnement' },
  { label: 'Organisation', detail: 'Équipe et interfaces' },
  { label: 'Calendrier', detail: 'Démarrage et durée' },
  { label: 'Autonomie', detail: 'Rôle et responsabilités' },
  { label: 'Sécurité', detail: 'Accès et contraintes' },
];

const projects = [
  {
    title: 'Migration d’un socle Big Data',
    context: 'Organisme public national',
    text: 'Passage de Hortonworks à Cloudera Data Platform, avec reprise de l’architecture et sécurisation de la trajectoire.',
    profiles: ['Architecture système', 'Big Data', 'Développement senior'],
  },
  {
    title: 'Applications critiques IBM i / AS400',
    context: 'Environnement métier historique',
    text: 'Analyse, développement spécifique et maintenance d’applications centrales, sans fragiliser la continuité de service.',
    profiles: ['Analyse-programmation', 'Pilotage applicatif', 'Maintenance évolutive'],
  },
  {
    title: 'Reprise de modèles de données',
    context: 'Contexte industriel',
    text: 'Audit de l’existant, recommandations d’outils et construction d’applicatifs internes autour de données fiabilisées.',
    profiles: ['Architecture data', 'Data science', 'Fullstack'],
  },
];

const models = [
  {
    label: 'Consultant déjà identifié',
    title: 'Portage salarial',
    text: 'The Porters met en place le contrat de prestation et porte le cadre salarial, la facturation et la paie.',
    icon: 'shield' as const,
  },
  {
    label: 'Expertise encore à trouver',
    title: 'The Big Porters',
    text: 'L’ESN du groupe cadre le besoin, source et évalue les profils, puis suit la mission.',
    icon: 'network' as const,
  },
];
---

<PageLayout
  seo={{ title: pageSeo.entreprises.title, description: pageSeo.entreprises.description }}
  breadcrumbs={[{ label: 'Entreprises' }]}
>
  <section class="enterprise-hero">
    <img
      src={enterpriseHeroImage.src}
      width={enterpriseHeroImage.width}
      height={enterpriseHeroImage.height}
      alt=""
      class="enterprise-hero-image"
    />
    <div class="enterprise-hero-overlay"></div>
    <div class="enterprise-shell enterprise-hero-grid">
      <div class="enterprise-hero-copy reveal">
        <p>Entreprises</p>
        <h1>Un besoin IT précis.<br /><span>Un profil évalué sur le réel.</span></h1>
        <strong>
          Nous cadrons le contexte, comparons les compétences sur une même grille et proposons
          le mode d’intervention adapté. Pas une pile de CV.
        </strong>
        <a href="/contact">Décrire mon besoin <span aria-hidden="true">→</span></a>
      </div>

      <div class="enterprise-signal reveal" aria-label="Du besoin au profil qualifié">
        <svg viewBox="0 0 760 560" aria-hidden="true">
          <defs>
            <linearGradient id="signal-gold" x1="0" x2="1">
              <stop offset="0" stop-color="#d5b668" stop-opacity=".2" />
              <stop offset=".5" stop-color="#d5b668" />
              <stop offset="1" stop-color="#d5b668" stop-opacity=".2" />
            </linearGradient>
          </defs>
          <path d="M126 92C240 92 252 280 366 280" />
          <path d="M126 186C238 186 254 280 366 280" />
          <path d="M126 280H366" />
          <path d="M126 374C238 374 254 280 366 280" />
          <path d="M126 468C240 468 252 280 366 280" />
          <path class="signal-output-line" d="M438 280H650" />
        </svg>
        <div class="enterprise-inputs">
          {scoping.map((item, index) => (
            <div class={`enterprise-input input-${index + 1}`}>
              <span>0{index + 1}</span>
              <strong>{item.label}</strong>
              <small>{item.detail}</small>
            </div>
          ))}
        </div>
        <div class="enterprise-core">
          <span>Analyse</span>
          <strong>Besoin cadré</strong>
          <small>Une grille commune</small>
        </div>
        <div class="enterprise-output">
          <span aria-hidden="true"><SiteIcon name="check" /></span>
          <strong>Profil qualifié</strong>
          <small>Compétences · disponibilité · contexte</small>
        </div>
      </div>
    </div>
  </section>

  <section class="enterprise-process brand-ambient-host" id="processus">
    <BrandAmbientShapes placement="left" />
    <div class="enterprise-shell">
      <header class="enterprise-heading reveal">
        <p>Notre processus de sélection</p>
        <h2>Cinq étapes. <span class="gold-underline">Une seule grille.</span></h2>
        <strong>Le détail apparaît au bon moment pendant votre lecture, sans afficher cinq blocs de texte en parallèle.</strong>
      </header>

      <div class="enterprise-scroll-system" data-enterprise-process>
        <aside class="process-stage">
          <div class="process-stage-grid" aria-hidden="true"></div>
          <div class="process-stage-ring">
            <span data-process-number>01</span>
            <small>Étape active</small>
          </div>
          <div class="process-stage-copy" aria-live="polite">
            <p data-process-kicker>Sélection</p>
            <h3 data-process-title>{enterprisePage.selection[0]?.title}</h3>
            <span data-process-text>{enterprisePage.selection[0]?.text}</span>
          </div>
          <div class="process-progress" aria-hidden="true">
            <span data-process-progress style="--process-progress:20%"></span>
          </div>
        </aside>

        <ol class="process-steps">
          {enterprisePage.selection.map((item, index) => (
            <li
              class:list={['process-step', { 'is-active': index === 0 }]}
              data-process-step
              data-number={item.step}
              data-title={item.title}
              data-text={item.text}
              tabindex="0"
            >
              <span>{item.step}</span>
              <div>
                <small>{index === 0 ? 'Point de départ' : index === enterprisePage.selection.length - 1 ? 'Sortie' : 'Vérification'}</small>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="enterprise-perimeters">
    <div class="enterprise-shell">
      <header class="enterprise-heading enterprise-heading--compact reveal">
        <p>Périmètres mobilisables</p>
        <h2>Du socle historique à l’IA.</h2>
      </header>
      <div class="perimeter-map reveal">
        <div class="perimeter-core">
          <small>Votre contexte</small>
          <strong>Une mission définie</strong>
        </div>
        {enterprisePage.useCases.map((useCase, index) => (
          <a
            class={`perimeter-node perimeter-${index + 1}`}
            href={useCase.href}
            aria-label={`${useCase.title} — voir le domaine en détail`}
          >
            <span>0{index + 1}</span>
            <h3>{useCase.title}</h3>
            <p>{useCase.text}</p>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="enterprise-projects brand-ambient-host">
    <BrandAmbientShapes placement="right" />
    <div class="enterprise-shell">
      <header class="enterprise-heading reveal">
        <p>Expérience mobilisable</p>
        <h2>Des projets décrits <span class="gold-underline">par les faits</span>.</h2>
      </header>

      <div class="project-lab reveal" data-project-lab>
        <div class="project-tabs" role="tablist" aria-label="Exemples de projets">
          {projects.map((project, index) => (
            <button
              type="button"
              role="tab"
              id={`project-tab-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`project-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
              class:list={['project-tab', { 'is-active': index === 0 }]}
              data-project-tab
            >
              <span>0{index + 1}</span>
              <strong>{project.title}</strong>
            </button>
          ))}
        </div>
        <div class="project-panels">
          {projects.map((project, index) => (
            <article
              id={`project-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`project-tab-${index}`}
              class="project-panel"
              hidden={index !== 0}
              data-project-panel
            >
              <div class="project-panel-index">0{index + 1}</div>
              <div>
                <p>{project.context}</p>
                <h3>{project.title}</h3>
                <strong>{project.text}</strong>
                <div>{project.profiles.map((profile) => <span>{profile}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="enterprise-choice">
    <div class="enterprise-shell">
      <header class="enterprise-heading enterprise-heading--center reveal">
        <p>Le bon cadre</p>
        <h2>Partez de votre point de départ.</h2>
      </header>
      <div class="choice-schema reveal">
        <div class="choice-question">
          <span>01</span>
          <strong>Le consultant est-il déjà identifié&nbsp;?</strong>
        </div>
        <div class="choice-branch" aria-hidden="true"><span>Oui</span><i></i><span>Non</span></div>
        <div class="choice-models">
          {models.map((model) => (
            <article>
              <div class="icon-chip"><SiteIcon name={model.icon} /></div>
              <p>{model.label}</p>
              <h3>{model.title}</h3>
              <strong>{model.text}</strong>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="enterprise-cta">
    <div class="enterprise-shell">
      <div class="reveal">
        <p>Votre besoin</p>
        <h2>Décrivez le contexte. Nous cadrons la suite.</h2>
        <strong>Technologies, organisation, délai, autonomie et sécurité&nbsp;: cinq informations suffisent pour commencer.</strong>
      </div>
      <a href="/contact">Décrire mon besoin <span aria-hidden="true">→</span></a>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-enterprise-process]').forEach((system) => {
    const steps = Array.from(system.querySelectorAll<HTMLElement>('[data-process-step]'));
    const number = system.querySelector<HTMLElement>('[data-process-number]');
    const title = system.querySelector<HTMLElement>('[data-process-title]');
    const text = system.querySelector<HTMLElement>('[data-process-text]');
    const progress = system.querySelector<HTMLElement>('[data-process-progress]');

    const select = (step: HTMLElement) => {
      const index = steps.indexOf(step);
      steps.forEach((item) => item.classList.toggle('is-active', item === step));
      if (number) number.textContent = step.dataset.number || '';
      if (title) title.textContent = step.dataset.title || '';
      if (text) text.textContent = step.dataset.text || '';
      if (progress) progress.style.setProperty('--process-progress', `${((index + 1) / steps.length) * 100}%`);
    };

    steps.forEach((step) => {
      step.addEventListener('focus', () => select(step));
      step.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') select(step);
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) select(entry.target as HTMLElement);
        });
      }, { rootMargin: '-35% 0px -48% 0px', threshold: 0.35 });
      steps.forEach((step) => observer.observe(step));
    }
  });

  document.querySelectorAll<HTMLElement>('[data-project-lab]').forEach((lab) => {
    const tabs = Array.from(lab.querySelectorAll<HTMLButtonElement>('[data-project-tab]'));
    const panels = Array.from(lab.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const select = (nextIndex: number, focus = false) => {
      const index = (nextIndex + tabs.length) % tabs.length;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
        panel.classList.remove('is-entering');
        if (panelIndex === index) requestAnimationFrame(() => panel.classList.add('is-entering'));
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : index + (event.key === 'ArrowRight' ? 1 : -1);
        select(next, true);
      });
    });
  });
</script>

<style>
  .enterprise-shell {
    width: min(100% - 3rem, 84rem);
    margin-inline: auto;
  }

  .enterprise-hero {
    position: relative;
    min-height: 44rem;
    overflow: hidden;
    background: #102630;
    color: #fff;
  }

  .enterprise-hero-image,
  .enterprise-hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .enterprise-hero-image {
    object-fit: cover;
    opacity: .42;
  }

  .enterprise-hero-overlay {
    background:
      linear-gradient(90deg, rgba(16,38,48,.98), rgba(16,38,48,.91) 48%, rgba(16,38,48,.68)),
      radial-gradient(circle at 75% 50%, rgba(213,182,104,.2), transparent 34%);
  }

  .enterprise-hero-grid {
    position: relative;
    display: grid;
    min-height: 44rem;
    grid-template-columns: minmax(0,.72fr) minmax(32rem,1.05fr);
    align-items: center;
    gap: clamp(3rem,6vw,6rem);
    padding-block: 5rem;
  }

  .enterprise-hero-copy > p,
  .enterprise-heading > p,
  .enterprise-cta p {
    margin: 0 0 1rem;
    color: #d5b668;
    font-size: .7rem;
    font-weight: 760;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .enterprise-hero-copy h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(3rem,5vw,5.5rem);
    line-height: .98;
    letter-spacing: -.055em;
  }

  .enterprise-hero-copy h1 span {
    color: #d5b668;
  }

  .enterprise-hero-copy > strong {
    display: block;
    max-width: 39rem;
    margin-top: 1.6rem;
    color: rgba(255,255,255,.7);
    font-size: clamp(.98rem,1.4vw,1.14rem);
    font-weight: 500;
    line-height: 1.7;
  }

  .enterprise-hero-copy > a,
  .enterprise-cta a {
    display: inline-flex;
    min-height: 3.3rem;
    align-items: center;
    gap: .75rem;
    margin-top: 2rem;
    border-radius: 999px;
    padding-inline: 1.4rem;
    background: #d5b668;
    color: #102630;
    font-size: .82rem;
    font-weight: 780;
    transition: transform 220ms var(--ease-soft), box-shadow 220ms ease;
  }

  .enterprise-hero-copy > a:hover,
  .enterprise-cta a:hover {
    box-shadow: 0 16px 38px rgba(0,0,0,.2);
    transform: translateY(-3px);
  }

  .enterprise-signal {
    position: relative;
    min-height: 35rem;
  }

  .enterprise-signal > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .enterprise-signal path {
    fill: none;
    stroke: url(#signal-gold);
    stroke-width: 1.5;
    stroke-dasharray: 5 10;
    animation: enterprise-flow 3s linear infinite;
  }

  .signal-output-line {
    stroke-width: 2.5 !important;
  }

  .enterprise-input {
    position: absolute;
    left: 0;
    display: grid;
    width: 10.6rem;
    grid-template-columns: auto 1fr;
    gap: .14rem .65rem;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 11px;
    padding: .68rem .78rem;
    background: rgba(255,255,255,.08);
    box-shadow: 0 14px 32px rgba(0,0,0,.14);
    backdrop-filter: blur(10px);
    animation: input-float 5s ease-in-out infinite;
  }

  .enterprise-input span {
    grid-row: span 2;
    color: #d5b668;
    font-family: var(--font-mono);
    font-size: .58rem;
  }

  .enterprise-input strong {
    color: #fff;
    font-size: .72rem;
  }

  .enterprise-input small {
    grid-column: 2;
    color: rgba(255,255,255,.48);
    font-size: .58rem;
  }

  .input-1 { top: 4%; animation-delay: -1s; }
  .input-2 { top: 21%; animation-delay: -2s; }
  .input-3 { top: 43%; animation-delay: -3s; }
  .input-4 { top: 65%; animation-delay: -4s; }
  .input-5 { top: 82%; animation-delay: -5s; }

  .enterprise-core,
  .enterprise-output {
    position: absolute;
    display: grid;
    place-content: center;
    text-align: center;
  }

  .enterprise-core {
    top: 50%;
    left: 52%;
    width: 9rem;
    aspect-ratio: 1;
    border: 1px solid rgba(213,182,104,.55);
    border-radius: 50%;
    background: rgba(16,38,48,.92);
    box-shadow: 0 0 0 2rem rgba(213,182,104,.05);
    transform: translate(-50%,-50%);
  }

  .enterprise-core span,
  .enterprise-core small,
  .enterprise-output small {
    color: rgba(255,255,255,.5);
    font-size: .58rem;
  }

  .enterprise-core strong,
  .enterprise-output strong {
    margin-block: .3rem;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1rem;
  }

  .enterprise-output {
    top: 50%;
    right: 0;
    min-width: 13rem;
    min-height: 8rem;
    border: 1px solid rgba(213,182,104,.4);
    border-radius: 14px;
    padding: 1rem;
    background: rgba(213,182,104,.13);
    transform: translateY(-50%);
    backdrop-filter: blur(12px);
  }

  .enterprise-output > span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    margin: 0 auto .4rem;
    border-radius: 50%;
    background: #d5b668;
    color: #102630;
  }

  .enterprise-process,
  .enterprise-projects,
  .enterprise-choice {
    padding-block: clamp(5rem,9vw,8rem);
  }

  .enterprise-process {
    background: #f7f5ef;
  }

  .enterprise-heading {
    max-width: 52rem;
    margin-bottom: 3.5rem;
  }

  .enterprise-heading h2 {
    margin: 0;
    font-size: clamp(2.5rem,4.8vw,4.7rem);
    line-height: 1.02;
    letter-spacing: -.045em;
  }

  .enterprise-heading > strong {
    display: block;
    max-width: 42rem;
    margin-top: 1rem;
    color: rgba(40,55,67,.62);
    font-weight: 500;
    line-height: 1.7;
  }

  .enterprise-heading--compact {
    max-width: 45rem;
  }

  .enterprise-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .enterprise-scroll-system {
    display: grid;
    grid-template-columns: minmax(22rem,.8fr) minmax(0,1.2fr);
    align-items: start;
    gap: clamp(2.5rem,6vw,6rem);
  }

  .process-stage {
    position: sticky;
    top: 8rem;
    overflow: hidden;
    min-height: 31rem;
    border: 1px solid rgba(40,55,67,.1);
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 28%, rgba(213,182,104,.16), transparent 31%),
      #fff;
    box-shadow: 0 24px 65px rgba(40,55,67,.08);
  }

  .process-stage-grid {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 28%,rgba(213,182,104,.09),transparent 36%);
  }

  .process-stage-ring {
    position: relative;
    display: grid;
    width: 9.5rem;
    aspect-ratio: 1;
    place-content: center;
    margin: 3rem auto 0;
    border: 1px solid rgba(213,182,104,.5);
    border-radius: 50%;
    box-shadow: 0 0 0 1.7rem rgba(213,182,104,.06), 0 0 0 3.4rem rgba(213,182,104,.025);
    text-align: center;
  }

  .process-stage-ring span {
    color: var(--color-porters-navy);
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
  }

  .process-stage-ring small {
    margin-top: .3rem;
    color: #a47f34;
    font-size: .58rem;
    font-weight: 760;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .process-stage-copy {
    position: relative;
    padding: 3rem 2rem 1.5rem;
    text-align: center;
  }

  .process-stage-copy > p {
    margin: 0;
    color: #a47f34;
    font-size: .62rem;
    font-weight: 760;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .process-stage-copy h3 {
    margin: .6rem 0 0;
    font-size: clamp(1.5rem,2.8vw,2.25rem);
  }

  .process-stage-copy > span {
    display: block;
    margin-top: .7rem;
    color: rgba(40,55,67,.6);
    font-size: .82rem;
    line-height: 1.6;
  }

  .process-progress {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(40,55,67,.08);
  }

  .process-progress span {
    display: block;
    width: var(--process-progress);
    height: 100%;
    background: #d5b668;
    transition: width 420ms var(--ease-soft);
  }

  .process-steps {
    display: grid;
    gap: 1.2rem;
    padding-block: 7rem 12rem;
  }

  .process-step {
    display: grid;
    min-height: 15rem;
    grid-template-columns: auto 1fr;
    align-content: center;
    gap: 1.3rem;
    border: 1px solid rgba(40,55,67,.09);
    border-radius: 14px;
    padding: clamp(1.5rem,3vw,2.4rem);
    background: rgba(255,255,255,.58);
    opacity: .42;
    transform: translateX(18px) scale(.98);
    transition: opacity 320ms ease,transform 420ms var(--ease-soft),background 240ms ease,box-shadow 240ms ease;
  }

  .process-step.is-active,
  .process-step:focus-visible {
    background: #fff;
    box-shadow: 0 22px 55px rgba(40,55,67,.1);
    opacity: 1;
    outline: none;
    transform: none;
  }

  .process-step > span {
    color: #d5b668;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
  }

  .process-step small {
    color: #a47f34;
    font-size: .58rem;
