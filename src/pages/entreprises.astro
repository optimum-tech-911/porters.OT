---
import PageLayout from '../layouts/PageLayout.astro';
import { pageSeo } from '../data/seo.data';
import enterpriseHeroImage from '../../images/team-workshop.webp';
import { enterprisePage } from '../content/pages/entreprises';

const scoping = [
  'Environnement technique',
  'Organisation en place',
  'Calendrier réel',
  'Niveau d’autonomie',
  'Contraintes de sécurité',
];

const projects = [
  {
    title: 'Migration d’un socle Big Data',
    text: 'Passage de Hortonworks à Cloudera Data Platform pour un organisme public national.',
    profiles: 'Architecture système · Big Data · Développement senior',
  },
  {
    title: 'Applications critiques IBM i / AS400',
    text: 'Analyse, développement spécifique et maintenance d’applications métier historiques.',
    profiles: 'Analyse-programmation · Pilotage applicatif',
  },
  {
    title: 'Reprise de modèles de données',
    text: 'Audit de l’existant, recommandations d’outils et mise en place d’applicatifs internes.',
    profiles: 'Architecture data · Data science · Fullstack',
  },
];

const models = [
  {
    label: 'Portage salarial',
    title: 'Vous avez déjà identifié le consultant',
    text: 'The Porters met en place le contrat de prestation et porte le cadre salarial, la facturation et la paie.',
  },
  {
    label: 'ESN du groupe',
    title: 'Vous cherchez encore le bon profil',
    text: 'The Big Porters cadre le besoin, source et évalue les profils, puis suit la mission.',
  },
];
---

<PageLayout
  seo={{ title: pageSeo.entreprises.title, description: pageSeo.entreprises.description }}
  breadcrumbs={[{ label: 'Entreprises' }]}
>
  <section class="relative overflow-hidden bg-porters-navy text-porters-white">
    <img
      src={enterpriseHeroImage.src}
      width={enterpriseHeroImage.width}
      height={enterpriseHeroImage.height}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(25,43,99,0.97)_0%,rgba(25,43,99,0.86)_48%,rgba(25,43,99,0.3)_100%)]"></div>
    <div class="container relative mx-auto px-6 py-24 lg:px-8 lg:py-32">
      <div class="max-w-2xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Entreprises</p>
        <h1 class="text-porters-white">Un besoin IT précis. Des profils évalués sur le réel.</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-porters-white/80">
          Nous cadrons le contexte, évaluons les compétences et proposons le bon mode d’intervention.
          Vous recevez des profils qualifiés, pas une pile de CV.
        </p>
        <div class="mt-9">
          <a href="/contact" class="btn btn-gold">Décrire mon besoin</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.68fr)_minmax(18rem,0.52fr)] lg:items-end">
        <div class="reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Avant le premier profil</p>
          <h2>Le contexte d’abord. Le CV ensuite.</h2>
          <p class="mt-5 max-w-2xl text-porters-black/66">
            Une compétence ne se juge pas hors sol. Nous cadrons cinq points avant de lancer la recherche.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 reveal">
          {scoping.map((item, index) => (
            <li class="flex items-center gap-3 border-b border-porters-navy/10 py-3 text-sm font-semibold text-porters-navy">
              <span class="font-mono text-xs text-porters-gold">0{index + 1}</span>{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]" id="processus">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-10 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Sélection</p>
        <h2>Cinq étapes, une grille commune</h2>
        <p class="mt-4 text-porters-black/65">
          Un même parcours pour rendre les profils comparables. Sélectionnez une étape pour voir ce que nous vérifions.
        </p>
      </div>
      <div class="selection-process reveal" data-selection-process>
        <div class="selection-tabs" role="tablist" aria-label="Étapes de sélection">
          {enterprisePage.selection.map((item, index) => (
            <button
              type="button"
              id={`selection-tab-${index}`}
              class:list={['selection-tab', { 'is-active': index === 0 }]}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`selection-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
              data-selection-tab
            >
              <span>{item.step}</span>
              <strong>{item.title}</strong>
            </button>
          ))}
        </div>
        <div class="selection-panels">
          {enterprisePage.selection.map((item, index) => (
            <article
              id={`selection-panel-${index}`}
              class="selection-panel"
              role="tabpanel"
              aria-labelledby={`selection-tab-${index}`}
              hidden={index !== 0}
              data-selection-panel
            >
              <span class="selection-panel-step">Étape {item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Expérience mobilisable</p>
        <h2>Des projets décrits par les faits</h2>
        <p class="mt-4 text-porters-black/65">Trois contextes techniques réels, présentés sans exposer le nom des clients.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="border-l-[3px] border-porters-gold bg-porters-navy/[0.03] p-7 reveal">
            <h3 class="text-lg">{project.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-porters-black/66">{project.text}</p>
            <p class="mb-0 mt-5 text-xs font-semibold uppercase tracking-[0.1em] text-porters-navy/55">{project.profiles}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-3xl text-center reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Deux cadres</p>
        <h2>Le modèle dépend de votre point de départ</h2>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {models.map((model) => (
          <article class="card reveal p-7 lg:p-9">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-porters-gold">{model.label}</p>
            <h3 class="text-xl">{model.title}</h3>
            <p class="mb-0 mt-4 text-sm leading-relaxed text-porters-black/65">{model.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-porters-navy py-16 text-porters-white">
    <div class="container mx-auto flex flex-col gap-7 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div class="max-w-2xl reveal">
        <h2 class="mb-2 text-porters-white">Décrivez le contexte. Nous cadrons la suite.</h2>
        <p class="mb-0 text-porters-white/65">Technologies, organisation, délai, autonomie et sécurité&nbsp;: cinq informations suffisent pour commencer.</p>
      </div>
      <a href="/contact" class="btn btn-gold shrink-0">Décrire mon besoin</a>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-selection-process]').forEach((process) => {
    const tabs = Array.from(process.querySelectorAll<HTMLButtonElement>('[data-selection-tab]'));
    const panels = Array.from(process.querySelectorAll<HTMLElement>('[data-selection-panel]'));

    const select = (nextIndex: number, moveFocus = false) => {
      tabs.forEach((tab, index) => {
        const active = index === nextIndex;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
        if (index === nextIndex) {
          panel.classList.remove('is-entering');
          requestAnimationFrame(() => panel.classList.add('is-entering'));
        }
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? tabs.length - 1
            : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(nextIndex, true);
      });
    });
  });
</script>

<style>
  .selection-process {
    overflow: hidden;
    border: 1px solid rgba(40, 55, 67, 0.1);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 22px 60px rgba(40, 55, 67, 0.07);
  }

  .selection-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-bottom: 1px solid rgba(40, 55, 67, 0.1);
  }

  .selection-tab {
    position: relative;
    display: grid;
    min-height: 7.5rem;
    align-content: start;
    gap: 0.65rem;
    border: 0;
    border-right: 1px solid rgba(40, 55, 67, 0.09);
    padding: 1.2rem;
    background: transparent;
    color: var(--color-porters-navy);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: background 180ms ease, color 180ms ease;
  }

  .selection-tab:last-child {
    border-right: 0;
  }

  .selection-tab::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: var(--color-porters-gold);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms var(--ease-soft);
  }

  .selection-tab:hover,
  .selection-tab:focus-visible,
  .selection-tab.is-active {
    background: rgba(190, 158, 88, 0.09);
    outline: none;
  }

  .selection-tab.is-active::after {
    transform: scaleX(1);
  }

  .selection-tab > span {
    color: var(--color-porters-gold);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
  }

  .selection-tab > strong {
    font-family: var(--font-heading);
    font-size: clamp(0.78rem, 1.2vw, 0.96rem);
    line-height: 1.35;
  }

  .selection-panels {
    min-height: 13rem;
    padding: clamp(1.8rem, 4vw, 3.2rem);
    background:
      radial-gradient(circle at 92% 30%, rgba(190, 158, 88, 0.12), transparent 25%),
      #fff;
  }

  .selection-panel {
    max-width: 52rem;
  }

  .selection-panel[hidden] {
    display: none;
  }

  .selection-panel.is-entering {
    animation: selection-enter 360ms var(--ease-soft);
  }

  .selection-panel-step {
    color: var(--color-porters-gold);
    font-size: 0.66rem;
    font-weight: 760;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .selection-panel h3 {
    margin: 0.65rem 0 0;
    font-size: clamp(1.6rem, 3vw, 2.35rem);
  }

  .selection-panel p {
    max-width: 47rem;
    margin: 1rem 0 0;
    color: rgba(40, 55, 67, 0.66);
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    line-height: 1.7;
  }

  @keyframes selection-enter {
    from {
      opacity: 0.25;
      transform: translateY(8px);
    }
  }

  @media (max-width: 820px) {
    .selection-tabs {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .selection-tab {
      min-width: 11rem;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selection-panel.is-entering {
      animation: none;
    }

    .selection-tab,
    .selection-tab::after {
      transition: none;
    }
  }
</style>
