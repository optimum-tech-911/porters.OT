---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import { pageSeo } from '../data/seo.data';
import ambreGuide from '../assets/enterprise/ambre-guide.png';
import qualifiedMatch from '../assets/enterprise/qualified-match.png';
import tripartiteClient from '../assets/home/tripartite-client.png';
import tripartiteConsultant from '../assets/home/tripartite-consultant.png';
import bigPortersLogo from '../assets/brands/big-porters-esn.png';
import { enterprisePage } from '../content/pages/entreprises';

const scoping = [
  { label: 'Technique', detail: 'Stack et environnement' },
  { label: 'Organisation', detail: 'Équipe et interfaces' },
  { label: 'Calendrier', detail: 'Démarrage et durée' },
  { label: 'Autonomie', detail: 'Rôle et responsabilités' },
  { label: 'Sécurité', detail: 'Accès et contraintes' },
];

const projects = [
  {
    title: 'Migration d’un socle Big Data',
    context: 'Organisme public national',
    text: 'Passage de Hortonworks à Cloudera Data Platform, avec reprise de l’architecture et sécurisation de la trajectoire.',
    profiles: ['Architecture système', 'Big Data', 'Développement senior'],
    image: tripartiteClient,
  },
  {
    title: 'Applications critiques IBM i / AS400',
    context: 'Environnement métier historique',
    text: 'Analyse, développement spécifique et maintenance d’applications centrales, sans fragiliser la continuité de service.',
    profiles: ['Analyse-programmation', 'Pilotage applicatif', 'Maintenance évolutive'],
    image: tripartiteConsultant,
  },
  {
    title: 'Reprise de modèles de données',
    context: 'Contexte industriel',
    text: 'Audit de l’existant, recommandations d’outils et construction d’applicatifs internes autour de données fiabilisées.',
    profiles: ['Architecture data', 'Data science', 'Fullstack'],
    image: qualifiedMatch,
  },
];

const models = [
  {
    label: 'Consultant déjà identifié',
    title: 'Portage salarial',
    text: 'The Porters met en place le contrat de prestation et porte le cadre salarial, la facturation et la paie.',
    icon: 'shield' as const,
  },
  {
    label: 'Expertise encore à trouver',
    title: 'The Big Porters',
    text: 'L’ESN du groupe cadre le besoin, source et évalue les profils, puis suit la mission.',
    icon: 'network' as const,
  },
];
---

<PageLayout seo={{ title: pageSeo.entreprises.title, description: pageSeo.entreprises.description }} noBreadcrumbs>
  <section class="enterprise-hero" data-motion-section data-motion-hold="2600" aria-labelledby="enterprise-title">
    <div class="hero-shape hero-shape--gold" aria-hidden="true"></div>
    <div class="hero-shape hero-shape--navy" aria-hidden="true"></div>
    <div class="hero-grid-lines" aria-hidden="true"></div>

    <div class="enterprise-shell enterprise-hero-grid">
      <div class="enterprise-hero-copy">
        <p data-motion-item="left" style="--motion-order:0">Entreprises</p>
        <h1 id="enterprise-title" data-motion-item="left" style="--motion-order:1">
          Un besoin IT précis<br /><span>mérite mieux qu’un CV bien tourné.</span>
        </h1>
        <strong data-motion-item="left" style="--motion-order:2">
          Nous cadrons le contexte, comparons les compétences sur une même grille et proposons
          le mode d’intervention adapté. Pas une pile de CV.
        </strong>
        <a data-motion-item="pop" style="--motion-order:3" href="/contact">
          Décrire mon besoin <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="enterprise-portrait-scene" data-enterprise-scene aria-label="Les cinq points de cadrage d’un besoin IT">
        <div class="portrait-halo" aria-hidden="true"></div>
        <div class="portrait-orbit" aria-hidden="true"></div>

        <figure class="enterprise-portrait" data-motion-item="pop" style="--motion-order:2">
          <Image
            src={ambreGuide}
            alt="Ambre Lambert, directrice commerciale IT chez The Porters"
            widths={[480, 640, 800, 1024]}
            sizes="(max-width: 760px) 78vw, (max-width: 1100px) 35rem, 32rem"
            format="webp"
            quality={94}
            loading="eager"
          />
        </figure>

        <div class="hero-badge" data-motion-item="pop" style="--motion-order:7">
          <span aria-hidden="true"><SiteIcon name="check" /></span>
          <div><small>À l’arrivée</small><strong>Un profil qualifié</strong></div>
        </div>

        <div class="scope-cloud" role="list">
          {scoping.map((item, index) => (
            <div
              class={`scope-anchor scope-anchor--${index + 1}`}
              role="listitem"
              style={`--orbit-delay:${index * -5.6}s`}
              data-scope-anchor
            >
              <div class="scope-card">
                <div><strong>{item.label}</strong><small>{item.detail}</small></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="enterprise-tape" aria-hidden="true">
      <div>
        <span>Cadrer</span><i></i><span>Comparer</span><i></i><span>Évaluer</span><i></i><span>Qualifier</span><i></i>
        <span>Cadrer</span><i></i><span>Comparer</span><i></i><span>Évaluer</span><i></i><span>Qualifier</span><i></i>
      </div>
    </div>
  </section>

  <section class="enterprise-process brand-ambient-host" id="processus" data-motion-section>
    <BrandAmbientShapes placement="left" />
    <div class="enterprise-shell process-layout">
      <header class="enterprise-heading process-heading">
        <p data-motion-item="left" style="--motion-order:0">Notre processus de sélection</p>
        <h2 data-motion-item="left" style="--motion-order:1">Cinq étapes, et <span class="gold-underline">la même grille pour tous</span>.</h2>
        <strong data-motion-item="left" style="--motion-order:2">
          Le détail apparaît au bon moment pendant votre lecture, sans afficher cinq blocs de texte en parallèle.
        </strong>
        <figure class="process-visual" data-motion-item="pop" style="--motion-order:3" data-process-visual>
          <Image src={tripartiteClient} alt="Équipe réunie pour cadrer un besoin numérique" widths={[420, 640, 820]} sizes="(max-width:820px) 88vw, 31vw" format="webp" quality={88} />
          <figcaption><span>Un cadre commun</span><strong>Un besoin se précise toujours en parlant aux gens qui le portent.</strong></figcaption>
        </figure>
      </header>

      <ol class="process-steps" data-process-steps>
        {enterprisePage.selection.map((item, index) => (
          <li
            class:list={['process-step', { 'process-step--right': index % 2 !== 0 }]}
            data-motion-item={index % 2 === 0 ? 'right' : 'left'}
            style={`--motion-order:${index + 2}`}
            data-enterprise-tilt
            data-process-step
            tabindex="0"
          >
            <div class="process-step-inner">
              <div>
                <small>{index === 0 ? 'Point de départ' : index === enterprisePage.selection.length - 1 ? 'Sortie' : 'Vérification'}</small>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
              <b aria-hidden="true">↘</b>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="enterprise-perimeters" data-motion-section>
    <div class="perimeter-word" aria-hidden="true">IT</div>
    <div class="enterprise-shell">
      <header class="enterprise-heading enterprise-heading--compact">
        <p data-motion-item="left" style="--motion-order:0">Ce que nous couvrons</p>
        <h2 data-motion-item="left" style="--motion-order:1">Du socle historique <span>à l’IA.</span></h2>
        <strong data-motion-item="right" style="--motion-order:2">Un même niveau d’exigence, quel que soit le terrain technique.</strong>
      </header>

      <div class="perimeter-visuals" data-motion-item="wipe" style="--motion-order:3" data-perimeter-visuals data-cms-ignore aria-hidden="true">
        <figure class="perimeter-visual perimeter-visual--one" data-perimeter-visual>
          <Image src={tripartiteConsultant} alt="" widths={[360, 560, 760]} sizes="(max-width:760px) 78vw, 28vw" format="webp" quality={86} />
          <figcaption>Comprendre l’existant</figcaption>
        </figure>
        <figure class="perimeter-visual perimeter-visual--two" data-perimeter-visual>
          <Image src={qualifiedMatch} alt="" widths={[420, 680, 900]} sizes="(max-width:760px) 84vw, 36vw" format="webp" quality={88} />
          <figcaption>Activer la bonne expertise</figcaption>
        </figure>
        <figure class="perimeter-visual perimeter-visual--three" data-perimeter-visual>
          <Image src={tripartiteClient} alt="" widths={[360, 560, 760]} sizes="(max-width:760px) 78vw, 28vw" format="webp" quality={86} />
          <figcaption>Livrer dans le contexte réel</figcaption>
        </figure>
      </div>

      <div class="perimeter-grid" data-perimeter-grid>
        {enterprisePage.useCases.map((useCase, index) => (
          <a
            class={`perimeter-card perimeter-card--${index + 1}`}
            href={useCase.href}
            aria-label={`${useCase.title} — voir le domaine en détail`}
            data-motion-item={index % 2 === 0 ? 'left' : 'right'}
            style={`--motion-order:${index + 2}`}
            data-enterprise-tilt
            data-perimeter-card
          >
            <div class="perimeter-card-inner">
              <h3>{useCase.title}</h3>
              <p>{useCase.text}</p>
              <b aria-hidden="true">↗</b>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="enterprise-projects brand-ambient-host" data-motion-section>
    <BrandAmbientShapes placement="right" />
    <div class="enterprise-shell">
      <header class="enterprise-heading project-heading">
        <div>
          <p data-motion-item="left" style="--motion-order:0">Ce que nous avons déjà fait</p>
          <h2 data-motion-item="left" style="--motion-order:1">Trois missions, racontées <span class="gold-underline">sans les enjoliver</span>.</h2>
        </div>
        <strong data-motion-item="right" style="--motion-order:2">Changez de projet pour voir ce que chacune a réellement demandé.</strong>
      </header>

      <div class="project-lab" data-project-lab data-motion-item="wipe" style="--motion-order:3">
        <div class="project-tabs" role="tablist" aria-label="Exemples de projets">
          {projects.map((project, index) => (
            <button
              type="button"
              role="tab"
              id={`project-tab-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`project-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
              class:list={['project-tab', { 'is-active': index === 0 }]}
              data-project-tab
            >
              <strong>{project.title}</strong>
            </button>
          ))}
        </div>

        <div class="project-panels">
          {projects.map((project, index) => (
            <article
              id={`project-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`project-tab-${index}`}
              class="project-panel"
              hidden={index !== 0}
              data-project-panel
            >
              <Image class="project-panel-image" src={project.image} alt="" widths={[520, 760, 1040]} sizes="(max-width:820px) 100vw, 50vw" format="webp" quality={86} />
              <div class="project-panel-copy">
                <p>{project.context}</p>
                <h3>{project.title}</h3>
                <strong>{project.text}</strong>
                <div>{project.profiles.map((profile) => <span>{profile}</span>)}</div>
              </div>
              <div class="project-radar" aria-hidden="true"><i></i><i></i><i></i></div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="enterprise-choice" data-motion-section>
    <div class="choice-orbit" aria-hidden="true"></div>
    <div class="enterprise-shell">
      <header class="enterprise-heading enterprise-heading--center">
        <p data-motion-item="pop" style="--motion-order:0">Le bon cadre</p>
        <h2 data-motion-item="pop" style="--motion-order:1">Deux façons de travailler avec nous.</h2>
      </header>

      <div class="choice-question" data-motion-item="pop" style="--motion-order:2">
        <small>Une seule question</small>
        <strong>Le consultant est-il déjà identifié&nbsp;?</strong>
      </div>

      <div class="choice-models">
        {models.map((model, index) => (
          <article
            class:list={['choice-model', { 'choice-model--dark': index === 1 }]}
            data-motion-item={index === 0 ? 'left' : 'right'}
            style={`--motion-order:${index + 3}`}
            data-enterprise-tilt
          >
            <div class="choice-model-top">
              {index === 0 ? (
                <span class="brand-wordmark porters-choice-logo" aria-label="The Porters">
                  <span class="brand-wordmark-the">The</span>
                  <span class="brand-wordmark-porters">Porters</span>
                </span>
              ) : (
                <Image class="big-porters-choice-logo" src={bigPortersLogo} alt="The Big Porters — une ESN de talents" widths={[150, 220, 320]} sizes="10rem" format="webp" quality={92} />
              )}
              <div class="icon-chip"><SiteIcon name={model.icon} /></div>
            </div>
            <p>{model.label}</p>
            <h3>{model.title}</h3>
            <strong>{model.text}</strong>
            <a href={index === 0 ? '/portage-salarial' : '/contact'}>
              Découvrir <b aria-hidden="true">↗</b>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="enterprise-cta" data-motion-section>
    <div class="cta-ring cta-ring--one" aria-hidden="true"></div>
    <div class="cta-ring cta-ring--two" aria-hidden="true"></div>
    <div class="enterprise-shell">
      <div>
        <p data-motion-item="left" style="--motion-order:0">Votre besoin</p>
        <h2 data-motion-item="left" style="--motion-order:1">Racontez-nous le contexte.<br /><span>Nous nous occupons du reste.</span></h2>
        <strong data-motion-item="left" style="--motion-order:2">Technologies, organisation, délai, autonomie et sécurité&nbsp;: cinq informations suffisent pour commencer.</strong>
      </div>
      <a data-motion-item="pop" style="--motion-order:3" href="/contact">Je confie mon besoin <span aria-hidden="true">→</span></a>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-lab]').forEach((lab) => {
    const tabs = Array.from(lab.querySelectorAll<HTMLButtonElement>('[data-project-tab]'));
    const panels = Array.from(lab.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let timer = 0;
    let paused = false;
    let inView = !('IntersectionObserver' in window);

    const select = (nextIndex: number, focus = false) => {
      const index = (nextIndex + tabs.length) % tabs.length;
      activeIndex = index;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
        panel.classList.remove('is-entering');
        if (panelIndex === index) requestAnimationFrame(() => panel.classList.add('is-entering'));
      });
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || paused || !inView || tabs.length < 2) return;
      timer = window.setTimeout(() => {
        select(activeIndex + 1);
        schedule();
      }, 2700);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        select(index);
        schedule();
      });
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : index + (event.key === 'ArrowRight' ? 1 : -1);
        select(next, true);
      });
    });

    lab.addEventListener('pointerenter', () => { paused = true; schedule(); });
    lab.addEventListener('pointerleave', () => { paused = false; schedule(); });
    lab.addEventListener('focusin', () => { paused = true; schedule(); });
    lab.addEventListener('focusout', () => requestAnimationFrame(() => {
      paused = lab.contains(document.activeElement);
      schedule();
    }));

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = Boolean(entry?.isIntersecting);
        schedule();
      }, { threshold: .28 });
      observer.observe(lab);
    } else {
      schedule();
    }
  });

  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-enterprise-scene]').forEach((scene) => {
    const anchors = Array.from(scene.querySelectorAll<HTMLElement>('[data-scope-anchor]'));
    let activeIndex = 0;
    let timer = 0;
    let inView = !('IntersectionObserver' in window);
    let paused = false;

    const activate = (nextIndex: number) => {
      activeIndex = (nextIndex + anchors.length) % anchors.length;
      anchors.forEach((anchor, index) => anchor.classList.toggle('is-active', index === activeIndex));
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || paused || !inView || anchors.length < 2) return;
      timer = window.setTimeout(() => {
        activate(activeIndex + 1);
        schedule();
      }, 1450);
    };

    anchors.forEach((anchor, index) => {
      anchor.addEventListener('pointerenter', () => { paused = true; activate(index); schedule(); });
      anchor.addEventListener('pointerleave', () => { paused = false; schedule(); });
      anchor.addEventListener('focusin', () => { paused = true; activate(index); schedule(); });
      anchor.addEventListener('focusout', () => { paused = false; schedule(); });
    });
    activate(0);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = Boolean(entry?.isIntersecting);
        schedule();
      }, { threshold: .3 });
      observer.observe(scene);
    } else {
      schedule();
    }
  });

  document.querySelectorAll<HTMLElement>('[data-process-steps]').forEach((track) => {
    const steps = Array.from(track.querySelectorAll<HTMLElement>('[data-process-step]'));
    const visual = track.closest<HTMLElement>('.process-layout')?.querySelector<HTMLElement>('[data-process-visual]');
    let activeIndex = 0;
    let timer = 0;
    let inView = !('IntersectionObserver' in window);
    let paused = false;
    const activate = (nextIndex: number) => {
      activeIndex = (nextIndex + steps.length) % steps.length;
      steps.forEach((step, index) => {
        step.classList.toggle('is-active', index === activeIndex);
        step.classList.toggle('is-passed', index < activeIndex);
      });
      track.style.setProperty('--process-progress', String((activeIndex + 1) / Math.max(steps.length, 1)));
      visual?.classList.add('is-process-active');
      window.setTimeout(() => visual?.classList.remove('is-process-active'), 620);
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || paused || !inView || steps.length < 2) return;
      timer = window.setTimeout(() => {
        activeIndex = (activeIndex + 1) % steps.length;
        activate(activeIndex);
        schedule();
      }, 1900);
    };

    steps.forEach((step, index) => {
      step.addEventListener('pointerenter', () => {
        paused = true;
        activeIndex = index;
        activate(index);
      });
      step.addEventListener('pointerleave', () => {
        paused = false;
        schedule();
      });
      step.addEventListener('focus', () => {
        paused = true;
        activeIndex = index;
        activate(index);
      });
      step.addEventListener('blur', () => {
        paused = false;
        schedule();
      });
    });

    if (!('IntersectionObserver' in window)) {
      activate(0);
      schedule();
      return;
    }

    const observer = new IntersectionObserver(([entry]) => {
      inView = Boolean(entry?.isIntersecting);
      if (inView) activate(activeIndex);
      schedule();
    }, { threshold: .2 });
    observer.observe(track);
  });

  document.querySelectorAll<HTMLElement>('[data-perimeter-grid]').forEach((grid) => {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-perimeter-card]'));
    const visuals = Array.from(grid.closest<HTMLElement>('.enterprise-perimeters')?.querySelectorAll<HTMLElement>('[data-perimeter-visual]') || []);
    let activeIndex = 0;
    let timer = 0;
    let paused = false;
    let inView = !('IntersectionObserver' in window);

    const show = (index: number) => {
      activeIndex = (index + cards.length) % cards.length;
      cards.forEach((card, cardIndex) => card.classList.toggle('is-live', cardIndex === activeIndex));
      if (visuals.length) {
        visuals.forEach((visual, visualIndex) => visual.classList.toggle('is-live', visualIndex === activeIndex % visuals.length));
      }
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || paused || !inView || cards.length < 2) return;
      timer = window.setTimeout(() => {
        show(activeIndex + 1);
        schedule();
      }, 2100);
    };

    cards.forEach((card, index) => {
      card.addEventListener('pointerenter', () => {
        paused = true;
        show(index);
        schedule();
      });
      card.addEventListener('pointerleave', () => {
        paused = false;
        schedule();
      });
      card.addEventListener('focus', () => {
        paused = true;
        show(index);
        schedule();
      });
      card.addEventListener('blur', () => {
        paused = false;
        schedule();
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = Boolean(entry?.isIntersecting);
        if (inView) show(activeIndex);
        else cards.forEach((card) => card.classList.remove('is-live'));
        schedule();
      }, { threshold: .3 });
      observer.observe(grid);
    } else {
      show(0);
      schedule();
    }
  });

  if (finePointer && !reducedMotion) {
    document.querySelectorAll<HTMLElement>('[data-enterprise-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width - 0.5;
        const y = (event.clientY - box.top) / box.height - 0.5;
        card.style.setProperty('--tilt-x', `${x * 2.6}deg`);
        card.style.setProperty('--tilt-y', `${y * -2.6}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
      });
    });

    document.querySelectorAll<HTMLElement>('[data-enterprise-scene]').forEach((scene) => {
      scene.addEventListener('pointermove', (event) => {
        const box = scene.getBoundingClientRect();
        scene.style.setProperty('--scene-x', `${((event.clientX - box.left) / box.width - 0.5) * 12}px`);
        scene.style.setProperty('--scene-y', `${((event.clientY - box.top) / box.height - 0.5) * 9}px`);
      });
      scene.addEventListener('pointerleave', () => {
        scene.style.setProperty('--scene-x', '0px');
        scene.style.setProperty('--scene-y', '0px');
      });
    });
  }
</script>

<style>
  .enterprise-shell{width:min(100% - 3rem,86rem);margin-inline:auto}
  .enterprise-hero-copy>p,.enterprise-heading>p,.enterprise-cta p{margin:0 0 1rem;color:#aa8130;font-size:.7rem;font-weight:780;letter-spacing:.17em;text-transform:uppercase}
  .enterprise-heading{position:relative;z-index:2;max-width:54rem;margin-bottom:3.5rem}
