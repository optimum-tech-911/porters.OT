---
import PageLayout from '../layouts/PageLayout.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import { pageSeo } from '../data/seo.data';
import enterpriseHeroImage from '../../images/team-workshop.webp';
import collaborationImage from '../../images/business-meeting.webp';
import { enterprisePage } from '../content/pages/entreprises';

const seo = {
  title: pageSeo.entreprises.title,
  description: pageSeo.entreprises.description,
};

const breadcrumbs = [{ label: 'Entreprises' }];

// Ce que nous cadrons avant de proposer un seul CV. Copie : copy-bank.md CB-03.
// Fait : F-D02 (PUBLISHABLE).
const scoping = [
  { icon: 'network', title: 'Environnement technique', description: 'Les socles en place, leur âge, leurs contraintes, et ce qui ne peut pas être arrêté.' },
  { icon: 'users', title: 'Organisation en place', description: 'Qui décide, qui valide, avec quelles équipes le consultant travaillera au quotidien.' },
  { icon: 'compass', title: 'Calendrier', description: 'La date de démarrage réelle, la durée, et ce qui dépend d’un jalon que vous ne maîtrisez pas.' },
  { icon: 'scale', title: 'Niveau d’autonomie attendu', description: 'Un renfort qui exécute et un expert qui arbitre ne sont pas le même profil, ni le même TJM.' },
  { icon: 'shield', title: 'Contraintes de sécurité', description: 'Habilitations, charte de sécurité, confidentialité, lieux d’exécution autorisés.' },
] as const;

// Ce qui rend le sourcing crédible. Faits : F-V02, F-D01, F-D03, F-D07 (PUBLISHABLE).
// BoondManager n'est pas nommé : F-D17 est CLIENT_APPROVAL_REQUIRED (Q16).
const sourcing = [
  {
    title: 'Un sourcing multi-canal, pas une seule jobboard',
    description:
      'Cooptation, événements IT, LesJeudis, HelloWork, Meteojob, LinkedIn, Indeed, Monster, France Travail. Le vivier est organisé autour d’une cartographie métiers, pas d’une pile de CV.',
  },
  {
    title: 'Des référentiels métiers, pas une impression',
    description:
      'CIGREF, SYNTEC et ROME donnent la grille de lecture : compétences attendues, niveaux d’expertise, pratiques professionnelles, expérience sectorielle.',
  },
  {
    title: 'Des profils transmis anonymisés',
    description:
      'Vous recevez le parcours, les compétences et la disponibilité. L’identité vient après votre intérêt, dans le respect des règles de protection des données personnelles.',
  },
  {
    title: 'Aucun suivi qui dépende d’une seule personne',
    description:
      'Chaque mission est suivie par un binôme, avec un relais identifié. Si votre interlocuteur est absent, votre dossier ne s’arrête pas.',
  },
];

// Types de projets — formulations publiables, source confidentielle.
// Copie : copy-bank.md CB-13, verbatim. Faits : F-P01, F-P02, F-P03 (PUBLISHABLE).
// Jamais de nom de client, de numéro de lot, de référence CCTP ni de GIE.
const projects = [
  {
    title: 'Migration d’un socle Big Data',
    text: 'Passage de Hortonworks à Cloudera Data Platform pour un organisme public national.',
    profiles: 'Architecte système, expert Big Data, développeur senior.',
  },
  {
    title: 'Développements en environnement IBM i / AS400',
    text: 'Applications métier cœur du logement social : analyse des besoins, développements spécifiques, maintenance corrective et évolutive.',
    profiles: 'Analyste programmeur, chef de projet applicatif.',
  },
  {
    title: 'Reprise en main de modèles de données',
    text: 'Audit de l’existant, recommandations d’outils, mise en place d’applicatifs internes chez un industriel.',
    profiles: 'Architecte données, data scientist, développeur fullstack.',
  },
];

const engagementModels = [
  {
    eyebrow: 'Portage salarial',
    title: 'Le consultant a déjà sa mission',
    description:
      'The Porters met en place le cadre contractuel, salarial et administratif. Vous gardez une relation opérationnelle simple, avec une facture unique.',
    points: ['Cadre salarial sécurisé', 'Contrat, paie et facturation pris en charge', 'Interlocuteur unique pendant la mission'],
  },
  {
    eyebrow: 'Prestation via l’ESN du groupe',
    title: 'Vous cherchez encore le bon profil',
    description:
      'The Big Porters, l’ESN du groupe, prend le sourcing et le pilotage du renfort. Même vivier, même processus de sélection, cadre contractuel différent.',
    points: ['Sourcing IT ciblé', 'Choix du modèle selon le besoin', 'Suivi opérationnel cadré'],
  },
];
---

<PageLayout seo={seo} breadcrumbs={breadcrumbs}>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-porters-navy text-porters-white">
    <div class="absolute inset-0">
      <img
        src={enterpriseHeroImage.src}
        width={enterpriseHeroImage.width}
        height={enterpriseHeroImage.height}
        alt=""
        class="h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(25,43,99,0.96)_0%,rgba(25,43,99,0.85)_46%,rgba(25,43,99,0.42)_76%,rgba(25,43,99,0.1)_100%)]"></div>
    </div>
    <div class="container relative mx-auto px-6 py-20 lg:px-8 lg:py-28">
      <div class="max-w-2xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Entreprises</p>
        <h1 class="mb-6 max-w-[40rem] text-porters-white">
          Décrivez le contexte. <span class="gold-underline">Nous revenons avec des profils.</span>
        </h1>
        <p class="mb-8 max-w-xl text-lg leading-relaxed text-porters-white/84">
          Un besoin précis à couvrir ou une équipe projet à structurer&nbsp;? Nous cadrons cinq points, puis
          nous sélectionnons en cinq étapes. Pas de plaquette.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href="/contact" class="btn btn-gold">Déposer un besoin</a>
          <a href="/rendez-vous" class="btn btn-white">Parler à l’équipe</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Scoping: the five points fixed before a single CV -->
  <section class="section">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 grid gap-8 lg:grid-cols-[minmax(0,0.78fr)_minmax(18rem,0.42fr)] lg:items-end">
        <div class="reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Avant le premier CV</p>
          <h2>Cinq points cadrés <span class="gold-underline">avant toute proposition</span></h2>
          <p class="mt-4 max-w-2xl" style="color: rgba(11, 16, 32, 0.7);">
            Un profil ne se qualifie pas contre une fiche de poste, mais contre un contexte. Ces cinq points
            sont fixés au cadrage, par écrit.
          </p>
        </div>
        <div class="reveal overflow-hidden rounded-lg border border-porters-navy/10 bg-white shadow-sm">
          <img
            src={collaborationImage.src}
            width={collaborationImage.width}
            height={collaborationImage.height}
            alt="Réunion de cadrage entre une équipe cliente et un consultant."
            class="h-48 w-full object-cover"
          />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {scoping.map((point) => (
          <div class="card reveal">
            <div class="icon-chip mb-5">
              <SiteIcon name={point.icon} />
            </div>
            <h3 class="text-lg font-heading font-semibold mb-2">{point.title}</h3>
            <p class="text-sm mb-0" style="color: rgba(11, 16, 32, 0.7);">{point.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The five-step selection process: the corpus's strongest credibility asset -->
  <section class="section" style="background-color: rgba(25, 43, 99, 0.03);">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Notre processus de sélection</p>
        <h2>Cinq étapes, <span class="gold-underline">les mêmes pour tous les profils</span></h2>
        <p class="mt-4" style="color: rgba(11, 16, 32, 0.7);">
          Structuré, homogène, traçable. C’est ce qui permet de comparer deux candidats sur la même grille
          plutôt que sur une impression d’entretien.
        </p>
      </div>
      <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {enterprisePage.selection.map((item) => (
          <li class="border-t-2 border-porters-gold bg-white p-6 shadow-sm reveal">
            <span class="font-mono text-sm font-semibold text-porters-gold">{item.step}</span>
            <h3 class="mt-5 text-lg">{item.title}</h3>
            <p class="mb-0 mt-3 text-sm leading-relaxed text-porters-black/64">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Sourcing and traceability -->
  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Sourcing et traçabilité</p>
        <h2>D’où viennent les profils, et comment ils vous arrivent</h2>
      </div>
      <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
        {sourcing.map((item) => (
          <article class="border-t border-porters-navy/12 pt-6 reveal">
            <h3 class="mb-3 text-lg">{item.title}</h3>
            <p class="mb-0 text-porters-black/66">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Périmètres couverts</p>
        <h2>Les besoins sur lesquels nous intervenons</h2>
        <p class="mt-4 text-porters-black/65">Technique, fonctionnel ou organisationnel. Le point commun&nbsp;: une mission définie et des responsabilités lisibles.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {enterprisePage.useCases.map((useCase) => (
          <article class="card reveal p-6">
            <h3 class="text-lg">{useCase.title}</h3>
            <p class="mb-0 mt-3 text-sm leading-relaxed text-porters-black/64">{useCase.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Anonymised project types -->
  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Types de missions</p>
        <h2>À quoi ressemblent les missions, concrètement</h2>
        <p class="mt-4 text-porters-black/65">
          Trois exemples réels, décrits par leur contexte technique et les profils mobilisés. Les noms de
          clients ne sont pas publiés.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="border-l-[3px] border-porters-gold bg-porters-navy/[0.03] p-7 reveal">
            <h3 class="mb-3 text-lg">{project.title}</h3>
            <p class="mb-4 text-sm leading-relaxed text-porters-black/68">{project.text}</p>
            <p class="mb-0 text-xs font-semibold uppercase tracking-[0.1em] text-porters-navy/60">Profils mobilisés</p>
            <p class="mb-0 mt-1 text-sm text-porters-black/64">{project.profiles}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Engagement model choice -->
  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Deux cadres contractuels</p>
        <h2>Deux modèles. <span class="gold-underline">Un choix à faire dès le départ.</span></h2>
        <p class="mt-4 text-porters-black/65">
          Le point de départ n’est pas le statut, mais votre besoin&nbsp;: sécuriser un consultant déjà
          identifié, ou trouver une expertise à mobiliser.
        </p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {engagementModels.map((model) => (
          <article class="card reveal p-7 lg:p-9">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-porters-gold">{model.eyebrow}</p>
            <h3 class="mb-3 font-heading text-xl font-semibold text-porters-navy">{model.title}</h3>
            <p class="mb-6 text-sm leading-relaxed text-porters-black/65">{model.description}</p>
            <ul class="space-y-3">
              {model.points.map((point) => (
                <li class="flex items-start gap-3 text-sm text-porters-black/70">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-porters-gold"></span>
                  {point}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work: the four beats -->
  <section class="section">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2>Du besoin à la mission, <span class="gold-underline">sans zone grise</span></h2>
        <p class="mt-4 max-w-2xl mx-auto" style="color: rgba(11, 16, 32, 0.7);">
          Quatre temps, et à chacun ce que nous prenons en charge.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        {enterprisePage.process.map((step) => (
          <div class="text-center reveal">
            <div class="text-5xl font-heading font-bold text-porters-gold mb-4">{step.number}</div>
            <h3 class="text-lg font-heading font-semibold mb-3">{step.title}</h3>
            <p class="text-sm" style="color: rgba(11, 16, 32, 0.7);">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA band — copy-bank CB-09 -->
  <section class="section bg-porters-navy text-porters-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-porters-white mb-4">
          Un besoin précis à couvrir&nbsp;? <span class="gold-underline">Décrivez le contexte.</span>
        </h2>
        <p class="text-lg mb-8" style="color: rgba(250, 248, 243, 0.8);">
          Nous revenons vers vous avec des profils, pas avec une plaquette.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn btn-gold">Déposer un besoin</a>
          <a href="/rendez-vous" class="btn btn-white">Parler à l’équipe</a>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
