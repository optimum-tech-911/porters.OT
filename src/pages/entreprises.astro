---
import PageLayout from '../layouts/PageLayout.astro';
import { pageSeo } from '../data/seo.data';
import enterpriseHeroImage from '../../images/team-workshop.webp';
import { enterprisePage } from '../content/pages/entreprises';

const scoping = [
  'Environnement technique',
  'Organisation en place',
  'Calendrier réel',
  'Niveau d’autonomie',
  'Contraintes de sécurité',
];

const projects = [
  {
    title: 'Migration d’un socle Big Data',
    text: 'Passage de Hortonworks à Cloudera Data Platform pour un organisme public national.',
    profiles: 'Architecture système · Big Data · Développement senior',
  },
  {
    title: 'Applications critiques IBM i / AS400',
    text: 'Analyse, développement spécifique et maintenance d’applications métier historiques.',
    profiles: 'Analyse-programmation · Pilotage applicatif',
  },
  {
    title: 'Reprise de modèles de données',
    text: 'Audit de l’existant, recommandations d’outils et mise en place d’applicatifs internes.',
    profiles: 'Architecture data · Data science · Fullstack',
  },
];

const models = [
  {
    label: 'Portage salarial',
    title: 'Vous avez déjà identifié le consultant',
    text: 'The Porters met en place le contrat de prestation et porte le cadre salarial, la facturation et la paie.',
  },
  {
    label: 'ESN du groupe',
    title: 'Vous cherchez encore le bon profil',
    text: 'The Big Porters cadre le besoin, source et évalue les profils, puis suit la mission.',
  },
];
---

<PageLayout
  seo={{ title: pageSeo.entreprises.title, description: pageSeo.entreprises.description }}
  breadcrumbs={[{ label: 'Entreprises' }]}
>
  <section class="relative overflow-hidden bg-porters-navy text-porters-white">
    <img
      src={enterpriseHeroImage.src}
      width={enterpriseHeroImage.width}
      height={enterpriseHeroImage.height}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(25,43,99,0.97)_0%,rgba(25,43,99,0.86)_48%,rgba(25,43,99,0.3)_100%)]"></div>
    <div class="container relative mx-auto px-6 py-24 lg:px-8 lg:py-32">
      <div class="max-w-2xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Entreprises</p>
        <h1 class="text-porters-white">Un besoin IT précis. Des profils évalués sur le réel.</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-porters-white/80">
          Nous cadrons le contexte, évaluons les compétences et proposons le bon mode d’intervention.
          Vous recevez des profils qualifiés, pas une pile de CV.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn btn-gold">Décrire mon besoin</a>
          <a href="/expertises" class="btn btn-white">Voir les expertises</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.68fr)_minmax(18rem,0.52fr)] lg:items-end">
        <div class="reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Avant le premier profil</p>
          <h2>Le contexte d’abord. Le CV ensuite.</h2>
          <p class="mt-5 max-w-2xl text-porters-black/66">
            Une compétence ne se juge pas hors sol. Nous cadrons cinq points avant de lancer la recherche.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 reveal">
          {scoping.map((item, index) => (
            <li class="flex items-center gap-3 border-b border-porters-navy/10 py-3 text-sm font-semibold text-porters-navy">
              <span class="font-mono text-xs text-porters-gold">0{index + 1}</span>{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Sélection</p>
        <h2>Cinq étapes, une grille commune</h2>
        <p class="mt-4 text-porters-black/65">
          Parcours réel, référentiels CIGREF, SYNTEC et ROME, entretiens structurés, mise en situation
          si nécessaire, puis validation finale.
        </p>
      </div>
      <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-5">
        {enterprisePage.selection.map((item) => (
          <li class="border-t-2 border-porters-gold bg-white p-5 shadow-sm reveal">
            <span class="font-mono text-xs font-semibold text-porters-gold">{item.step}</span>
            <h3 class="mt-4 text-lg">{item.title}</h3>
            <p class="mb-0 mt-3 text-sm leading-relaxed text-porters-black/62">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Expérience mobilisable</p>
        <h2>Des projets décrits par les faits</h2>
        <p class="mt-4 text-porters-black/65">Trois contextes techniques réels, présentés sans exposer le nom des clients.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="border-l-[3px] border-porters-gold bg-porters-navy/[0.03] p-7 reveal">
            <h3 class="text-lg">{project.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-porters-black/66">{project.text}</p>
            <p class="mb-0 mt-5 text-xs font-semibold uppercase tracking-[0.1em] text-porters-navy/55">{project.profiles}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-3xl text-center reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Deux cadres</p>
        <h2>Le modèle dépend de votre point de départ</h2>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {models.map((model) => (
          <article class="card reveal p-7 lg:p-9">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-porters-gold">{model.label}</p>
            <h3 class="text-xl">{model.title}</h3>
            <p class="mb-0 mt-4 text-sm leading-relaxed text-porters-black/65">{model.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-porters-navy py-16 text-porters-white">
    <div class="container mx-auto flex flex-col gap-7 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div class="max-w-2xl reveal">
        <h2 class="mb-2 text-porters-white">Décrivez le contexte. Nous cadrons la suite.</h2>
        <p class="mb-0 text-porters-white/65">Technologies, organisation, délai, autonomie et sécurité&nbsp;: cinq informations suffisent pour commencer.</p>
      </div>
      <a href="/contact" class="btn btn-gold shrink-0">Décrire mon besoin</a>
    </div>
  </section>
</PageLayout>
