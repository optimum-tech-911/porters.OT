---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/forms/ContactForm';
import { pageSeo } from '../data/seo.data';
import { cmsAttrs, cmsText } from '../cms/content';

const seo = {
  title: pageSeo.rendezVous.title,
  description: pageSeo.rendezVous.description,
};

const breadcrumbs = [{ label: 'Parler à un conseiller' }];

const meetingTypes = [
  {
    value: 'Comprendre le portage salarial',
    title: 'Comprendre le portage salarial',
    duration: '30 min',
    description: 'Le cadre, les deux contrats, la protection sociale et ce qui change concrètement pour vous.',
  },
  {
    value: 'Relire ma simulation',
    title: 'Relire ma simulation',
    duration: '45 min',
    description: 'Votre TJM, vos jours facturés, vos frais réels et ce que cela donne en net.',
  },
  {
    value: 'Passer de freelance à portage',
    title: 'Passer de freelance à portage',
    duration: '45 min',
    description: 'Ce que vous gagnez et ce que vous perdez en passant de micro-entreprise ou de SASU au portage.',
  },
  {
    value: 'Discuter de ma mission IT',
    title: 'Discuter de ma mission IT',
    duration: '45 min',
    description: 'Une mission cyber, data, IA, cloud, DevOps, produit ou agilité déjà identifiée à cadrer.',
  },
  {
    value: 'Parler à quelqu’un près de moi',
    title: 'Parler à quelqu’un près de moi',
    duration: '30 min',
    description: 'Un échange sur place ou à distance, selon votre localisation et votre rythme de mission.',
  },
];

const reasons = [
  {
    icon: '30 min',
    title: 'Un échange préparé',
    description: 'Nous arrivons avec votre simulation relue et les points à trancher, pas avec une présentation générique.',
  },
  {
    icon: 'Suivi',
    title: 'Un conseiller dédié',
    description: 'La personne que vous avez au téléphone est celle qui suivra votre dossier ensuite.',
  },
  {
    icon: 'Concret',
    title: 'Des prochaines étapes datées',
    description: 'À la fin de l’échange, vous savez quoi faire, quand, et ce que nous faisons de notre côté.',
  },
];
---

<PageLayout seo={seo} breadcrumbs={breadcrumbs}>

  <!-- Hero -->
  <section class="section bg-porters-navy text-porters-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-porters-white text-[1.85rem] leading-[1.06] sm:text-[3rem] mb-6 max-w-[16rem] sm:max-w-3xl mx-auto">
          Dites-nous où vous en êtes. <span class="gold-underline">Nous arrivons préparés.</span>
        </h1>
        <p class="text-base sm:text-lg max-w-[18rem] sm:max-w-2xl mx-auto" style="color: rgba(250, 248, 243, 0.85);">
          Choisissez le sujet, indiquez vos disponibilités. Un conseiller vous confirme le créneau et arrive avec vos chiffres, pas avec une plaquette.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] gap-8 lg:gap-12 max-w-6xl mx-auto">
        <div class="reveal">
          <div class="card p-5 sm:p-8 lg:p-10">
            <div class="mb-8">
              <p class="text-sm font-semibold uppercase tracking-wider text-porters-gold mb-3">Demande de rendez-vous</p>
              <h2 class="text-xl sm:text-2xl font-heading font-semibold text-porters-navy mb-3">
                De quoi avez-vous besoin maintenant ?
              </h2>
              <p class="text-porters-black/65 mb-0">
                Un sujet, vos coordonnées, vos disponibilités. C’est tout ce dont nous avons besoin pour préparer un échange utile.
              </p>
            </div>
            <!--
              This island hydrates after CMS discovery has run, so anything it
              renders would show up as a runtime-only key and break the
              build/runtime parity check. Its copy is editable through the
              explicit keys passed below instead.
            -->
            <div data-cms-ignore>
            <ContactForm
              client:visible
              appointmentTopics={meetingTypes.map((type, index) => ({
                value: type.value,
                title: cmsText(`rendezvous.topic.${index + 1}.title`),
                meta: cmsText(`rendezvous.topic.${index + 1}.duration`),
                metaCms: cmsAttrs(`rendezvous.topic.${index + 1}.duration`),
                description: cmsText(`rendezvous.topic.${index + 1}.description`),
                titleCms: cmsAttrs(`rendezvous.topic.${index + 1}.title`),
                descriptionCms: cmsAttrs(`rendezvous.topic.${index + 1}.description`),
              }))}
              requestAvailability
              labelCms={{
                name: cmsAttrs('contactform.label.name'),
                email: cmsAttrs('contactform.label.email'),
                phone: cmsAttrs('contactform.label.phone'),
                company: cmsAttrs('contactform.label.company'),
                availability: cmsAttrs('contactform.label.availability'),
                profile: cmsAttrs('contactform.label.profile'),
                message: cmsAttrs('contactform.label.message'),
                submit: cmsAttrs('contactform.label.submit'),
              }}
            />
            </div>
          </div>
        </div>

        <div class="space-y-6 reveal">
          <div class="card p-6 sm:p-7 bg-porters-navy text-porters-white border-porters-navy">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-porters-gold mb-3">
              Ce que vous obtenez
            </p>
            <ul class="space-y-4 text-sm text-porters-white/80">
              <li>Une lecture chiffrée de votre situation, pas un discours.</li>
              <li>Ce que votre TJM donne en net, avec vos vrais paramètres.</li>
              <li>Le même interlocuteur ensuite, qui connaît déjà votre dossier.</li>
            </ul>
          </div>

          <div class="card p-6 sm:p-7">
            <h3 class="text-lg font-heading font-semibold text-porters-navy mb-4">
              Besoin d'une réponse rapide ?
            </h3>
            <div class="space-y-4 text-porters-black/70">
              <div>
                <p class="text-sm font-medium text-porters-navy mb-1">Délai de réponse</p>
                <p class="mb-0">Vous choisissez vos disponibilités&nbsp;; nous confirmons le créneau et le nom de votre interlocuteur par email.</p>
              </div>
              <div>
                <p class="text-sm font-medium text-porters-navy mb-1">Par email</p>
                <a href="mailto:contact@porters.fr" class="hover:text-porters-gold transition-colors">contact@porters.fr</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 reasons -->
  <section class="section" style="background-color: rgba(25, 43, 99, 0.03);">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2>Un rendez-vous pour <span class="gold-underline">sortir avec des réponses</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {reasons.map((reason) => (
          <div class="text-center reveal">
            <div class="inline-flex items-center justify-center min-w-28 px-4 py-2 rounded-full bg-porters-gold/12 text-porters-navy font-heading font-semibold mb-4">
              {reason.icon}
            </div>
            <h3 class="text-lg font-heading font-semibold mb-2">{reason.title}</h3>
            <p class="text-sm" style="color: rgba(11, 16, 32, 0.7);">{reason.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</PageLayout>
