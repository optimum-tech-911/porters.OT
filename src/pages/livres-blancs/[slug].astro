---
import PageLayout from '../../layouts/PageLayout.astro';
import type { Resource } from '../../types/resource';
import { resources } from '../../data/resources.data';
import { resourceGuides, type ResourceGuide } from '../../data/resource-guides.data';

export function getStaticPaths() {
  return resources.map((resource) => {
    const guide = resourceGuides.find((item) => item.slug === resource.slug);
    if (!guide) throw new Error(`Missing reading content for resource: ${resource.slug}`);
    return {
      params: { slug: resource.slug },
      props: { resource, guide },
    };
  });
}

type Props = {
  resource: Resource;
  guide: ResourceGuide;
};

const { resource, guide } = Astro.props;
---

<PageLayout
  seo={resource.seo}
  breadcrumbs={[
    { label: 'Livres blancs', href: '/livres-blancs' },
    { label: guide.label },
  ]}
>
  <article class="guide">
    <header class="guide-hero">
      <div class="guide-shell guide-hero__grid">
        <div>
          <p>{guide.label}</p>
          <h1>{guide.title}</h1>
          <strong>{guide.introduction}</strong>
        </div>
        <aside>
          <span>Temps de lecture</span>
          <b>{guide.readingTime}</b>
          <small>{guide.sections.length} chapitres · lecture en ligne</small>
        </aside>
      </div>
    </header>

    <div class="guide-shell guide-layout">
      <nav class="guide-nav" aria-label="Sommaire du guide">
        <p>Dans ce guide</p>
        {guide.sections.map((section) => (
          <a href={`#chapitre-${section.number}`}>{section.eyebrow}</a>
        ))}
      </nav>

      <div class="guide-chapters">
        {guide.sections.map((section) => (
          <section id={`chapitre-${section.number}`} class="guide-chapter reveal">
            <div>
              <p>{section.eyebrow}</p>
              <h2>{section.title}</h2>
              <strong>{section.text}</strong>
              <ul>
                {section.points.map((point) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))}

        <section class="guide-takeaways reveal" aria-labelledby="guide-takeaways-title">
          <div>
            <p>Avant de continuer</p>
            <h2 id="guide-takeaways-title">Ce que vous devez pouvoir confirmer.</h2>
          </div>
          <ul>
            {guide.takeaways.map((item) => (
              <li><span aria-hidden="true"></span>{item}</li>
            ))}
          </ul>
        </section>

        <section class="guide-next reveal">
          <p>Votre situation est spécifique ?</p>
          <h2>Passez du guide à votre simulation.</h2>
          <div>
            <a href="/simulateur">Calculer mon salaire net <span aria-hidden="true">→</span></a>
            <a href="/rendez-vous">Parler à un conseiller</a>
          </div>
        </section>
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .guide{background:#fff;color:#203440}
  .guide-shell{width:min(100% - 3rem,82rem);margin-inline:auto}
  .guide-hero{padding-block:clamp(5rem,9vw,8rem);background:#102630;color:#fff}
  .guide-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) 14rem;align-items:end;gap:clamp(3rem,8vw,8rem)}
  .guide-hero p,.guide-chapter>div:last-child>p,.guide-takeaways p,.guide-next>p,.guide-nav>p{margin:0 0 1rem;color:#d0ae5e;font-size:.62rem;font-weight:780;letter-spacing:.15em;text-transform:uppercase}
  .guide-hero h1{max-width:15ch;margin:0;color:#fff;font-family:"Newsreader","Iowan Old Style",Georgia,serif;font-size:clamp(3.7rem,7vw,7.2rem);font-weight:480;letter-spacing:-.06em;line-height:.92}
  .guide-hero strong{display:block;max-width:46rem;margin-top:1.7rem;color:rgba(255,255,255,.62);font-size:clamp(.96rem,1.35vw,1.12rem);font-weight:480;line-height:1.72}
  .guide-hero aside{border-top:1px solid #c6a45a;padding-top:1rem}
  .guide-hero aside span,.guide-hero aside b,.guide-hero aside small{display:block}
  .guide-hero aside span{color:rgba(255,255,255,.48);font-size:.6rem;text-transform:uppercase;letter-spacing:.12em}
  .guide-hero aside b{margin-top:.45rem;font-size:1.35rem}
  .guide-hero aside small{margin-top:.3rem;color:rgba(255,255,255,.48);font-size:.66rem}
  .guide-layout{display:grid;grid-template-columns:13rem minmax(0,1fr);gap:clamp(3rem,8vw,8rem);padding-block:clamp(4.5rem,8vw,7rem)}
  .guide-nav{position:sticky;top:7.4rem;align-self:start;display:grid;border-left:1px solid rgba(32,52,64,.14);padding-left:1.2rem}
  .guide-nav>p{margin-bottom:.65rem;color:#a47f34}
  .guide-nav a{display:grid;grid-template-columns:1.6rem 1fr;gap:.45rem;padding:.7rem 0;color:rgba(32,52,64,.58);font-size:.7rem;line-height:1.4}
  .guide-nav a:hover{color:#203440}
  .guide-nav a span{color:#b79245;font:700 .55rem/1.4 var(--font-mono)}
  .guide-chapters{min-width:0}
  .guide-chapter{display:grid;grid-template-columns:4rem 1fr;gap:clamp(1.2rem,3vw,2.5rem);scroll-margin-top:7rem;padding:0 0 clamp(4.5rem,8vw,7rem);margin-bottom:clamp(4.5rem,8vw,7rem);border-bottom:1px solid rgba(32,52,64,.14)}
  .guide-chapter__number{color:rgba(32,52,64,.13);font-family:"Newsreader",Georgia,serif;font-size:clamp(3.5rem,6vw,5.5rem);line-height:.8}
  .guide-chapter h2{max-width:17ch;margin:0;color:#203440;font-size:clamp(2.1rem,4vw,3.8rem);letter-spacing:-.05em;line-height:1.02}
  .guide-chapter strong{display:block;max-width:44rem;margin-top:1.4rem;color:rgba(32,52,64,.62);font-size:.93rem;font-weight:500;line-height:1.75}
  .guide-chapter ul{display:grid;gap:.65rem;max-width:43rem;margin:1.7rem 0 0;padding:0;list-style:none}
  .guide-chapter li{display:flex;gap:.7rem;color:rgba(32,52,64,.76);font-size:.8rem;line-height:1.55}
  .guide-chapter li span{color:#b79245;font-weight:800}
  .guide-takeaways{display:grid;grid-template-columns:minmax(0,.8fr) minmax(18rem,1fr);gap:clamp(2rem,6vw,5rem);border:1px solid rgba(198,164,90,.38);padding:clamp(2rem,5vw,4rem);background:#f7f4ed}
  .guide-takeaways h2{margin:0;color:#203440;font-size:clamp(2rem,3.4vw,3.2rem);line-height:1.03;letter-spacing:-.045em}
  .guide-takeaways ul{display:grid;gap:.8rem;margin:0;padding:0;list-style:none}
  .guide-takeaways li{display:grid;grid-template-columns:1rem 1fr;gap:.7rem;color:rgba(32,52,64,.7);font-size:.8rem;line-height:1.5}
  .guide-takeaways li span{width:.65rem;height:.65rem;margin-top:.25rem;border:2px solid #c6a45a;border-radius:50%}
  .guide-next{margin-top:clamp(4rem,8vw,7rem);padding:clamp(2.5rem,6vw,5rem);background:#203440;color:#fff}
  .guide-next h2{max-width:13ch;margin:0;color:#fff;font-size:clamp(2.5rem,5vw,4.7rem);line-height:.98;letter-spacing:-.05em}
  .guide-next>div{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}
  .guide-next a{display:inline-flex;min-height:3.1rem;align-items:center;justify-content:center;gap:.65rem;border:1px solid rgba(255,255,255,.32);border-radius:999px;padding:.8rem 1.2rem;color:#fff;font-size:.72rem;font-weight:760}
  .guide-next a:first-child{border-color:#c6a45a;background:#c6a45a;color:#102630}
  @media(max-width:800px){
    .guide-hero__grid{grid-template-columns:1fr}
    .guide-hero aside{max-width:18rem}
    .guide-layout{grid-template-columns:1fr}
    .guide-nav{position:static;grid-template-columns:repeat(2,minmax(0,1fr));border-left:0;border-bottom:1px solid rgba(32,52,64,.14);padding:0 0 1.2rem}
    .guide-nav>p{grid-column:1/-1}
    .guide-takeaways{grid-template-columns:1fr}
  }
  @media(max-width:520px){
    .guide-shell{width:min(100% - 2rem,82rem)}
    .guide-hero h1{font-size:clamp(3.2rem,17vw,5rem)}
    .guide-nav{grid-template-columns:1fr}
    .guide-chapter{grid-template-columns:1fr}
    .guide-chapter__number{font-size:3rem}
  }
</style>
