---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import SiteIcon from '../../components/ui/SiteIcon.astro';
import BrandAmbientShapes from '../../components/ui/BrandAmbientShapes.astro';
import { expertises, type Expertise } from '../../data/expertises.data';
import tripartiteClient from '../../assets/home/tripartite-client.png';
import tripartiteConsultant from '../../assets/home/tripartite-consultant.png';
import qualifiedMatch from '../../assets/enterprise/qualified-match.png';

export function getStaticPaths() {
  return expertises.map((expertise) => ({
    params: { slug: expertise.slug },
    props: { expertise },
  }));
}

const { expertise } = Astro.props as { expertise: Expertise };
const relatedExpertises = expertises
  .filter((item) => item.slug !== expertise.slug)
  .slice(0, 2);
const detailImages = [tripartiteClient, tripartiteConsultant, qualifiedMatch];
const expertiseIndex = Math.max(0, expertises.findIndex((item) => item.slug === expertise.slug));
const heroImage = detailImages[expertiseIndex % detailImages.length];
const detailImage = detailImages[(expertiseIndex + 1) % detailImages.length];
---

<PageLayout
  seo={{
    title: `${expertise.title} — The Porters`,
    description: expertise.seoDescription,
    structuredData: {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: expertise.title,
      description: expertise.seoDescription,
      provider: { '@type': 'Organization', name: 'The Porters' },
      areaServed: 'France',
    },
  }}
  breadcrumbs={[
    { label: 'Expertises', href: '/expertises' },
    { label: expertise.eyebrow },
  ]}
>
  <section class="domain-hero brand-ambient-host" data-motion-section data-motion-hold="2200">
    <BrandAmbientShapes placement="left" tone="dark" />
    <div class="domain-shell domain-hero-grid">
      <div class="domain-hero-copy">
        <p data-motion-item="left" style="--motion-order:0">{expertise.eyebrow}</p>
        <h1 data-motion-item="left" style="--motion-order:1">{expertise.title}</h1>
        <strong data-motion-item="left" style="--motion-order:2">{expertise.summary}</strong>
        <div class="domain-hero-actions" data-motion-item="pop" style="--motion-order:3">
          <a href="/simulateur">Je simule mes revenus <span aria-hidden="true">→</span></a>
          <a href="/rendez-vous">Je parle de ma mission</a>
        </div>
      </div>

      <div class="domain-orbit" data-domain-orbit data-motion-item="pop" style="--motion-order:2" aria-label={`Cycle d’intervention ${expertise.eyebrow}`}>
        <figure class="domain-hero-photo">
          <Image src={heroImage} alt={`Professionnels réunis autour d’une mission ${expertise.eyebrow}`} widths={[640, 900, 1200]} sizes="(max-width:1050px) 92vw, 42vw" format="webp" quality={86} />
          <figcaption><strong>{expertise.roles.length} profils</strong><span>{expertise.missionTypes.length} périmètres de mission</span></figcaption>
        </figure>
        <svg viewBox="0 0 600 600" aria-hidden="true">
          <circle cx="300" cy="300" r="206"></circle>
          <circle cx="300" cy="300" r="132"></circle>
          <path d="M300 54V546M54 300H546"></path>
        </svg>
        <div class="domain-orbit-core">
          <small>Point de départ</small>
          <strong>La mission</strong>
          <span>Besoin · résultat · contraintes</span>
        </div>
        {expertise.methodStages.map((stage, index) => (
          <a
            href={`#method-tab-${stage.number}`}
            class={`domain-orbit-node domain-orbit-node--${index + 1}`}
            style={`--node-delay:${index * 0.7}s`}
            data-method-jump={index}
            data-orbit-node
          >
            <strong>{stage.title}</strong>
          </a>
        ))}
      </div>
    </div>
    <div class="domain-source-strip">
      <div class="domain-shell">
        <div><span>Notre lecture du domaine</span><p>{expertise.sourceSummary}</p></div>
        {expertise.sectors.length > 0 && (
          <div class="domain-sector-list" aria-label="Secteurs cités dans les supports métier">
            <small>Secteurs couverts dans les supports</small>
            <ul>{expertise.sectors.map((sector) => <li>{sector}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="domain-section domain-intro" data-motion-section>
    <div class="domain-shell domain-intro-grid">
      <header class="domain-heading">
        <p data-motion-item="left" style="--motion-order:0">Enjeu de mission</p>
        <h2 data-motion-item="left" style="--motion-order:1">{expertise.introTitle}</h2>
        <figure class="domain-intro-visual" data-motion-item="pop" style="--motion-order:3">
          <Image src={detailImage} alt={`Échange professionnel autour d’une mission ${expertise.eyebrow}`} widths={[460, 720, 960]} sizes="(max-width:1050px) 92vw, 43vw" format="webp" quality={88} />
        </figure>
      </header>
      <div class="domain-intro-copy" data-motion-item="right" style="--motion-order:2">
        {expertise.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <aside>
          <SiteIcon name="shield" />
          <p><strong>Le cadre The Porters</strong> Vous gardez la main sur votre expertise et sur la relation avec le client. Nous nous occupons du salariat, du contrat et de l’administratif.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="domain-section method-section" id="methode" data-method-lab data-motion-section>
    <div class="domain-shell">
      <header class="domain-heading domain-heading--light" data-motion-item="left" style="--motion-order:0">
        <p>Comment se déroule une mission</p>
        <h2>Quatre étapes,<br />et personne ne perd le fil.</h2>
        <strong>Cliquez sur une étape pour voir ce qu’il faut avoir réglé avant de passer à la suivante.</strong>
      </header>

      <div class="method-lab" data-motion-item="wipe" style="--motion-order:1">
        <div class="method-tabs" role="tablist" aria-label={`Méthode ${expertise.eyebrow}`}>
          {expertise.methodStages.map((stage, index) => (
            <button
              type="button"
              id={`method-tab-${stage.number}`}
              role="tab"
              aria-selected={index === 0}
              aria-controls={`method-panel-${stage.number}`}
              tabindex={index === 0 ? 0 : -1}
              class:list={{ 'is-active': index === 0 }}
              data-method-tab
            >
              <strong>{stage.title}</strong>
              <b aria-hidden="true">↗</b>
            </button>
          ))}
        </div>

        <div class="method-stage">
          <div class="method-progress" aria-hidden="true"><span data-method-progress></span></div>
          {expertise.methodStages.map((stage, index) => (
            <article
              id={`method-panel-${stage.number}`}
              role="tabpanel"
              aria-labelledby={`method-tab-${stage.number}`}
              hidden={index !== 0}
              data-method-panel
            >
              <p>Étape en cours</p>
              <h3>{stage.title}</h3>
              <strong>{stage.text}</strong>
              <div class="method-stage-output">
                <small>Repère de sortie</small>
                <p>{expertise.methods[index] ?? expertise.methods[0]}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="domain-section roles-section" data-motion-section>
    <div class="domain-shell">
      <header class="domain-heading" data-motion-item="left" style="--motion-order:0">
        <p>Profils accompagnés</p>
        <h2>Le bon rôle au bon moment.</h2>
        <strong>Un intitulé de poste dit moins de choses que ce qu’on a réellement porté.</strong>
      </header>
      <div class="role-map" data-motion-item="pop" style="--motion-order:1">
        <div class="role-map-core">
          <span>Votre besoin</span>
          <strong>{expertise.eyebrow}</strong>
        </div>
        <div class="role-grid">
          {expertise.roles.map((role, index) => (
            <article style={`--role-index:${index}`}>
              <h3>{role}</h3>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="domain-section mission-section brand-ambient-host" data-motion-section>
    <BrandAmbientShapes placement="left" />
    <div class="domain-shell mission-grid">
      <header class="domain-heading" data-motion-item="left" style="--motion-order:0">
        <p>Périmètres fréquents</p>
        <h2>Des missions jugées sur ce qu’elles produisent.</h2>
        <strong>Ouvrez un périmètre pour voir la place qu’il prend dans la mission.</strong>
      </header>
      <div class="mission-accordion" data-motion-item="right" style="--motion-order:1">
        {expertise.missionTypes.map((mission, index) => (
          <details open={index === 0}>
            <summary>
              <strong>{mission}</strong>
              <b aria-hidden="true">+</b>
            </summary>
            <p>
              Cette intervention est cadrée par un résultat attendu, des responsabilités explicites,
              des accès adaptés et un point de passage vers l’étape suivante.
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {expertise.ecosystem && (
    <section class="ecosystem-focus" data-motion-section>
      <div class="domain-shell ecosystem-focus-grid">
        <div class="ecosystem-signature" data-motion-item="left" style="--motion-order:0">
          <span>{expertise.ecosystem.eyebrow}</span>
          <strong>{expertise.ecosystem.name}</strong>
          <i aria-hidden="true"></i>
        </div>
        <div class="ecosystem-copy" data-motion-item="right" style="--motion-order:1">
          <p>{expertise.ecosystem.text}</p>
          <div>
            {expertise.ecosystem.pillars.map((pillar) => (
              <span>{pillar}</span>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="domain-section impact-section" data-motion-section>
    <div class="domain-shell impact-grid">
      <div>
        <header class="domain-heading" data-motion-item="left" style="--motion-order:0">
          <p>Ce que ça change</p>
          <h2>Ce que la mission doit permettre, une fois finie.</h2>
        </header>
        <div class="impact-cards">
          {expertise.businessValue.map((value, index) => (
            <article data-motion-item="pop" style={`--motion-order:${index + 1};--impact-index:${index}`}>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </article>
          ))}
        </div>
      </div>
      <aside class="support-card" data-motion-item="right" style="--motion-order:2">
        <p>Ce que The Porters prend en charge</p>
        <h2>Tout le cadre, sans toucher à votre expertise.</h2>
        <ol>
          {expertise.support.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
        <a href="/simulateur">Faire une simulation <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="domain-next" data-motion-section>
    <div class="domain-shell">
      <header class="domain-heading domain-heading--light" data-motion-item="left" style="--motion-order:0">
        <p>Pour aller plus loin</p>
        <h2>Une mission déborde souvent sur un autre domaine.</h2>
      </header>
      <div class="domain-next-grid" data-motion-item="wipe" style="--motion-order:1">
        {relatedExpertises.map((related) => (
          <a href={`/expertises/${related.slug}`}>
            <span>{related.eyebrow}</span>
            <strong>{related.introTitle}</strong>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
        <a href="/expertises">
          <span>Toutes les expertises</span>
          <strong>Revenir à la carte des domaines</strong>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-domain-orbit]').forEach((orbit) => {
    const nodes = Array.from(orbit.querySelectorAll<HTMLElement>('[data-orbit-node]'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let timer = 0;
    let paused = false;
    let inView = !('IntersectionObserver' in window);

    const activate = (nextIndex: number) => {
      activeIndex = (nextIndex + nodes.length) % nodes.length;
      nodes.forEach((node, index) => node.classList.toggle('is-active', index === activeIndex));
      orbit.style.setProperty('--orbit-phase', String(activeIndex));
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || paused || !inView || nodes.length < 2) return;
      timer = window.setTimeout(() => {
        activate(activeIndex + 1);
        schedule();
      }, 1900);
    };

    nodes.forEach((node, index) => {
      node.addEventListener('pointerenter', () => { paused = true; activate(index); schedule(); });
      node.addEventListener('pointerleave', () => { paused = false; schedule(); });
      node.addEventListener('focusin', () => { paused = true; activate(index); schedule(); });
      node.addEventListener('focusout', () => { paused = false; schedule(); });
    });
    activate(0);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = Boolean(entry?.isIntersecting);
        schedule();
      }, { threshold: .34 });
      observer.observe(orbit);
    } else {
      schedule();
    }
  });

  document.querySelectorAll<HTMLElement>('[data-method-lab]').forEach((lab) => {
    const tabs = Array.from(lab.querySelectorAll<HTMLButtonElement>('[data-method-tab]'));
    const panels = Array.from(lab.querySelectorAll<HTMLElement>('[data-method-panel]'));
    const progress = lab.querySelector<HTMLElement>('[data-method-progress]');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const orbit = document.querySelector<HTMLElement>('[data-domain-orbit]');
    const orbitNodes = Array.from(orbit?.querySelectorAll<HTMLElement>('[data-orbit-node]') || []);
    let activeIndex = 0;
    let cycleTimer = 0;
    let isPaused = false;
    let isInView = !('IntersectionObserver' in window);

    const select = (nextIndex: number, focus = false) => {
      const index = (nextIndex + tabs.length) % tabs.length;
      activeIndex = index;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.remove('is-entering');
        if (active && !reducedMotion) requestAnimationFrame(() => panel.classList.add('is-entering'));
      });
      if (progress) progress.style.setProperty('--progress', `${((index + 1) / tabs.length) * 100}%`);
      orbitNodes.forEach((node, nodeIndex) => node.classList.toggle('is-active', nodeIndex === index));
    };

    const scheduleCycle = () => {
      window.clearTimeout(cycleTimer);
      if (reducedMotion || isPaused || !isInView || tabs.length < 2) return;
      cycleTimer = window.setTimeout(() => {
        select(activeIndex + 1);
        scheduleCycle();
      }, 2600);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        select(index);
        scheduleCycle();
      });
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? tabs.length - 1
            : index + (event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 1);
        select(next, true);
      });
    });

    orbitNodes.forEach((jump) => {
      jump.addEventListener('click', () => {
        select(Number(jump.dataset.methodJump || 0));
        scheduleCycle();
      });
    });

    select(0);
    lab.addEventListener('pointerenter', () => {
      isPaused = true;
      scheduleCycle();
    });
    lab.addEventListener('pointerleave', () => {
      isPaused = false;
      scheduleCycle();
    });
    lab.addEventListener('focusin', () => {
      isPaused = true;
      scheduleCycle();
    });
    lab.addEventListener('focusout', () => requestAnimationFrame(() => {
      isPaused = lab.contains(document.activeElement);
      scheduleCycle();
    }));

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        isInView = Boolean(entry?.isIntersecting);
        scheduleCycle();
      }, { threshold: .22 });
      observer.observe(lab);
    } else {
      scheduleCycle();
    }
  });

  document.querySelectorAll<HTMLElement>('.mission-accordion').forEach((accordion) => {
    const details = Array.from(accordion.querySelectorAll<HTMLDetailsElement>('details'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = Math.max(0, details.findIndex((detail) => detail.open));
    let timer = 0;
    let isPaused = false;
    let isInView = !('IntersectionObserver' in window);

    const openAt = (nextIndex: number) => {
      activeIndex = (nextIndex + details.length) % details.length;
      details.forEach((detail, index) => { detail.open = index === activeIndex; });
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || isPaused || !isInView || details.length < 2) return;
      timer = window.setTimeout(() => {
        openAt(activeIndex + 1);
        schedule();
      }, 3000);
    };

    details.forEach((detail, index) => {
      detail.addEventListener('toggle', () => {
        if (!detail.open) return;
        activeIndex = index;
        details.forEach((other) => {
          if (other !== detail) other.open = false;
        });
      });
    });

    accordion.addEventListener('pointerenter', () => { isPaused = true; schedule(); });
    accordion.addEventListener('pointerleave', () => { isPaused = false; schedule(); });
    accordion.addEventListener('focusin', () => { isPaused = true; schedule(); });
    accordion.addEventListener('focusout', () => requestAnimationFrame(() => {
      isPaused = accordion.contains(document.activeElement);
      schedule();
    }));

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        isInView = Boolean(entry?.isIntersecting);
        schedule();
      }, { threshold: .28 });
      observer.observe(accordion);
    } else {
      schedule();
    }
  });
</script>

<style>
  .domain-shell{width:min(100% - 3rem,84rem);margin-inline:auto}
  .domain-section{padding-block:clamp(5rem,9vw,8rem)}
  .domain-heading{max-width:52rem}
  .domain-heading>p,.domain-hero-copy>p,.domain-source-strip span,.ecosystem-signature>span{margin:0 0 1rem;color:#b79245;font-size:.68rem;font-weight:780;letter-spacing:.15em;text-transform:uppercase}
  .domain-heading h2{margin:0;color:#203440;font-size:clamp(2.45rem,5vw,5rem);line-height:1;letter-spacing:-.055em}
  .domain-heading>strong{display:block;max-width:40rem;margin-top:1.25rem;color:rgba(32,52,64,.58);font-size:.92rem;font-weight:520;line-height:1.7}
  .domain-heading--light h2{color:#fff}
  .domain-heading--light>strong{color:rgba(255,255,255,.58)}

  .domain-hero{position:relative;overflow:hidden;background:linear-gradient(145deg,#0d222d,#173440 68%,#102630);color:#fff}
  .domain-hero:before{position:absolute;top:-20rem;right:-12rem;width:46rem;height:46rem;border:1px solid rgba(198,164,90,.14);border-radius:50%;box-shadow:0 0 0 9rem rgba(198,164,90,.025);content:""}
  .domain-hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(28rem,.82fr);align-items:center;gap:clamp(2rem,7vw,7rem);min-height:44rem;padding-block:clamp(4rem,8vw,7rem)}
  .domain-hero-copy h1{max-width:12ch;margin:0;color:#fff;font-size:clamp(3.1rem,6.6vw,6.7rem);line-height:.93;letter-spacing:-.065em}
  .domain-hero-copy>strong{display:block;max-width:42rem;margin-top:1.65rem;color:rgba(255,255,255,.68);font-size:clamp(1rem,1.4vw,1.18rem);font-weight:500;line-height:1.72}
  .domain-hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}
  .domain-hero-actions a{display:inline-flex;min-height:3.2rem;align-items:center;justify-content:center;gap:.8rem;border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:.8rem 1.35rem;color:#fff;font-size:.78rem;font-weight:760;text-decoration:none;transition:transform .22s ease,background-color .22s ease,border-color .22s ease}
  .domain-hero-actions a:first-child{border-color:#c6a45a;background:#c6a45a;color:#102630}
  .domain-hero-actions a:hover{border-color:#fff;background:#fff;color:#102630;transform:translateY(-3px)}

  .domain-orbit{position:relative;min-width:0;min-height:36rem;isolation:isolate}
  .domain-orbit svg{width:100%;height:100%;overflow:visible;animation:orbit-turn 34s linear infinite}
  .domain-orbit>svg{position:absolute;z-index:-1;inset:-4%;width:108%;height:108%}
  .domain-orbit svg circle,.domain-orbit svg path{fill:none;stroke:rgba(198,164,90,.2);stroke-width:1}
  .domain-orbit svg path{stroke:rgba(255,255,255,.07);stroke-dasharray:5 9}
  .domain-hero-photo{position:absolute;z-index:0;inset:5% 4% 8%;overflow:hidden;margin:0;border:1px solid rgba(213,182,104,.34);border-radius:1.4rem;background:#173440;box-shadow:0 34px 95px rgba(0,0,0,.38),0 0 0 .45rem rgba(213,182,104,.035);animation:hero-photo-breathe 6.2s ease-in-out infinite}
  .domain-hero-photo:after{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,32,42,.01),rgba(10,32,42,.06) 45%,rgba(10,32,42,.86));content:"";pointer-events:none}
  .domain-hero-photo img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.92) brightness(.94);transition:filter .7s ease,transform 1s cubic-bezier(.16,1,.3,1);animation:hero-photo-pan 9.5s ease-in-out infinite alternate}
  .domain-hero-photo:hover img{filter:saturate(1.05) brightness(1.03);transform:scale(1.055)}
  .domain-hero-photo figcaption{position:absolute;z-index:2;right:1.25rem;bottom:1.1rem;left:1.25rem;display:flex;align-items:end;justify-content:space-between;gap:1rem;color:#fff}
  .domain-hero-photo figcaption strong{font-size:.82rem}
  .domain-hero-photo figcaption span{color:rgba(255,255,255,.62);font-size:.62rem}
  .domain-orbit-core{position:absolute;z-index:3;bottom:4%;left:50%;display:grid;width:10.5rem;height:10.5rem;place-content:center;border:1px solid rgba(198,164,90,.68);border-radius:50%;background:rgba(13,34,45,.94);text-align:center;transform:translateX(-50%);box-shadow:0 0 0 1rem rgba(198,164,90,.07),0 20px 60px rgba(0,0,0,.34);animation:domain-core-pulse 5.8s ease-in-out infinite}
  .domain-orbit-core small{color:#c6a45a;font-size:.58rem;font-weight:760;letter-spacing:.13em;text-transform:uppercase}
