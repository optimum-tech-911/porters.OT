---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import SiteIcon from '../../components/ui/SiteIcon.astro';
import BrandAmbientShapes from '../../components/ui/BrandAmbientShapes.astro';
import { expertises } from '../../data/expertises.data';
import tripartiteClient from '../../assets/home/tripartite-client.png';
import qualifiedMatch from '../../assets/enterprise/qualified-match.png';

const seo = {
  title: 'Expertises IT, data, cyber, cloud et produit — The Porters',
  description:
    'Explorez les expertises accompagnées par The Porters : cybersécurité, Data & IA, Cloud & DevOps, Agilité, Produit et pilotage de projet.',
};

const commonJourney = [
  { number: '01', title: 'Cadrer', text: 'Contexte, résultat attendu, responsabilités et contraintes.' },
  { number: '02', title: 'Choisir', text: 'Le domaine et le niveau d’expertise réellement nécessaires.' },
  { number: '03', title: 'Intervenir', text: 'Une mission autonome, avec des livrables et des points de passage lisibles.' },
  { number: '04', title: 'Transmettre', text: 'Décisions, documentation et connaissances restent dans l’organisation.' },
];
---

<PageLayout seo={seo} breadcrumbs={[{ label: 'Expertises' }]}>
  <section class="expertise-hero brand-ambient-host" data-motion-section data-motion-hold="2200">
    <BrandAmbientShapes placement="left" tone="dark" />
    <div class="expertise-shell expertise-hero-grid">
      <div class="expertise-hero-copy">
        <p data-motion-item="left" style="--motion-order:0">Expertises IT</p>
        <h1 data-motion-item="left" style="--motion-order:1">Dites-nous le problème.<br /><span>Nous savons qui l’a déjà résolu.</span></h1>
        <strong data-motion-item="left" style="--motion-order:2">
          Cyber, data, IA, cloud, DevOps, produit ou transformation&nbsp;: chaque mission commence
          par un contexte précis, jamais par une étiquette.
        </strong>
        <a href="#explorer" data-motion-item="pop" style="--motion-order:3">Je découvre les domaines <span aria-hidden="true">↓</span></a>
      </div>

      <div class="expertise-signal-stage" data-motion-item="pop" style="--motion-order:2" data-expertise-stage aria-label="Du besoin au résultat avec The Porters">
        <figure class="signal-image signal-image--brief is-active" data-signal-image>
          <Image src={tripartiteClient} alt="" widths={[320, 520]} sizes="(max-width: 720px) 42vw, 15rem" format="webp" quality={82} />
          <figcaption>Le besoin, avec les personnes qui le portent</figcaption>
        </figure>
        <figure class="signal-image signal-image--result" data-signal-image>
          <Image src={qualifiedMatch} alt="" widths={[320, 520]} sizes="(max-width: 720px) 42vw, 15rem" format="webp" quality={82} />
          <figcaption>Une expertise qualifiée pour le contexte</figcaption>
        </figure>
        <div class="signal-spine" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="signal-core">
          <small>Point de départ</small>
          <strong>Votre mission</strong>
          <span>Besoin · résultat · contraintes</span>
        </div>
        <div class="signal-card signal-card--brief">
          <small>01 · Le brief</small>
          <strong>Votre problème</strong>
          <span>Contexte · résultat · contraintes</span>
        </div>
        <div class="signal-card signal-card--match">
          <small>02 · Le choix</small>
          <strong>La bonne expertise</strong>
          <span>Le niveau réellement nécessaire</span>
        </div>
        <div class="signal-card signal-card--result">
          <small>03 · La sortie</small>
          <strong>Un résultat cadré</strong>
          <span>Livrables · passage · transmission</span>
        </div>
      </div>
    </div>

    <div class="expertise-domain-tape" data-cms-ignore aria-label="Domaines d’expertise disponibles">
      <div>
        {[...expertises, ...expertises].map((expertise) => (
          <a href={`/expertises/${expertise.slug}`}><span>{expertise.eyebrow}</span><i aria-hidden="true"></i></a>
        ))}
      </div>
    </div>
  </section>

  <section class="expertise-explorer brand-ambient-host" id="explorer" data-motion-section data-expertise-explorer>
    <BrandAmbientShapes placement="left" />
    <div class="expertise-shell">
      <header class="expertise-heading">
        <p data-motion-item="left" style="--motion-order:0">La carte des domaines</p>
        <h2 data-motion-item="left" style="--motion-order:1">Six domaines, <span class="gold-underline">et ce qu’on y fait vraiment</span>.</h2>
        <strong data-motion-item="right" style="--motion-order:2">Cliquez sur un domaine pour voir les profils, les missions et ce qu’on en attend.</strong>
      </header>

      <div class="expertise-explorer-tape" data-motion-item="wipe" style="--motion-order:3" data-cms-ignore aria-hidden="true">
        <div>
          {[...expertises, ...expertises].map((expertise) => (
            <span>{expertise.eyebrow}<i></i></span>
          ))}
        </div>
      </div>

      <div class="expertise-workbench" data-motion-item="wipe" style="--motion-order:4" data-expertise-workbench>
        <div class="expertise-selector" role="tablist" aria-label="Domaines d’expertise">
          {expertises.map((expertise, index) => (
            <button
              type="button"
              id={`expertise-tab-${expertise.slug}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`expertise-panel-${expertise.slug}`}
              tabindex={index === 0 ? 0 : -1}
              class:list={['expertise-selector-button', { 'is-active': index === 0 }]}
              data-expertise-tab
            >
              <strong>{expertise.eyebrow}</strong>
              <small>{expertise.roles.slice(0, 2).join(' · ')}</small>
              <b aria-hidden="true">→</b>
            </button>
          ))}
        </div>

        <div class="expertise-panels">
          {expertises.map((expertise, index) => (
            <article
              id={`expertise-panel-${expertise.slug}`}
              class="expertise-panel"
              role="tabpanel"
              aria-labelledby={`expertise-tab-${expertise.slug}`}
              hidden={index !== 0}
              data-expertise-panel
              data-expertise-slug={expertise.slug}
            >
              <div class="expertise-panel-top">
                <div>
                  <p>{expertise.eyebrow}</p>
                  <h3>{expertise.introTitle}</h3>
                </div>
                <div class="expertise-panel-actions">
                  <a class="expertise-panel-cta" href={`/expertises/${expertise.slug}`}>
                    Voir le domaine en détail <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
              <p class="expertise-summary">{expertise.summary}</p>

              <div class="expertise-panel-grid">
                <section>
                  <div class="expertise-section-title"><SiteIcon name="users" /><h4>Profils</h4></div>
                  <div class="expertise-tags-viewport">
                    <div class="expertise-tags" data-profile-ticker>
                      {expertise.roles.slice(0, 6).map((role) => <span>{role}</span>)}
                    </div>
                  </div>
                </section>
                <section>
                  <div class="expertise-section-title"><SiteIcon name="compass" /><h4>Missions</h4></div>
                  <ol class="expertise-missions">
                    {expertise.missionTypes.slice(0, 4).map((mission, missionIndex) => (
                      <li style={`--mission-index:${missionIndex}`}>{mission}</li>
                    ))}
                  </ol>
                </section>
              </div>

              <section class="expertise-value">
                <div class="expertise-section-title"><SiteIcon name="spark" /><h4>Ce que ça change</h4></div>
                <div>
                  {expertise.businessValue.map((value, valueIndex) => (
                    <article style={`--value-index:${valueIndex}`}>
                      <strong>{value.title}</strong>
                      <p>{value.text}</p>
                    </article>
                  ))}
                </div>
              </section>

            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="expertise-journey" data-expertise-journey data-motion-section>
    <div class="expertise-shell">
      <header class="expertise-heading expertise-heading--light">
        <p data-motion-item="left" style="--motion-order:0">Une méthode commune</p>
        <h2 data-motion-item="left" style="--motion-order:1">Quatre temps, du brief à la passation.</h2>
      </header>
      <div class="journey-track" aria-label="Déroulement commun d’une mission">
        <div class="journey-line" aria-hidden="true"><span data-journey-progress></span></div>
        {commonJourney.map((step, index) => (
          <article class="journey-step" data-motion-item="pop" data-journey-step style={`--journey-index:${index};--motion-order:${index + 2}`}>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-expertise-workbench]').forEach((workbench) => {
    const tabs = Array.from(workbench.querySelectorAll<HTMLButtonElement>('[data-expertise-tab]'));
    const panels = Array.from(workbench.querySelectorAll<HTMLElement>('[data-expertise-panel]'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = Math.max(0, tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'));
    let cycleTimer = 0;
    let isPaused = false;
    let isInView = !('IntersectionObserver' in window);

    workbench.querySelectorAll<HTMLElement>('[data-profile-ticker]').forEach((ticker) => {
      if (ticker.dataset.tickerReady === 'true') return;
      Array.from(ticker.children).forEach((item) => {
        const clone = item.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('data-cms-ignore', 'true');
        ticker.append(clone);
      });
      ticker.dataset.tickerReady = 'true';
    });

    const select = (nextIndex: number, focus = false, updateHash = true) => {
      const index = (nextIndex + tabs.length) % tabs.length;
      activeIndex = index;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.remove('is-entering');
        if (active && !reducedMotion) requestAnimationFrame(() => {
          panel.classList.add('is-entering');
          window.setTimeout(() => panel.classList.remove('is-entering'), 760);
        });
      });
      if (updateHash) history.replaceState(null, '', `#expertise-panel-${panels[index]?.dataset.expertiseSlug}`);
    };

    const stopCycle = () => window.clearTimeout(cycleTimer);
    const scheduleCycle = () => {
      stopCycle();
      workbench.classList.toggle('is-paused', isPaused || !isInView);
      if (reducedMotion || isPaused || !isInView || tabs.length < 2) return;
      cycleTimer = window.setTimeout(() => {
        select(activeIndex + 1, false, false);
        scheduleCycle();
      }, 3400);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        select(index);
        scheduleCycle();
      });
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? tabs.length - 1
            : index + (event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 1);
        select(next, true);
      });
    });

    workbench.addEventListener('focusin', () => {
      isPaused = true;
      scheduleCycle();
    });
    workbench.addEventListener('focusout', () => requestAnimationFrame(() => {
      isPaused = workbench.contains(document.activeElement);
      scheduleCycle();
    }));

    const requested = location.hash.replace('#expertise-panel-', '');
    const requestedIndex = panels.findIndex((panel) => panel.dataset.expertiseSlug === requested);
    if (requestedIndex >= 0) select(requestedIndex, false, false);

    if ('IntersectionObserver' in window) {
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        isInView = Boolean(entry?.isIntersecting);
        scheduleCycle();
      }, { threshold: 0.28 });
      visibilityObserver.observe(workbench);
    } else {
      scheduleCycle();
    }
  });

  document.querySelectorAll<HTMLElement>('[data-expertise-stage]').forEach((stage) => {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.signal-card'));
    const images = Array.from(stage.querySelectorAll<HTMLElement>('[data-signal-image]'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let timer = 0;
    let isVisible = !('IntersectionObserver' in window);
    let isPaused = false;

    const highlight = (index: number) => {
      activeIndex = (index + cards.length) % cards.length;
      cards.forEach((card, cardIndex) => card.classList.toggle('is-active', cardIndex === activeIndex));
      images.forEach((image, imageIndex) => image.classList.toggle('is-active', imageIndex === (activeIndex === 2 ? 1 : 0)));
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || isPaused || !isVisible || cards.length < 2) return;
      timer = window.setTimeout(() => {
        highlight(activeIndex + 1);
        schedule();
      }, 1850);
    };

    cards.forEach((card, index) => {
      card.addEventListener('pointerenter', () => {
        isPaused = true;
        highlight(index);
        schedule();
      });
      card.addEventListener('pointerleave', () => {
        isPaused = false;
        schedule();
      });
      card.addEventListener('focusin', () => {
        isPaused = true;
        highlight(index);
        schedule();
      });
      card.addEventListener('focusout', () => {
        isPaused = false;
        schedule();
      });
    });
    highlight(0);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        isVisible = Boolean(entry?.isIntersecting);
        schedule();
      }, { threshold: .35 });
      observer.observe(stage);
    } else {
      schedule();
    }

    if (matchMedia('(hover: hover) and (pointer: fine)').matches && !reducedMotion) {
      stage.addEventListener('pointermove', (event) => {
        const box = stage.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width - .5;
        const y = (event.clientY - box.top) / box.height - .5;
        stage.style.setProperty('--stage-x', `${x * 9}px`);
        stage.style.setProperty('--stage-y', `${y * 6}px`);
      });
      stage.addEventListener('pointerleave', () => {
        stage.style.setProperty('--stage-x', '0px');
        stage.style.setProperty('--stage-y', '0px');
      });
    }
  });

  document.querySelectorAll<HTMLElement>('[data-expertise-explorer]').forEach((explorer) => {
    const activate = () => explorer.classList.add('is-live');
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      activate();
      return;
    }
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      activate();
      observer.disconnect();
    }, { threshold: .18 });
    observer.observe(explorer);
  });

  document.querySelectorAll<HTMLElement>('[data-expertise-journey]').forEach((journey) => {
    const steps = Array.from(journey.querySelectorAll<HTMLElement>('[data-journey-step]'));
    const progress = journey.querySelector<HTMLElement>('[data-journey-progress]');
    if (!('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const index = steps.indexOf(entry.target as HTMLElement);
        steps.forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex <= index));
        if (progress) progress.style.width = `${(index / Math.max(steps.length - 1, 1)) * 100}%`;
      });
    }, { rootMargin: '-30% 0px -45% 0px', threshold: 0.25 });
    steps.forEach((step) => observer.observe(step));
  });
</script>

<style>
  .expertise-shell {
    width: min(100% - 3rem, 84rem);
    margin-inline: auto;
  }

  .expertise-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background:
      radial-gradient(circle at 75% 40%, rgba(190, 158, 88, 0.16), transparent 32%),
      linear-gradient(145deg, #102630, #172f3d 68%, #102630);
    color: #fff;
  }

  .expertise-hero::before {
    position: absolute;
    top: -18rem;
    right: -10rem;
    width: 42rem;
    height: 42rem;
    border: 1px solid rgba(190, 158, 88, 0.14);
    border-radius: 50%;
    box-shadow: 0 0 0 8rem rgba(190, 158, 88, 0.025);
    content: "";
  }

  .expertise-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(29rem, 1.05fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .expertise-hero-copy > p,
  .expertise-heading > p,
  .expertise-panel-top p {
    margin: 0 0 1rem;
    color: var(--color-porters-gold);
    font-size: 0.7rem;
    font-weight: 760;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .expertise-hero-copy h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(3rem, 5.3vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .expertise-hero-copy h1 span {
    color: #d5b668;
  }

  .expertise-hero-copy > strong {
    display: block;
    max-width: 40rem;
    margin-top: 1.7rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    font-weight: 500;
    line-height: 1.7;
  }

  .expertise-hero-copy > a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px;
    padding: .8rem 1rem;
    background: rgba(255,255,255,.055);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 760;
    text-decoration: none;
    transition: transform 220ms var(--ease-soft), background 220ms ease, border-color 220ms ease;
  }

  .expertise-hero-copy > a:hover,
  .expertise-hero-copy > a:focus-visible {
    border-color: rgba(213,182,104,.7);
    background: rgba(213,182,104,.13);
    outline: none;
    transform: translateY(-3px);
  }

  .expertise-hero-copy > a span {
    transition: transform 220ms var(--ease-soft);
  }

  .expertise-hero-copy > a:hover span {
    transform: translateY(3px);
  }

  .expertise-signal-stage {
    --stage-x: 0px;
    --stage-y: 0px;
    position: relative;
    width: min(100%, 39rem);
    min-height: 32rem;
    margin-inline: auto;
    isolation: isolate;
  }

  .expertise-signal-stage::before {
    position: absolute;
    z-index: -2;
    inset: 3% 7%;
    border: 1px solid rgba(213,182,104,.2);
    border-radius: 50%;
    background:
      linear-gradient(115deg, rgba(255,255,255,.055), transparent 42%),
      radial-gradient(circle at 50% 42%, rgba(213,182,104,.17), transparent 45%);
    content: "";
    transform: translate(var(--stage-x), var(--stage-y)) rotate(-8deg);
    transition: transform 900ms cubic-bezier(.16,1,.3,1);
  }

  .expertise-signal-stage::after {
    position: absolute;
    z-index: -1;
    inset: 18% 24%;
    border-radius: 50%;
    background: rgba(255,255,255,.035);
    box-shadow: 0 0 0 3rem rgba(213,182,104,.025);
    content: "";
    animation: signal-halo-pulse 5.6s ease-in-out infinite;
  }

  .signal-spine {
    position: absolute;
    z-index: 1;
    top: 9%;
    bottom: 9%;
    left: 50%;
    width: 1px;
    background: linear-gradient(transparent, rgba(213,182,104,.58) 16% 84%, transparent);
    transform: translateX(-50%);
  }

  .signal-image {
    position: absolute;
    z-index: 0;
    width: clamp(11rem, 37%, 15rem);
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 1rem;
    background: #173440;
    box-shadow: 0 22px 60px rgba(0,0,0,.24);
    opacity: .17;
    filter: saturate(.6) brightness(.72);
    transform: translateY(24px) scale(.88) rotate(var(--signal-image-tilt));
    transition: opacity .6s ease, filter .6s ease, transform .8s cubic-bezier(.16,1,.3,1);
    animation: signal-image-drift 6.8s ease-in-out var(--signal-image-delay, 0s) infinite;
  }

  .signal-image img {
    display: block;
    width: 100%;
    aspect-ratio: 1.35;
    object-fit: cover;
  }

  .signal-image figcaption {
    padding: .62rem .72rem;
    color: rgba(255,255,255,.72);
    font-size: .56rem;
    font-weight: 680;
    line-height: 1.35;
  }

  .signal-image.is-active {
    z-index: 2;
    opacity: .96;
    filter: saturate(1.05) brightness(1.02);
    box-shadow: 0 32px 78px rgba(0,0,0,.36), 0 0 0 .3rem rgba(213,182,104,.09);
    transform: translateY(-8px) scale(1.04) rotate(var(--signal-image-tilt));
  }

  .signal-image--brief {
    --signal-image-tilt: -4deg;
    top: 21%;
    left: 5%;
  }

  .signal-image--result {
    --signal-image-delay: -3.1s;
    --signal-image-tilt: 4deg;
    right: 5%;
    bottom: 17%;
  }

  .signal-spine i {
    position: absolute;
    left: 50%;
    width: .62rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #d5b668;
    box-shadow: 0 0 0 .55rem rgba(213,182,104,.1);
    transform: translate(-50%,-50%);
  }

  .signal-spine i:nth-child(1) { top: 10%; }
  .signal-spine i:nth-child(2) { top: 50%; }
  .signal-spine i:nth-child(3) { top: 90%; }

  .signal-core {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(12rem, 34%, 14rem);
    aspect-ratio: 1;
    place-content: center;
    gap: .5rem;
    border: 1px solid rgba(213,182,104,.75);
    border-radius: 50%;
    background: rgba(10,34,44,.92);
    box-shadow: 0 0 0 1.4rem rgba(213,182,104,.045), 0 0 0 3.2rem rgba(213,182,104,.025), 0 30px 70px rgba(0,0,0,.22);
    text-align: center;
    transform: translate(calc(-50% + var(--stage-x)), calc(-50% + var(--stage-y)));
    transition: transform 900ms cubic-bezier(.16,1,.3,1);
    animation: signal-core-breathe 5.4s ease-in-out infinite;
  }

  .signal-core::before,
  .signal-core::after {
    position: absolute;
    inset: -3.8rem;
    border: 1px dashed rgba(213,182,104,.22);
    border-radius: 50%;
    content: "";
