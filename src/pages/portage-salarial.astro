<script>
  document.querySelectorAll<HTMLElement>('[data-comparison]').forEach((comparison) => {
    const buttons = Array.from(comparison.querySelectorAll<HTMLButtonElement>('[data-comparison-button]'));
    const table = comparison.querySelector<HTMLElement>('[data-comparison-table]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.comparisonButton || 'portage';
        if (table) table.dataset.highlight = value;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        if (table && table.scrollWidth > table.clientWidth) {
          const column = { portage: 1, micro: 2, ei: 3, sasu: 4, eurl: 5 }[value as 'portage' | 'micro' | 'ei' | 'sasu' | 'eurl'];
          table.querySelectorAll('thead th')[column]?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-management-fees]').forEach((section) => {
    const cards = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-fee-card]'));
    const dots = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-fee-dot]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 640px)');
    let activeIndex = 0;
    const activate = (index: number, scroll = false) => {
      if (!cards[index] || index === activeIndex && cards[index].classList.contains('management-fees__card--featured')) return;
      const previousRects = !reducedMotion && !mobile.matches
        ? new Map(cards.map((card) => [card, card.getBoundingClientRect()]))
        : null;
      activeIndex = index;
      cards.forEach((card, cardIndex) => {
        const active = cardIndex === index;
        card.classList.toggle('management-fees__card--featured', active);
        card.setAttribute('aria-pressed', String(active));
      });
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-pressed', String(active));
      });
      if (previousRects) {
        cards.forEach((card) => {
          const before = previousRects.get(card);
          const after = card.getBoundingClientRect();
          if (!before) return;
          const x = before.left - after.left;
          const y = before.top - after.top;
          const scaleX = before.width / Math.max(after.width, 1);
          const scaleY = before.height / Math.max(after.height, 1);
          if (Math.abs(x) < 1 && Math.abs(y) < 1 && Math.abs(scaleX - 1) < .01 && Math.abs(scaleY - 1) < .01) return;
          card.animate(
            [
              { transformOrigin: 'top left', transform: `translate(${x}px, ${y}px) scale(${scaleX}, ${scaleY})` },
              { transformOrigin: 'top left', transform: 'none' },
            ],
            { duration: 720, easing: 'cubic-bezier(.16,1,.3,1)' },
          );
        });
      }
      if (!reducedMotion) {
        cards[index].animate(
          [{ filter: 'brightness(.9)', opacity: .72 }, { filter: 'brightness(1)', opacity: 1 }],
          { duration: 520, easing: 'cubic-bezier(.16,1,.3,1)' },
        );
      }
      if (scroll && mobile.matches) {
        cards[index].scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      }
    };
    cards.forEach((card, index) => {
      card.addEventListener('click', () => activate(index));
      card.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const next = (index + (event.key === 'ArrowRight' ? 1 : -1) + cards.length) % cards.length;
        activate(next, true);
        cards[next]?.focus();
      });
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => activate(index, true)));
    if (!reducedMotion) {
      window.setInterval(() => {
        const bounds = section.getBoundingClientRect();
        const visible = bounds.top < window.innerHeight * .82 && bounds.bottom > window.innerHeight * .18;
        const interacting = section.matches(':hover') || section.contains(document.activeElement);
        if (!visible || interacting || document.hidden || mobile.matches) return;
        activate((activeIndex + 1) % cards.length);
      }, 5600);
    }
  });

  document.querySelectorAll<HTMLElement>('[data-table-man]').forEach((man) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      man.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        man.classList.add('is-visible');
        observer.disconnect();
      },
      { threshold: 0.22, rootMargin: '0px 0px -8% 0px' }
    );

    observer.observe(man);
  });
</script>

