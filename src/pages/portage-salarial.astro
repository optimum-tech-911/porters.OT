---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PresidentVideo from '../components/ui/PresidentVideo.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import TripartiteDiagram from '../components/ui/TripartiteDiagram.astro';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import { pageSeo } from '../data/seo.data';
import portageHeroImage from '../../images/advisor-discussion.webp';
import whyPortageWoman from '../assets/home/why-portage-woman.png';
import tableMan from '../assets/home/table-man.png';
import benefitMission from '../assets/portage/benefit-mission.png';
import benefitEmployee from '../assets/portage/benefit-employee.png';
import benefitAdministration from '../assets/portage/benefit-administration.png';
import benefitAdviser from '../assets/portage/benefit-adviser.png';

const benefits = [
  {
    icon: 'rocket' as const,
    image: benefitMission,
    imageAlt: 'Consultante indépendante pilotant sa mission depuis son ordinateur',
    imagePosition: 'center 43%',
    title: 'Vous gardez la mission',
    description: 'Vous trouvez vos clients, vous fixez votre TJM, vous menez votre intervention comme vous l’entendez.',
  },
  {
    icon: 'shield' as const,
    image: benefitEmployee,
    imageAlt: 'Consultants accueillis et accompagnés par leur interlocutrice',
    imagePosition: 'center 48%',
    title: 'Vous devenez salarié',
    description: 'Un contrat de travail vous rattache au régime général et à la convention collective du portage.',
  },
  {
    icon: 'clipboard' as const,
    image: benefitAdministration,
    imageAlt: 'Contrat relu avec précision par deux interlocuteurs',
    imagePosition: 'center 54%',
    title: 'L’administratif part chez nous',
    description: 'Contrat de prestation, facturation, paie, déclarations : tout cela sort de votre quotidien.',
  },
  {
    icon: 'user' as const,
    image: benefitAdviser,
    imageAlt: 'Consultant échangeant avec une conseillère dédiée autour d’un tableau de bord',
    imagePosition: 'center 48%',
    title: 'Quelqu’un suit votre dossier',
    description: 'La même personne vous répond sur le contrat, l’activité déclarée et la paie.',
  },
];

const comparisonRows = [
  {
    criterion: 'Protection sociale',
    portage: 'Statut salarié',
    micro: 'Régime du travailleur indépendant',
    company: 'Selon le statut du dirigeant',
  },
  {
    criterion: 'Responsabilité contractuelle',
    portage: 'Cadre porté par The Porters',
    micro: 'Engagée par l’entrepreneur',
    company: 'Engagée par la société',
  },
  {
    criterion: 'Gestion administrative',
    portage: 'Déléguée',
    micro: 'Gérée par vous',
    company: 'Gérée par vous ou un prestataire',
  },
  {
    criterion: 'Assurance chômage',
    portage: 'Selon les conditions du régime salarié',
    micro: 'Non ouverte par la seule micro-entreprise',
    company: 'Selon le statut et les conditions',
  },
  {
    criterion: 'Retraite',
    portage: 'Régime général',
    micro: 'Régime des indépendants',
    company: 'Selon le statut du dirigeant',
  },
  {
    criterion: 'Plafond de chiffre d’affaires',
    portage: 'Aucun plafond propre au portage',
    micro: 'Plafond du régime micro',
    company: 'Aucun plafond propre à la société',
  },
];

const faqItems = [
  {
    question: 'Qui trouve la mission ?',
    answer: 'Vous. Vous choisissez vos clients, vous négociez votre TJM et vous organisez votre intervention : nous n’entrons pas dans cette relation.',
  },
  {
    question: 'Comment le chiffre d’affaires devient-il un salaire ?',
    answer: 'The Porters facture l’entreprise cliente. Ce qui reste, une fois les frais de gestion et les cotisations déduits, finance votre rémunération.',
  },
  {
    question: 'Que couvrent les frais de gestion ?',
    answer: 'Le contrat, la facturation, la paie, le suivi administratif, la responsabilité civile professionnelle et la garantie financière. Le détail figure sur la page des frais.',
  },
];
---

<PageLayout
  seo={{
    title: pageSeo.portageSalarial.title,
    description: pageSeo.portageSalarial.description,
  }}
  breadcrumbs={[{ label: 'Portage salarial' }]}
>
  <section class="portage-hero" data-motion-scene>
    <div class="portage-hero__visual" aria-hidden="true">
      <img src={portageHeroImage.src} width={portageHeroImage.width} height={portageHeroImage.height} alt="" />
    </div>
    <div class="container portage-hero__inner mx-auto px-6 lg:px-8">
      <div class="portage-hero__copy reveal">
        <p>Comprendre le portage</p>
        <h1>Libre dans la mission.<br /><span>Salarié dans le cadre.</span></h1>
        <p class="portage-hero__lead">
          Vous trouvez vos clients, vous négociez votre TJM. Nous rédigeons les contrats,
          facturons la mission et transformons ce chiffre d’affaires en salaire.
        </p>
        <div class="portage-hero__actions">
          <a href="/simulateur" class="btn btn-primary">Calculer mon salaire net</a>
          <a href="#fonctionnement" class="portage-anchor">Voir comment ça marche <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" id="fonctionnement" data-motion-section>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div class="reveal">
          <p data-motion-item="left" style="--motion-order:0" class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Comment ça marche</p>
          <h2 data-motion-item="left" style="--motion-order:1">Vous, votre client, et nous au milieu.</h2>
          <p data-motion-item="left" style="--motion-order:2" class="mt-5 text-lg leading-relaxed text-porters-black/70">
            Vous réalisez la mission chez votre client. Nous signons le contrat de prestation avec lui,
            nous vous employons, et nous prenons en charge tout l’administratif qui va avec.
          </p>
          <p data-motion-item="left" style="--motion-order:3" class="mb-0 text-porters-black/62">
            Le portage salarial est une relation tripartite encadrée par le Code du travail et la convention
            collective de branche.
          </p>
          <a data-motion-item="pop" style="--motion-order:4" href="/consultants" class="mt-6 inline-flex items-center gap-2 font-semibold text-porters-navy hover:text-porters-gold transition-colors">
            Voir le parcours complet du consultant <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="reveal" data-motion-item="right" style="--motion-order:2">
          <PresidentVideo />
        </div>
        <div class="min-w-0 lg:col-span-2 reveal">
          <TripartiteDiagram />
        </div>
      </div>
    </div>
  </section>

  <section class="section portage-benefits-section" data-motion-section>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal portage-benefits-heading">
        <p data-motion-item="up" style="--motion-order:0" class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Les raisons qui reviennent le plus souvent</p>
        <h2 data-motion-item="up" style="--motion-order:1">Pourquoi tant de consultants IT passent au portage</h2>
      </div>
      <div class="portage-benefits-layout">
        <figure class="portage-benefits-portrait reveal" data-reveal data-motion-item="left" style="--motion-order:2">
          <Image
            src={whyPortageWoman}
            alt="Consultante réfléchissant aux avantages du portage salarial"
            widths={[480, 720, 960]}
            sizes="(max-width: 820px) 82vw, 38vw"
            format="webp"
            quality={90}
            loading="lazy"
          />
        </figure>
        <div class="portage-benefits-stack" aria-label="Quatre bénéfices du portage salarial">
          {benefits.map((benefit, index) => (
            <article class="portage-benefit reveal" data-reveal data-motion-item="right" style={`--reveal-delay:${index * 110}ms;--motion-order:${index + 2}`}>
              <div class="icon-chip"><SiteIcon name={benefit.icon} /></div>
              <div class="portage-benefit__copy">
                <h3>{benefit.title}</h3>
                <p>{benefit.description}</p>
              </div>
              <figure class="portage-benefit__media" style={`--benefit-image-position:${benefit.imagePosition}`}>
                <Image
                  src={benefit.image}
                  alt={benefit.imageAlt}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 720px) 7rem, (max-width: 1100px) 8rem, 9.5rem"
                  format="webp"
                  quality={88}
                  loading="lazy"
                />
              </figure>
            </article>
          ))}
          <div class="portage-benefits-links" data-motion-item="pop" style="--motion-order:7">
            <a href="/tarifs">Comprendre les frais <span aria-hidden="true">→</span></a>
            <a href="/faq">Lire les questions fréquentes <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section portage-comparison brand-ambient-host" data-motion-section>
    <BrandAmbientShapes placement="right" />
    <div class="container mx-auto px-6 lg:px-8" data-comparison>
      <!--
        This introduction is deliberately excluded from positional CMS discovery.
        A removed section previously shifted the generated key and caused an old
        heading to overwrite this one. Its identity and wording must remain tied
        to the comparison table below.
      -->
      <div class="portage-comparison-intro reveal" data-cms-ignore>
        <p data-motion-item="left" style="--motion-order:0">Comparer avant de choisir</p>
        <h2 data-motion-item="left" style="--motion-order:1">Quel statut <span class="gold-underline">pour vous</span>&nbsp;?</h2>
        <strong data-motion-item="right" style="--motion-order:2">
          Autonomie, protection sociale, gestion, coûts : voici ce qui change vraiment d’un statut à l’autre.
        </strong>
      </div>
      <div class="portage-comparison-toolbar reveal" data-motion-item="up" style="--motion-order:3">
        <div>
          <small>Comparateur interactif</small>
          <strong>Cliquez sur un statut pour le mettre en avant.</strong>
        </div>
        <div class="portage-comparison-switcher" aria-label="Mettre une option en évidence">
        <button type="button" class="is-active" data-motion-item="chip" style="--motion-order:4" data-comparison-button="portage" aria-pressed="true">Portage salarial</button>
        <button type="button" data-motion-item="chip" style="--motion-order:5" data-comparison-button="micro" aria-pressed="false">Auto-entrepreneur</button>
        <button type="button" data-motion-item="chip" style="--motion-order:6" data-comparison-button="company" aria-pressed="false">Création de société</button>
        </div>
      </div>
      <div class="portage-table-scene">
        <figure
          class="portage-table-man"
          data-table-man
          data-cms-key="pages.portage-salarial.media.table-man"
          data-cms-route="/portage-salarial"
          data-cms-element-type="paragraph"
          data-cms-layout-target="true"
          data-cms-layout-value='{"x":0,"y":0,"scale":100}'
          aria-label="Illustration mobile : homme appuyé sur le comparateur"
        >
          <Image
            src={tableMan}
            alt=""
            widths={[300, 420, 560]}
            sizes="(max-width: 720px) 11rem, (max-width: 1100px) 14rem, 16.5rem"
            format="webp"
            quality={92}
            loading="lazy"
          />
        </figure>
        <div class="portage-table-wrap reveal" data-motion-item="wipe" style="--motion-order:6" data-comparison-table data-highlight="portage">
          <table class="portage-table">
            <thead>
              <tr style="--row-order:0">
                <th scope="col">Critère</th>
                <th scope="col" class="is-portage">Portage salarial</th>
                <th scope="col">Auto-entrepreneur</th>
                <th scope="col">Création de société</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row, index) => (
                <tr style={`--row-order:${index + 1}`}>
                  <th scope="row">{row.criterion}</th>
                  <td class="is-portage">{row.portage}</td>
                  <td>{row.micro}</td>
                  <td>{row.company}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section portage-faq brand-ambient-host" data-motion-section>
    <BrandAmbientShapes placement="left" />
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-3xl text-center reveal" data-motion-item="up" style="--motion-order:0">
        <h2><span class="gold-underline">Avant de vous lancer</span></h2>
      </div>
      <div class="portage-faq-list reveal">
        {faqItems.map((item, index) => (
          <details data-motion-item="pop" style={`--motion-order:${index + 1}`}>
            <summary>{item.question}<span aria-hidden="true">+</span></summary>
            <div><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-comparison]').forEach((comparison) => {
    const buttons = Array.from(comparison.querySelectorAll<HTMLButtonElement>('[data-comparison-button]'));
    const table = comparison.querySelector<HTMLElement>('[data-comparison-table]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.comparisonButton || 'portage';
        if (table) table.dataset.highlight = value;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-table-man]').forEach((man) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      man.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        man.classList.add('is-visible');
        observer.disconnect();
      },
      { threshold: 0.22, rootMargin: '0px 0px -8% 0px' }
    );

    observer.observe(man);
  });
</script>

<style>
  .portage-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #f4eee4;
    color: var(--color-porters-navy);
  }

  .portage-hero::before {
    content: none;
  }

  .portage-hero__visual {
    position: absolute;
    z-index: -2;
    inset: 0;
    overflow: hidden;
    animation: portage-hero-visual-in 1.05s 120ms cubic-bezier(.16,1,.3,1) backwards;
  }

  .portage-hero__visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(244, 238, 228, 0.98) 0%, rgba(244, 238, 228, 0.91) 46%, rgba(244, 238, 228, 0.28) 100%);
    content: '';
  }

  .portage-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.82) sepia(0.05) contrast(0.96);
    animation: portage-hero-image-in 1.35s 120ms cubic-bezier(.16,1,.3,1) backwards;
  }

  .portage-hero__inner {
    position: relative;
    padding-block: 6rem;
  }

  .portage-hero__copy { max-width: 42rem; }
  .portage-hero__copy > p:first-child,
  .portage-hero__copy h1,
  .portage-hero__lead {
    animation: portage-hero-copy-in .78s cubic-bezier(.16,1,.3,1) backwards;
  }
  .portage-hero__copy > p:first-child { animation-delay:120ms; }
  .portage-hero__copy h1 { animation-delay:220ms; }
  .portage-hero__lead { animation-delay:360ms; }
  .portage-hero__copy > p:first-child {
    margin: 0 0 1.25rem;
    color: #9a732e;
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .portage-hero h1 {
    max-width: none;
    margin: 0;
    color: var(--color-porters-navy);
    font-size: 2.42rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .portage-hero h1 span { color: inherit; }
  .portage-hero__lead {
    max-width: 35rem;
    margin: 1.5rem 0 0;
    color: rgba(32, 52, 64, .72);
    font-size: 1.125rem;
    line-height: 1.625;
  }

  .portage-hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }
  .portage-hero__actions > * {
    animation: portage-hero-button-in .72s cubic-bezier(.16,1.15,.3,1) backwards;
  }
  .portage-hero__actions > :nth-child(1) { animation-delay:500ms; }
  .portage-hero__actions > :nth-child(2) { animation-delay:610ms; }

  @keyframes portage-hero-visual-in {
    from { opacity:0;transform:translateX(5rem);filter:blur(9px); }
  }

  @keyframes portage-hero-image-in {
    from { transform:scale(1.08); }
  }

  @keyframes portage-hero-copy-in {
    from { opacity:0;transform:translateX(-4rem);filter:blur(7px); }
  }

  @keyframes portage-hero-button-in {
    from { opacity:0;transform:translateY(1.4rem) scale(.76);filter:blur(5px); }
    72% { opacity:1;transform:translateY(-2px) scale(1.025);filter:none; }
  }

  .portage-anchor {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding-inline: 1rem;
    border: 1px solid rgba(32, 52, 64, .24);
    border-radius: 999px;
    color: var(--color-porters-navy);
    font-size: 1rem;
    font-weight: 700;
    transition: color 180ms ease, transform 220ms var(--ease-soft);
  }

  .portage-anchor:hover,
  .portage-anchor:focus-visible {
    border-color: var(--color-porters-navy);
    background: var(--color-porters-navy);
    color: #fff;
    transform: translateY(-2px);
  }

  @media (min-width: 768px) {
    .portage-hero h1 { font-size: 3.25rem; }
  }

  @media (min-width: 1024px) {
    .portage-hero__inner { padding-block: 8rem; }
  }

  .portage-benefits-section { background: linear-gradient(180deg, #f7f3ec, #fff 88%); }
  .portage-benefits-heading { margin-inline: auto; text-align: center; }
  .portage-benefits-layout {
    display: grid;
    grid-template-columns: minmax(20rem, .78fr) minmax(0, 1.22fr);
    align-items: start;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .portage-benefits-portrait {
    position: sticky;
    top: calc(var(--header-height, 5rem) + 1.25rem);
    align-self: start;
    min-height: 38rem;
    margin: 0;
    overflow: hidden;
    border-radius: 12rem 12rem 1.5rem 1.5rem;
    background: radial-gradient(circle at 50% 32%, rgba(198,164,90,.22), transparent 56%), #ede3d6;
    box-shadow: 0 24px 65px rgba(32,52,64,.11);
  }

  .portage-benefits-portrait::after {
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(198,164,90,.35);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .portage-benefits-portrait img { display: block; width: 100%; height: 38rem; object-fit: cover; object-position: center top; }
  .portage-benefits-stack { display: grid; gap: 1rem; }

  .portage-benefit {
    position:relative;
    z-index:1;
    display: grid;
    min-height: 10rem;
    grid-template-columns: auto minmax(0, 1fr) clamp(7.75rem, 14vw, 10.5rem);
    align-items: center;
    gap: 1rem;
    border: 1px solid rgba(40, 55, 67, 0.1);
    border-top-color:rgba(198,164,90,.55);
    border-radius: 1rem;
    padding: clamp(1rem, 2vw, 1.35rem);
    background: rgba(255, 255, 255, 0.9);
    box-shadow:0 14px 35px rgba(32,52,64,.07);
    transition: background 180ms ease, transform 320ms var(--ease-soft), box-shadow 240ms ease;
  }

  .portage-benefit:hover {
    background: #fff;
    box-shadow: 0 22px 52px rgba(32,52,64,.13);
    transform: translateX(-.45rem) translateY(-3px);
  }

  .portage-benefits-section.motion-section-ready .portage-benefit .icon-chip,
  .portage-benefits-section.motion-section-ready .portage-benefit__copy,
  .portage-benefits-section.motion-section-ready .portage-benefit__media {
    opacity:0;
    filter:blur(5px);
    transition:opacity .58s ease,filter .66s ease,transform .72s cubic-bezier(.16,1,.3,1);
    transition-delay:calc(var(--motion-order, 0) * 82ms + 260ms);
  }

  .portage-benefits-section.motion-section-ready .portage-benefit .icon-chip { transform:scale(.5) rotate(-10deg); }
  .portage-benefits-section.motion-section-ready .portage-benefit__copy { transform:translateY(1rem); }
  .portage-benefits-section.motion-section-ready .portage-benefit__media { transform:translateX(1.5rem) scale(.9); }

  .portage-benefits-section.motion-section-ready.is-motion-visible .portage-benefit .icon-chip,
  .portage-benefits-section.motion-section-ready.is-motion-visible .portage-benefit__copy,
  .portage-benefits-section.motion-section-ready.is-motion-visible .portage-benefit__media {
    opacity:1;
    filter:none;
    transform:none;
  }

  .portage-benefit h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .portage-benefit p {
    margin: 0.55rem 0 0;
    color: rgba(40, 55, 67, 0.64);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .portage-benefit__copy { min-width:0; }

  .portage-benefit__media {
    position:relative;
    align-self:stretch;
    min-height:7.3rem;
    margin:0;
    overflow:hidden;
    border:1px solid rgba(198,164,90,.28);
    border-radius:.8rem;
    background:#e8e0d4;
    box-shadow:0 10px 24px rgba(32,52,64,.1);
  }

  .portage-benefit__media::after {
    position:absolute;
    inset:0;
    border-radius:inherit;
    background:linear-gradient(135deg,rgba(255,255,255,.12),transparent 52%);
    content:'';
    pointer-events:none;
  }

  .portage-benefit__media :global(img) {
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:var(--benefit-image-position,center);
    transition:transform 650ms cubic-bezier(.16,1,.3,1),filter 300ms ease;
  }

  .portage-benefit:hover .portage-benefit__media :global(img) { transform:scale(1.055);filter:saturate(1.04) contrast(1.02); }

  .portage-benefits-links { display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.7rem;margin-top:1rem; }
