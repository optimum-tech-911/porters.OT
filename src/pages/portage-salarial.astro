---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PresidentVideo from '../components/ui/PresidentVideo.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import TripartiteDiagram from '../components/ui/TripartiteDiagram.astro';
import BrandAmbientShapes from '../components/ui/BrandAmbientShapes.astro';
import { pageSeo } from '../data/seo.data';
import { cmsAttrs, cmsText } from '../cms/content';
import portageHeroImage from '../../images/advisor-discussion.webp';
import whyPortageWoman from '../assets/home/why-portage-woman.png';
import tableMan from '../assets/home/table-man.png';
import benefitMission from '../assets/portage/benefit-mission.png';
import benefitEmployee from '../assets/portage/benefit-employee.png';
import benefitAdministration from '../assets/portage/benefit-administration.png';
import benefitAdviser from '../assets/portage/benefit-adviser.png';

// Explicit legacy keys keep the published content attached when sections move.
const managementFeeCmsKeys = [["pages.portage-salarial.auto.paragraph.16hq9l8", "pages.portage-salarial.auto.paragraph.1ygkead"], ["pages.portage-salarial.auto.paragraph.49hgu5", "pages.portage-salarial.auto.paragraph.1velxbc"], ["pages.portage-salarial.auto.paragraph.1t8ufay", "pages.portage-salarial.auto.paragraph.xoh46f"], ["pages.portage-salarial.auto.paragraph.14lginf", "pages.portage-salarial.auto.paragraph.176ujsy"], ["pages.portage-salarial.auto.paragraph.1id1ce8", "pages.portage-salarial.auto.paragraph.6okau9"], ["pages.portage-salarial.auto.paragraph.16dzxq9", "pages.portage-salarial.auto.paragraph.18c89xg"], ["pages.portage-salarial.auto.paragraph.16gba4u", "pages.portage-salarial.auto.paragraph.ao32w3"]];
const faqCmsKeys = [["pages.portage-salarial.auto.button.1spfzc3", "pages.portage-salarial.auto.paragraph.lrj3uk"], ["pages.portage-salarial.auto.button.pjz5lw", "pages.portage-salarial.auto.paragraph.16622un"], ["pages.portage-salarial.auto.button.17fic7h", "pages.portage-salarial.auto.paragraph.5ksvxe"]];

const managementFees = [
  {
    title: 'Avance de trésorerie',
    // F-B14 — REQUIRED. Le versement dès le premier mois, avant règlement de la
    // première facture client, est une affirmation générique directement portée
    // par le livre blanc p.22 (« PAS DE FRAIS CACHÉS »). Publiée telle quelle.
    // Les échéances de paie exactes restent CLIENT_APPROVAL_REQUIRED (F-C14) et
    // ne sont pas chiffrées ici.
    text: 'Vous êtes payé dès le premier mois, avant même que votre client nous règle sa première facture. Le calendrier de paie vous est expliqué avant le démarrage.',
  },
  {
    title: 'Apport d’affaires',
    text: 'Nous vous proposons des missions issues de nos partenaires ; vous restez libre de trouver les vôtres.',
  },
  {
    title: 'Interlocuteur unique',
    text: 'Une seule personne suit votre dossier.',
  },
  {
    title: 'Gestion administrative complète',
    text: 'Contrat, facturation, paie, déclarations sociales et fiscales.',
  },
  {
    title: 'Responsabilité civile professionnelle',
    text: 'Vous êtes couvert en cas de dommage causé chez un client.',
  },
  {
    title: 'Financement des formations',
    // Livre blanc p.22, item 6 : « Accompagnement dans vos démarches de formation
    // (CPF, OPCO, certifications…) ». Les dispositifs sont nommés, comme dans la source.
    text: 'CPF, OPCO, certifications. Nous vous orientons sur les dispositifs mobilisables selon votre situation.',
  },
  {
    title: 'Garantie financière',
    text: 'Dispositif obligatoire qui sécurise le versement de votre salaire.',
  },
];

const benefits = [
  {
    icon: 'rocket' as const,
    image: benefitMission,
    imageAlt: 'Consultante indépendante pilotant sa mission depuis son ordinateur',
    imagePosition: 'center 43%',
    title: 'Vous gardez la mission',
    description: 'Vous trouvez vos clients, vous fixez votre TJM, vous menez votre intervention comme vous l’entendez.',
  },
  {
    icon: 'shield' as const,
    image: benefitEmployee,
    imageAlt: 'Consultants accueillis et accompagnés par leur interlocutrice',
    imagePosition: 'center 48%',
    title: 'Vous devenez salarié',
    description: 'Un contrat de travail vous rattache au régime général et à la convention collective du portage.',
  },
  {
    icon: 'clipboard' as const,
    image: benefitAdministration,
    imageAlt: 'Contrat relu avec précision par deux interlocuteurs',
    imagePosition: 'center 54%',
    title: 'L’administratif part chez nous',
    description: 'Contrat de prestation, facturation, paie, déclarations : tout cela sort de votre quotidien.',
  },
  {
    icon: 'user' as const,
    image: benefitAdviser,
    imageAlt: 'Consultant échangeant avec une conseillère dédiée autour d’un tableau de bord',
    imagePosition: 'center 48%',
    title: 'Quelqu’un suit votre dossier',
    description: 'La même personne vous répond sur le contrat, l’activité déclarée et la paie.',
  },
];

const comparisonRows = [
  {
    criterion: 'Protection sociale',
    criterionKey: 'pages.portage-salarial.auto.paragraph.13oassj',
    portage: 'Statut salarié',
    portageKey: 'pages.portage-salarial.auto.paragraph.10io667',
    micro: 'Régime du travailleur indépendant',
    microKey: 'pages.portage-salarial.auto.paragraph.tof1l8',
    ei: 'Travailleur non salarié',
    company: 'Selon le statut du dirigeant',
    companyKey: 'pages.portage-salarial.auto.paragraph.18mx3fp',
    sasu: 'Président assimilé salarié',
    eurl: 'Gérant associé : travailleur non salarié',
  },
  {
    criterion: 'Responsabilité contractuelle',
    criterionKey: 'pages.portage-salarial.auto.paragraph.76tg7i',
    portage: 'Cadre porté par The Porters',
    portageKey: 'pages.portage-salarial.auto.paragraph.yvq2be',
    micro: 'Engagée par l’entrepreneur',
    microKey: 'pages.portage-salarial.auto.paragraph.1b2vi3l',
    ei: 'Engagée par l’entrepreneur individuel',
    company: 'Engagée par la société',
    companyKey: 'pages.portage-salarial.auto.paragraph.30v79k',
    sasu: 'Engagée par la société',
    eurl: 'Engagée par la société',
  },
  {
    criterion: 'Gestion administrative',
    criterionKey: 'pages.portage-salarial.auto.paragraph.ow2f01',
    portage: 'Déléguée',
    portageKey: 'pages.portage-salarial.auto.paragraph.1m0xuyl',
    micro: 'Gérée par vous',
    microKey: 'pages.portage-salarial.auto.paragraph.1n1ic2e',
    ei: 'Comptabilité et obligations à votre charge',
    company: 'Gérée par vous ou un prestataire',
    companyKey: 'pages.portage-salarial.auto.paragraph.1xbaho7',
    sasu: 'Comptabilité et obligations de société',
    eurl: 'Comptabilité et obligations de société',
  },
  {
    criterion: 'Assurance chômage',
    criterionKey: 'pages.portage-salarial.auto.paragraph.1br0arw',
    portage: 'Selon les conditions du régime salarié',
    portageKey: 'pages.portage-salarial.auto.paragraph.pia7q0',
    micro: 'Non ouverte par la seule micro-entreprise',
    microKey: 'pages.portage-salarial.auto.paragraph.59tsaz',
    ei: 'Non ouverte par la seule activité indépendante',
    company: 'Selon le statut et les conditions',
    companyKey: 'pages.portage-salarial.auto.paragraph.1042o3u',
    sasu: 'Pas d’assurance chômage au seul titre du mandat',
    eurl: 'Pas d’assurance chômage pour le gérant associé',
  },
  {
    criterion: 'Retraite',
    criterionKey: 'pages.portage-salarial.auto.paragraph.rmv8hr',
    portage: 'Régime général',
    portageKey: 'pages.portage-salarial.auto.paragraph.ushv43',
    micro: 'Régime des indépendants',
    microKey: 'pages.portage-salarial.auto.paragraph.1gel5jk',
    ei: 'Régime des indépendants',
    company: 'Selon le statut du dirigeant',
    companyKey: 'pages.portage-salarial.auto.paragraph.1siv809',
    sasu: 'Régime général sur la rémunération',
    eurl: 'Régime des indépendants pour le gérant associé',
  },
  {
    criterion: 'Plafond de chiffre d’affaires',
    criterionKey: 'pages.portage-salarial.auto.paragraph.1xb4bcq',
    portage: 'Aucun plafond propre au portage',
    portageKey: 'pages.portage-salarial.auto.paragraph.b3ry4u',
    micro: 'Plafond du régime micro',
    microKey: 'pages.portage-salarial.auto.paragraph.1ae6yvp',
    ei: 'Pas de plafond propre au statut EI',
    company: 'Aucun plafond propre à la société',
    companyKey: 'pages.portage-salarial.auto.paragraph.1m0a2gs',
    sasu: 'Aucun plafond propre à la SASU',
    eurl: 'Aucun plafond propre à l’EURL',
  },
];

const faqItems = [
  {
    question: 'Qui trouve la mission ?',
    answer: 'Vous. Vous choisissez vos clients, vous négociez votre TJM et vous organisez votre intervention : nous n’entrons pas dans cette relation.',
  },
  {
    question: 'Comment le chiffre d’affaires devient-il un salaire ?',
    answer: 'The Porters facture l’entreprise cliente. Ce qui reste, une fois les frais de gestion et les cotisations déduits, finance votre rémunération.',
  },
  {
    question: 'Que couvrent les frais de gestion ?',
    answer: 'Le contrat, la facturation, la paie, le suivi administratif, la responsabilité civile professionnelle et la garantie financière. Le détail figure sur la page des frais.',
  },
];
---

<PageLayout
  seo={{
    title: pageSeo.portageSalarial.title,
    description: pageSeo.portageSalarial.description,
  }}
  breadcrumbs={[{ label: 'Portage salarial' }]}
>
  <section class="portage-hero" data-motion-scene>
    <div class="portage-hero__visual" aria-hidden="true">
      <img src={portageHeroImage.src} width={portageHeroImage.width} height={portageHeroImage.height} alt="" />
    </div>
    <div class="container portage-hero__inner mx-auto px-6 lg:px-8">
      <div class="portage-hero__copy reveal">
        <p>Comprendre le portage</p>
        <h1>Libre dans la mission.<br /><span>Salarié dans le cadre.</span></h1>
        <p class="portage-hero__lead">
          Vous trouvez vos clients, vous négociez votre TJM. Nous rédigeons les contrats,
          facturons la mission et transformons ce chiffre d’affaires en salaire.
        </p>
        <div class="portage-hero__actions">
          <a href="/simulateur" class="btn btn-primary">Je calcule mon salaire</a>
          <a href="#fonctionnement" class="portage-anchor">Voir comment ça marche <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" id="fonctionnement" data-motion-section>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div class="reveal">
          <p data-motion-item="left" style="--motion-order:0" class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Comment ça marche</p>
          <h2 data-motion-item="left" style="--motion-order:1">Vous, votre client, et nous au milieu.</h2>
          <p data-motion-item="left" style="--motion-order:2" class="mt-5 text-lg leading-relaxed text-porters-black/70">
            Vous réalisez la mission chez votre client. Nous signons le contrat de prestation avec lui,
            nous vous employons, et nous prenons en charge tout l’administratif qui va avec.
          </p>
          <p data-motion-item="left" style="--motion-order:3" class="mb-0 text-porters-black/62">
            Le portage salarial est une relation tripartite encadrée par le Code du travail et la convention
            collective de branche.
          </p>
          <a data-motion-item="pop" style="--motion-order:4" href="/consultants" class="mt-6 inline-flex items-center gap-2 font-semibold text-porters-navy hover:text-porters-gold transition-colors">
            Voir le parcours complet du consultant <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="reveal" data-motion-item="right" style="--motion-order:2">
          <PresidentVideo />
        </div>
        <div class="min-w-0 lg:col-span-2 reveal">
          <TripartiteDiagram />
        </div>
      </div>
    </div>
  </section>

  <section class="section portage-benefits-section" data-motion-section>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal portage-benefits-heading">
        <p data-motion-item="up" style="--motion-order:0" class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Les raisons qui reviennent le plus souvent</p>
        <h2 data-motion-item="up" style="--motion-order:1">Pourquoi tant de consultants IT passent au portage</h2>
      </div>
      <div class="portage-benefits-layout">
        <figure class="portage-benefits-portrait reveal" data-reveal data-motion-item="left" style="--motion-order:2">
          <Image
            src={whyPortageWoman}
            alt="Consultante réfléchissant aux avantages du portage salarial"
            widths={[480, 720, 960]}
            sizes="(max-width: 820px) 82vw, 38vw"
            format="webp"
            quality={90}
            loading="lazy"
          />
        </figure>
        <div class="portage-benefits-stack" aria-label="Quatre bénéfices du portage salarial">
          {benefits.map((benefit, index) => (
            <article class="portage-benefit reveal" data-reveal data-motion-item="right" style={`--reveal-delay:${index * 110}ms;--motion-order:${index + 2}`}>
              <div class="icon-chip"><SiteIcon name={benefit.icon} /></div>
              <div class="portage-benefit__copy">
                <h3>{benefit.title}</h3>
                <p>{benefit.description}</p>
              </div>
              <figure class="portage-benefit__media" style={`--benefit-image-position:${benefit.imagePosition}`}>
                <Image
                  src={benefit.image}
                  alt={benefit.imageAlt}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 720px) 7rem, (max-width: 1100px) 8rem, 9.5rem"
                  format="webp"
                  quality={88}
                  loading="lazy"
                />
              </figure>
            </article>
          ))}
          <div class="portage-benefits-links" data-motion-item="pop" style="--motion-order:7">
            <a href="#frais">Je comprends les frais <span aria-hidden="true">→</span></a>
            <a href="/faq">Je consulte la FAQ <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section portage-comparison brand-ambient-host" data-motion-section>
    <BrandAmbientShapes placement="right" />
    <div class="container mx-auto px-6 lg:px-8" data-comparison>
      <!--
        This introduction is deliberately excluded from positional CMS discovery.
        A removed section previously shifted the generated key and caused an old
        heading to overwrite this one. Its identity and wording must remain tied
        to the comparison table below.
      -->
      <div class="portage-comparison-intro reveal" data-cms-ignore>
        <p data-motion-item="left" style="--motion-order:0" {...cmsAttrs('portage.comparison.eyebrow')}>{cmsText('portage.comparison.eyebrow')}</p>
        <h2 data-motion-item="left" style="--motion-order:1" {...cmsAttrs('portage.comparison.title')} data-cms-rich="true" set:html={cmsText('portage.comparison.title')}></h2>
      </div>
      <div class="portage-comparison-toolbar reveal" data-motion-item="up" style="--motion-order:3">
        <div>
          <small>Comparateur interactif</small>
          <strong>Cliquez sur un statut pour le mettre en avant.</strong>
        </div>
        <div class="portage-comparison-switcher" aria-label="Mettre une option en évidence">
        <button type="button" class="is-active" data-motion-item="chip" style="--motion-order:4" data-comparison-button="portage" aria-pressed="true" {...cmsAttrs('pages.portage-salarial.auto.button.16l7obd')}>Portage salarial</button>
        <button type="button" data-motion-item="chip" style="--motion-order:5" data-comparison-button="micro" aria-pressed="false" {...cmsAttrs('pages.portage-salarial.auto.button.18vlmeq')}>Auto-entrepreneur</button>
        <button type="button" data-motion-item="chip" style="--motion-order:6" data-comparison-button="ei" aria-pressed="false" {...cmsAttrs('portage.comparison.status.ei')}>Entreprise individuelle</button>
        <span class="portage-comparison-switcher__group" {...cmsAttrs('pages.portage-salarial.auto.button.1fu6q8j')}>Création de société</span>
        <button type="button" data-motion-item="chip" style="--motion-order:7" data-comparison-button="sasu" aria-pressed="false" {...cmsAttrs('portage.comparison.status.sasu')}>SASU</button>
        <button type="button" data-motion-item="chip" style="--motion-order:8" data-comparison-button="eurl" aria-pressed="false" {...cmsAttrs('portage.comparison.status.eurl')}>EURL</button>
        </div>
      </div>
      <div class="portage-table-scene">
        <figure
          class="portage-table-man"
          data-table-man
          data-cms-key="pages.portage-salarial.media.table-man"
          data-cms-route="/portage-salarial"
          data-cms-element-type="paragraph"
          data-cms-layout-target="true"
          data-cms-layout-value='{"x":0,"y":0,"scale":100}'
          aria-label="Illustration mobile : homme appuyé sur le comparateur"
        >
          <Image
            src={tableMan}
            alt=""
            widths={[300, 420, 560]}
            sizes="(max-width: 720px) 11rem, (max-width: 1100px) 14rem, 16.5rem"
            format="webp"
            quality={92}
            loading="lazy"
          />
        </figure>
        <div class="portage-table-wrap reveal" data-motion-item="wipe" style="--motion-order:6" data-comparison-table data-highlight="portage">
          <table class="portage-table">
            <thead>
              <tr style="--row-order:0">
                <th scope="col" {...cmsAttrs('pages.portage-salarial.auto.paragraph.1p4ec6p')}>Critère</th>
                <th scope="col" class="is-portage" {...cmsAttrs('pages.portage-salarial.auto.paragraph.1id3tdl')}>Portage salarial</th>
                <th scope="col" {...cmsAttrs('pages.portage-salarial.auto.paragraph.q8ijez')}>Auto-entrepreneur</th>
                <th scope="col" {...cmsAttrs('portage.comparison.status.ei')}>Entreprise individuelle</th>
                <th scope="col" {...cmsAttrs('portage.comparison.status.sasu')}>SASU</th>
                <th scope="col" {...cmsAttrs('portage.comparison.status.eurl')}>EURL</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row, index) => (
                <tr style={`--row-order:${index + 1}`}>
                  <th scope="row" {...cmsAttrs(row.criterionKey)}>{row.criterion}</th>
                  <td class="is-portage" {...cmsAttrs(row.portageKey)}>{row.portage}</td>
                  <td {...cmsAttrs(row.microKey)}>{row.micro}</td>
                  <td {...cmsAttrs(`portage.comparison.ei.${index}`)}>{row.ei}</td>
                  <td {...cmsAttrs(`portage.comparison.sasu.${index}`)}>{row.sasu}</td>
                  <td {...cmsAttrs(`portage.comparison.eurl.${index}`)}>{row.eurl}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
        <details class="portage-company-reference reveal" data-motion-item="up" style="--motion-order:8">
          <summary><span>Création de société</span><strong>Voir les repères communs à la SASU et à l’EURL</strong><b aria-hidden="true">+</b></summary>
          <div>
            {comparisonRows.map((row) => <p><small data-cms-ignore>{row.criterion}</small><span {...cmsAttrs(row.companyKey)}>{row.company}</span></p>)}
          </div>
        </details>
        <p class="portage-comparison-note" data-cms-ignore>
          Repères généraux à confirmer selon votre situation. Sources officielles :
          <a href="https://entreprendre.service-public.fr/vosdroits/F37396" target="_blank" rel="noopener noreferrer">comparatif des formes</a>,
          <a href="https://entreprendre.service-public.fr/vosdroits/F38152" target="_blank" rel="noopener noreferrer">protection sociale du dirigeant</a>.
        </p>
    </div>
  </section>

  <!-- Existing CMS keys are pinned below: moving these sections preserves published copy. -->
  <section class="section management-fees" id="frais" data-motion-section data-management-fees>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="management-fees__intro reveal">
        <div data-motion-item="left" style="--motion-order:0">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold" {...cmsAttrs('pages.portage-salarial.auto.paragraph.gdhka1')} data-cms-rich="true">Frais de gestion</p>
          <h2 {...cmsAttrs('pages.portage-salarial.auto.heading.1qnyctv')} data-cms-rich="true">Ce que couvrent nos frais</h2>
          <p class="mt-5 text-porters-black/66" {...cmsAttrs('pages.portage-salarial.auto.paragraph.9f1zwi')} data-cms-rich="true">
            Nos frais de gestion sont prélevés sur votre chiffre d’affaires mensuel et couvrent
            sept prestations. Votre simulation en donne le montant avant toute signature.
          </p>
        </div>
        <aside class="management-fees__promise" data-motion-item="pop" style="--motion-order:1" data-cms-ignore aria-label="Engagement de clarté">
          <SiteIcon name="spark" class="h-6 w-6" />
          <span>Pas de frais cachés<br /><strong>Tout est expliqué avant de signer</strong></span>
        </aside>
      </div>
      <div class="management-fees__grid" aria-label="Prestations couvertes par les frais">
        {managementFees.map((item, index) => (
          <button type="button" class:list={['management-fees__card', { 'management-fees__card--featured': index === 0 }]} data-fee-card data-fee-index={index} aria-pressed={index === 0 ? 'true' : 'false'} data-motion-item="pop" style={`--motion-order:${index + 2}`}>
            <div class="management-fees__card-top" aria-hidden="true" data-cms-ignore>
              <span class="management-fees__icon"><SiteIcon name={(['chart', 'briefcase', 'user', 'clipboard', 'shield', 'compass', 'scale'] as const)[index]} class="h-6 w-6" /></span>
            </div>
            <strong {...cmsAttrs(managementFeeCmsKeys[index][0])} data-cms-rich="true" class="management-fees__title">{item.title}</strong>
            <span {...cmsAttrs(managementFeeCmsKeys[index][1])} data-cms-rich="true" class="management-fees__description">{item.text}</span>
          </button>
        ))}
      </div>
      <div class="management-fees__dots" data-cms-ignore aria-label="Choisir une prestation">
        {managementFees.map((item, index) => <button type="button" data-fee-dot data-fee-index={index} class:list={{ 'is-active': index === 0 }} aria-label={`Afficher ${item.title}`} aria-pressed={index === 0 ? 'true' : 'false'}><span></span></button>)}
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]" id="parrainage">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center">
        <div class="reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold" {...cmsAttrs('pages.portage-salarial.auto.paragraph.8of6qw')} data-cms-rich="true">Programme de parrainage</p>
          <h2 {...cmsAttrs('pages.portage-salarial.auto.heading.1xfppdk')} data-cms-rich="true">Vous connaissez quelqu’un à qui cela servirait&nbsp;?</h2>
