---
import PageLayout from '../layouts/PageLayout.astro';
import SiteIcon from '../components/ui/SiteIcon.astro';
import TripartiteDiagram from '../components/ui/TripartiteDiagram.astro';
import { pageSeo } from '../data/seo.data';
import portageHeroImage from '../../images/advisor-discussion.webp';

const benefits = [
  {
    icon: 'rocket',
    title: 'Votre autonomie',
    description: 'Vous choisissez vos missions, négociez votre TJM et organisez votre intervention.',
  },
  {
    icon: 'shield',
    title: 'Votre protection sociale',
    description: 'Régime général, prévoyance, retraite, congés payés, assurance chômage et mutuelle collective.',
  },
  {
    icon: 'clipboard',
    title: 'Votre gestion déléguée',
    description: 'Contrats, facturation, paie et déclarations sociales sont pris en charge.',
  },
  {
    icon: 'calculator',
    title: 'Votre trésorerie',
    description: 'Un compte dédié peut servir à lisser une paie, financer des congés ou préparer une fin de contrat.',
  },
] as const;

const faqItems = [
  {
    question: 'À qui s’adresse le portage salarial ?',
    answer: 'Aux professionnels autonomes qui réalisent des prestations intellectuelles et négocient eux-mêmes leurs missions. Les professions réglementées et les services à la personne en sont exclus.',
  },
  {
    question: 'Qui signe quoi ?',
    answer: 'Vous signez un contrat de travail avec The Porters. L’entreprise cliente signe un contrat de prestation avec The Porters. Vous conservez la relation opérationnelle avec le client.',
  },
  {
    question: 'Comment mon chiffre d’affaires devient-il un salaire ?',
    answer: 'The Porters facture votre client. Après déduction des frais de gestion, des cotisations et des éléments applicables à votre situation, le solde finance votre rémunération.',
  },
  {
    question: 'Puis-je travailler en France ou à l’étranger ?',
    answer: 'Oui. La mission peut être réalisée en France ou à l’étranger, pour un client français ou étranger, sur site ou à distance.',
  },
];
---

<PageLayout
  seo={{
    title: pageSeo.portageSalarial.title,
    description: pageSeo.portageSalarial.description,
  }}
  breadcrumbs={[{ label: 'Portage salarial' }]}
>
  <section class="relative overflow-hidden bg-porters-navy text-porters-white">
    <img
      src={portageHeroImage.src}
      width={portageHeroImage.width}
      height={portageHeroImage.height}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(25,43,99,0.97)_0%,rgba(25,43,99,0.88)_46%,rgba(25,43,99,0.3)_100%)]"></div>
    <div class="container relative mx-auto px-6 py-24 lg:px-8 lg:py-32">
      <div class="max-w-2xl reveal">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Le portage salarial</p>
        <h1 class="text-porters-white">Libre dans la mission. Salarié dans le cadre.</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-porters-white/80">
          Vous trouvez vos clients et négociez votre TJM. The Porters met en place les contrats,
          facture la mission et transforme votre chiffre d’affaires en salaire.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/simulateur" class="btn btn-gold">Simuler mes revenus</a>
          <a href="/consultants" class="btn btn-white">Voir mon quotidien</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(18rem,0.55fr)] lg:items-center">
        <div class="reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Le mécanisme</p>
          <h2>Trois acteurs. Deux contrats. Une mission.</h2>
          <p class="mt-5 text-lg leading-relaxed text-porters-black/70">
            Le portage salarial relie le consultant, l’entreprise cliente et The Porters. Vous pilotez
            la mission. Nous portons le cadre salarial, contractuel et administratif.
          </p>
          <p class="text-porters-black/65">
            Le dispositif est encadré par le Code du travail, l’accord national interprofessionnel de 2008
            et l’ordonnance du 2&nbsp;avril&nbsp;2015.
          </p>
        </div>
        <div class="reveal"><TripartiteDiagram /></div>
      </div>
    </div>
  </section>

  <section class="section bg-porters-navy/[0.03]">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">Ce que chacun garde</p>
        <h2>L’autonomie d’un indépendant, le cadre d’un salarié</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {benefits.map((benefit) => (
          <article class="card reveal">
            <div class="icon-chip mb-5"><SiteIcon name={benefit.icon} /></div>
            <h3 class="mb-2 text-lg">{benefit.title}</h3>
            <p class="mb-0 text-sm leading-relaxed text-porters-black/65">{benefit.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="mb-10 text-center reveal">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-porters-gold">En pratique</p>
          <h2>Les quatre réponses utiles avant de choisir</h2>
        </div>
        <div class="space-y-4 reveal">
          {faqItems.map((faq) => (
            <details class="group rounded-lg border border-porters-navy/10">
              <summary class="flex cursor-pointer items-center justify-between p-5 font-heading font-semibold text-porters-navy">
                <span>{faq.question}</span>
                <span class="ml-4 text-xl text-porters-gold transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="px-5 pb-5 text-porters-black/68"><p class="mb-0">{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-porters-navy py-16 text-porters-white">
    <div class="container mx-auto flex flex-col gap-7 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div class="max-w-2xl reveal">
        <h2 class="mb-2 text-porters-white">Votre mission est prête&nbsp;? Chiffrons le cadre.</h2>
        <p class="mb-0 text-porters-white/65">Partez de votre TJM et de vos jours facturés pour obtenir une première estimation.</p>
      </div>
      <a href="/simulateur" class="btn btn-gold shrink-0">Simuler mes revenus</a>
    </div>
  </section>
</PageLayout>
