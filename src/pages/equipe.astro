---
import PageLayout from '../layouts/PageLayout.astro';
import { pageSeo } from '../data/seo.data';

const functions = [
  {
    title: 'Conseil et cadrage',
    description: 'Votre situation, votre statut actuel, votre TJM cible. On chiffre avant de contractualiser.',
  },
  {
    title: 'Contrats et conformité',
    description: 'Les deux contrats, qui s’engage sur quoi, et les contraintes de sécurité ou de confidentialité du client.',
  },
  {
    title: 'Facturation et paie',
    description: 'Votre compte rendu d’activité, la facture au client, vos frais, votre bulletin. Deux sessions de paie par mois.',
  },
  {
    title: 'Suivi de mission',
    description: 'Points d’avancement à une fréquence définie au départ, avec un relais identifié si votre interlocuteur est absent.',
  },
];
---

<PageLayout
  seo={pageSeo.equipe}
  breadcrumbs={[{ label: 'The Porters', href: '/qui-sommes-nous' }, { label: 'Notre équipe' }]}
>
  <section class="section pt-8 lg:pt-16 pb-20">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <p class="text-sm font-semibold uppercase tracking-wider text-porters-gold mb-4">L’équipe</p>
        <h1 class="mb-4">Une personne connaît votre dossier. <span class="gold-underline">Toujours la même.</span></h1>
        <p class="text-porters-black/60 max-w-2xl mx-auto text-lg">
          Quatre fonctions, un interlocuteur unique par consultant, et un binôme derrière lui pour qu’aucun suivi ne dépende d’une seule personne.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        {functions.map((item) => (
          <div class="card p-7 reveal">
            <h2 class="mb-3 text-xl text-porters-navy">{item.title}</h2>
            <p class="mb-0 text-sm leading-relaxed text-porters-black/60">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-porters-navy/[0.02] border-y border-porters-navy/5 py-16">
    <div class="container mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="mb-6">Vous voulez rejoindre l’équipe&nbsp;?</h2>
      <p class="text-porters-black/60 max-w-xl mx-auto mb-8">
        Les postes ouverts sont publiés sur notre espace HelloWork.
      </p>
      <a href="/recrutement" class="btn btn-primary">
        Voir nos offres
      </a>
    </div>
  </section>
</PageLayout>
