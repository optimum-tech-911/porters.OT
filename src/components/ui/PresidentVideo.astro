---
/**
 * The president's message. Used on the home page and on /portage-salarial, so
 * the markup and the player settings stay identical in both places.
 *
 * No autoplay: the file is 14 MB and `preload="metadata"` keeps it out of the
 * LCP path while still showing a first frame.
 */
import presidentVideo from '../../../video president porters (1).mp4';

interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<!--
  The reveal lives here, not at the call site: `reveal-up` alone sets opacity 0,
  and only `[data-reveal]` or `.reveal` is picked up by the scroll observer in
  BaseLayout. Pairing them in the component means no caller can leave the video
  permanently invisible.
-->
<figure
  data-reveal
  class:list={['reveal-up overflow-hidden rounded-lg border border-porters-navy/10 bg-white shadow-[0_18px_50px_rgba(25,43,99,0.06)]', className]}
>
  <figcaption class="flex items-start justify-between gap-4 border-b border-porters-navy/10 px-5 py-4">
    <div>
      <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-porters-gold">Le mot du président</p>
      <h3 class="font-heading text-base font-semibold text-porters-navy">Une vision du portage, au plus près des talents</h3>
    </div>
    <span class="mt-1 shrink-0 text-porters-gold" aria-hidden="true">▶</span>
  </figcaption>
  <video
    data-president-video
    class="block h-auto w-full bg-porters-navy"
    controls
    preload="metadata"
    playsinline
    aria-label="Le mot du président de The Porters"
    src={presidentVideo}
  ></video>
</figure>

<script>
  document.querySelectorAll<HTMLVideoElement>('[data-president-video]').forEach((video) => {
    const startAt = 2;
    const seekToOpening = () => {
      if (video.duration > startAt && video.currentTime < startAt - 0.1) video.currentTime = startAt;
    };
    video.addEventListener('loadedmetadata', seekToOpening, { once: true });
    video.addEventListener('play', seekToOpening);
    if (video.readyState >= 1) seekToOpening();
  });
</script>
