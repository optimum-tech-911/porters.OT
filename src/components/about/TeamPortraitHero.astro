---
const people = [
  {
    id: 'ambre',
    name: 'Ambre Lambert',
    role: 'Directrice commerciale IT',
    eyebrow: 'Entreprises',
    image: '/images/team/ambre-lambert.png',
    optimizedImage: '/images/team/ambre-lambert-800.avif',
    linkedin: 'https://fr.linkedin.com/in/ambrelambert',
  },
  {
    id: 'eric',
    name: 'Éric Bensaid',
    role: 'Fondateur',
    eyebrow: 'Vision',
    image: '/images/team/eric-bensaid.png',
    optimizedImage: '/images/team/eric-bensaid-800.avif',
    linkedin: 'https://fr.linkedin.com/in/eric-bensaid-73573816',
  },
  {
    id: 'lisa',
    name: 'Lisa Delrieu',
    role: 'Chargée de recrutement',
    eyebrow: 'Consultants',
    image: '/images/team/lisa-delrieu.png',
    optimizedImage: '/images/team/lisa-delrieu-800.avif',
    linkedin: 'https://fr.linkedin.com/in/lisa-delrieu',
  },
];
---

<div class="team-portrait-hero" data-team-portrait-hero>
  <div class="team-portrait-shape" aria-hidden="true"></div>
  <button
    class="team-portrait-search"
    type="button"
    data-assistant-open
    aria-label="Ouvrir l’assistant The Porters"
  >
    <span>The Porters pour vous.</span>
    <b>⌕</b>
  </button>
  <div class="team-portrait-lines" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="team-portrait-cards" aria-label="Les interlocuteurs The Porters">
    {people.map((person) => (
      <a
        class:list={['team-portrait-card', `team-portrait-card--${person.id}`]}
        href={person.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-team-portrait-card
        aria-label={`${person.name}, ${person.role} — voir son profil LinkedIn`}
      >
        <span class="team-portrait-image">
          <picture>
            <source srcset={person.optimizedImage} type="image/avif" />
            <img src={person.image} alt={person.name} width="800" height="800" loading="eager" decoding="async" />
          </picture>
        </span>
        <span class="team-portrait-copy">
          <small>{person.eyebrow}</small>
          <strong>{person.name}</strong>
          <em>{person.role}</em>
          <span class="team-portrait-link">LinkedIn <b aria-hidden="true">↗</b></span>
        </span>
      </a>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-assistant-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('tp:assistant-request-open', {
        detail: { source: 'team-search' },
      }));
    });
  });

  document.querySelectorAll<HTMLElement>('[data-team-portrait-card]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      if ((event as PointerEvent).pointerType !== 'mouse') return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--portrait-tilt-x', `${((event.clientY - rect.top) / rect.height - .5) * -4}deg`);
      card.style.setProperty('--portrait-tilt-y', `${((event.clientX - rect.left) / rect.width - .5) * 5}deg`);
      card.style.setProperty('--portrait-glow-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      card.style.setProperty('--portrait-glow-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    });
    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--portrait-tilt-x');
      card.style.removeProperty('--portrait-tilt-y');
      card.style.removeProperty('--portrait-glow-x');
      card.style.removeProperty('--portrait-glow-y');
    });
  });
</script>

<style>
  .team-portrait-hero,
  .team-portrait-hero * {
    box-sizing: border-box;
  }

  .team-portrait-hero {
    --team-center: var(--team-center-position, 50%);
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    isolation: isolate;
    overflow: visible;
  }

  .team-portrait-hero::before {
    position: absolute;
    top: 2rem;
    right: 2rem;
    width: 27rem;
    height: 27rem;
    border: 1px solid rgba(32, 52, 64, 0.08);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 38%, rgba(32, 52, 64, 0.13), rgba(32, 52, 64, 0.035) 58%, transparent 72%);
    content: '';
    pointer-events: none;
    animation: portrait-orbit 16s ease-in-out infinite alternate;
  }

  .team-portrait-hero::after {
    position: absolute;
    top: -12rem;
    left: 2rem;
    width: 29rem;
    height: 29rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 62%, rgba(198, 164, 90, 0.22) 0 52%, rgba(198, 164, 90, 0) 73%);
    content: '';
    pointer-events: none;
  }

  .team-portrait-shape {
    position: absolute;
    top: -10rem;
    left: calc(var(--team-center) - 12rem);
    width: 24rem;
    height: 42rem;
    border-radius: 48% 52% 43% 57% / 35% 42% 58% 65%;
    background: linear-gradient(180deg, rgba(247, 235, 205, 0) 0, rgba(247, 235, 205, 0.5) 22%, rgba(198, 164, 90, 0.28) 100%);
    transform: rotate(-13deg);
    animation: portrait-shape-drift 12s ease-in-out infinite alternate;
  }

  .team-portrait-search {
    position: absolute;
    top: clamp(2.2rem, 7vh, 4.2rem);
    left: var(--team-center);
    z-index: 6;
    display: flex;
    width: min(76%, 25rem);
    min-height: 3.4rem;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(32, 52, 64, 0.14);
    border-radius: 999px;
    padding: 0 1.1rem 0 1.35rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 13px 30px rgba(32, 52, 64, 0.16);
    color: #203440;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.83rem;
    font-weight: 700;
    transform: translateX(-50%);
    transition: border-color 220ms ease, box-shadow 260ms ease, transform 260ms cubic-bezier(.16,1,.3,1);
  }

  .team-portrait-search:hover,
  .team-portrait-search:focus-visible {
    border-color: rgba(198, 164, 90, 0.78);
    outline: none;
    box-shadow: 0 18px 38px rgba(32, 52, 64, 0.21), 0 0 0 4px rgba(198, 164, 90, 0.13);
    transform: translateX(-50%) translateY(-3px) scale(1.015);
  }

  .team-portrait-search:active { transform: translateX(-50%) scale(.985); }

  .team-portrait-search b {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: #203440;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 500;
    transition: background-color 220ms ease, color 220ms ease, transform 260ms cubic-bezier(.16,1,.3,1);
  }

  .team-portrait-search:hover b,
  .team-portrait-search:focus-visible b { background:#c6a45a;color:#203440;transform:rotate(-9deg) scale(1.05); }

  .team-portrait-lines span {
    position: absolute;
    top: clamp(5.6rem, calc(7vh + 3.4rem), 7.6rem);
    left: var(--team-center);
    z-index: 1;
    width: 2px;
    height: 10rem;
    background: repeating-linear-gradient(to bottom, rgba(32, 52, 64, 0.48) 0 3px, transparent 3px 8px);
    transform-origin: top;
  }

  .team-portrait-lines span:first-child { transform: rotate(-58deg); }
  .team-portrait-lines span:nth-child(2) { transform: rotate(0); }
  .team-portrait-lines span:last-child { transform: rotate(58deg); }

  .team-portrait-card {
    --portrait-tilt-x: 0deg;
    --portrait-tilt-y: 0deg;
    position: absolute;
    z-index: 2;
    display: grid;
    width: clamp(11rem, 15vw, 13.2rem);
    gap: 0.55rem;
    border: 1px solid rgba(32, 52, 64, 0.14);
    border-radius: 1.15rem;
    padding: 0.55rem;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 20px 45px rgba(32, 52, 64, 0.19);
    color: #203440;
    cursor: pointer;
    font: inherit;
    text-align: left;
    will-change: transform;
    animation: portrait-card-float 4.2s ease-in-out infinite;
    transition: transform 220ms cubic-bezier(.2,.8,.2,1), border-color 180ms ease, box-shadow 220ms ease;
  }

  .team-portrait-card::before {
    position: absolute;
    z-index: 2;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--portrait-glow-x, 50%) var(--portrait-glow-y, 50%), rgba(255,255,255,.42), transparent 38%);
    content: '';
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .team-portrait-card::after {
    position: absolute;
    z-index: -1;
    inset: -0.45rem;
    border: 1px solid rgba(198, 164, 90, 0.42);
    border-radius: 1.5rem;
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96);
    transition: opacity 220ms ease, transform 360ms cubic-bezier(.16,1,.3,1);
  }

  .team-portrait-card--ambre { top: clamp(10.5rem, 23vh, 13rem); left: calc(var(--team-center) - 22rem); transform: rotate(-2deg); animation-delay: -1.6s; animation-duration: 4.6s; }
  .team-portrait-card--eric { top: clamp(7.5rem, 16vh, 9.5rem); left: var(--team-center); z-index: 5; width: clamp(13rem, 19vw, 16rem); transform: translateX(-50%); animation-delay: -.7s; animation-duration: 3.8s; }
  .team-portrait-card--lisa { top: clamp(10.5rem, 23vh, 13rem); left: calc(var(--team-center) + 9rem); transform: rotate(2deg); animation-delay: -2.8s; animation-duration: 4.9s; }

  .team-portrait-card:hover,
  .team-portrait-card:focus-visible,
  .team-portrait-card:active {
    z-index: 8;
    border-color: #c6a45a;
    box-shadow: 0 32px 68px rgba(3, 13, 19, 0.3), 0 0 0 3px rgba(198, 164, 90, 0.16);
    outline: none;
    animation-play-state: paused;
  }

  .team-portrait-card:hover::before,
  .team-portrait-card:focus-visible::before { opacity: 1; }

  .team-portrait-card:hover::after,
  .team-portrait-card:focus-visible::after { opacity: 1; transform: scale(1); }

  .team-portrait-card--ambre:hover,
  .team-portrait-card--ambre:focus-visible,
  .team-portrait-card--ambre:active { transform: perspective(700px) rotateX(var(--portrait-tilt-x)) rotateY(var(--portrait-tilt-y)) rotate(-1deg) translateY(-13px) scale(1.045); }
  .team-portrait-card--eric:hover,
  .team-portrait-card--eric:focus-visible,
  .team-portrait-card--eric:active { transform: translateX(-50%) perspective(700px) rotateX(var(--portrait-tilt-x)) rotateY(var(--portrait-tilt-y)) translateY(-13px) scale(1.045); }
  .team-portrait-card--lisa:hover,
  .team-portrait-card--lisa:focus-visible,
  .team-portrait-card--lisa:active { transform: perspective(700px) rotateX(var(--portrait-tilt-x)) rotateY(var(--portrait-tilt-y)) rotate(1deg) translateY(-13px) scale(1.045); }

  .team-portrait-image {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.05;
    border-radius: 0.85rem;
    background: #f3efe6;
    overflow: hidden;
  }

  .team-portrait-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 33%;
    transition: transform 420ms cubic-bezier(.2,.8,.2,1);
  }

  .team-portrait-image picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .team-portrait-card:hover img,
  .team-portrait-card:focus-visible img,
  .team-portrait-card:active img { transform: scale(1.065); }

  .team-portrait-copy { display: grid; padding: 0.22rem 0.28rem 0.35rem; }
  .team-portrait-copy small { color: #a98238; font-size: 0.55rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  .team-portrait-copy strong { margin-top: 0.22rem; font-size: 0.92rem; line-height: 1.15; }
  .team-portrait-copy em { margin-top: 0.16rem; color: rgba(32, 52, 64, 0.58); font-size: 0.64rem; font-style: normal; }
  .team-portrait-link { display:flex;align-items:center;justify-content:space-between;margin-top:.5rem;border-top:1px solid rgba(32,52,64,.1);padding-top:.45rem;color:#9a762e;font-size:.55rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;opacity:.68;transition:opacity 180ms ease,color 180ms ease; }
  .team-portrait-link b { font-size:.8rem;transition:transform 220ms cubic-bezier(.2,.8,.2,1); }
  .team-portrait-card:hover .team-portrait-link,.team-portrait-card:focus-visible .team-portrait-link { color:#203440;opacity:1; }
  .team-portrait-card:hover .team-portrait-link b,.team-portrait-card:focus-visible .team-portrait-link b { transform:translate(.16rem,-.16rem); }

  @keyframes portrait-card-float {
    0%, 100% { translate: 0 0; }
    45% { translate: 0 -0.9rem; }
    62% { translate: 0 -0.72rem; }
  }

  @keyframes portrait-orbit {
    from { transform: translate3d(0, 0, 0) scale(0.96); }
    to { transform: translate3d(-1rem, 1.25rem, 0) scale(1.04); }
  }

  @keyframes portrait-shape-drift {
    from { transform: rotate(-13deg) translate3d(0, 0, 0); }
    to { transform: rotate(-8deg) translate3d(1rem, 0.75rem, 0); }
  }

  @media (max-width: 780px) {
    .team-portrait-hero { min-height: 34rem; }
    .team-portrait-search { width: min(82%, 23rem); }
    .team-portrait-card { width: 9.5rem; }
    .team-portrait-card--ambre { top: 13rem; left: 2%; }
    .team-portrait-card--eric { top: 7.2rem; width: 13rem; }
    .team-portrait-card--lisa { top: 13rem; right: 2%; left: auto; }
  }

  @media (max-width: 520px) {
    .team-portrait-hero { min-height: 30rem; }
    .team-portrait-hero::before { top: 6rem; right: -13rem; }
    .team-portrait-shape { top: -7rem; left: 25%; width: 18rem; }
    .team-portrait-search { top: 1rem; min-height: 3rem; font-size: 0.7rem; }
    .team-portrait-lines { display: none; }
    .team-portrait-card { width: 8.25rem; padding: 0.4rem; }
    .team-portrait-card--ambre { top: 14.5rem; left: 0.65rem; }
    .team-portrait-card--eric { top: 6rem; width: 10.5rem; }
    .team-portrait-card--lisa { top: 14.5rem; right: 0.65rem; left: auto; }
    .team-portrait-copy strong { font-size: 0.72rem; }
    .team-portrait-copy em { font-size: 0.55rem; }
  }

  @media (max-width: 420px) {
    .team-portrait-card { width: 6.5rem; }
    .team-portrait-card--ambre { left: 0.5rem; }
    .team-portrait-card--eric { width: 8rem; }
    .team-portrait-card--lisa { right: 0.5rem; }
    .team-portrait-copy small { font-size: 0.48rem; }
    .team-portrait-copy strong { font-size: 0.65rem; }
    .team-portrait-copy em { font-size: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-portrait-card,
    .team-portrait-image img,
    .team-portrait-hero::before,
    .team-portrait-shape { animation: none; transition: none; }
  }
</style>
