---
// Every page keeps its rendered copy as an SEO-safe fallback. The runtime adds
// stable keys to unregistered visible text and then performs one request for
// the current route plus the shared header/footer content.
//
// A block whose children are only inline decoration is claimed whole, so an
// editor sees one sentence rather than one field per text node. Those blocks
// store inline HTML; everything else keeps the per-text-node wrappers.
---

<script>
  import { supabase } from '../../lib/supabase';
  import type { CmsFormat } from '../../cms/content';
  import { sanitizeInlineHtml } from '../../cms/inline-html';
  import { discoverEditableText } from '../../cms/discover';

  type PublishedBlock = {
    content_key: string;
    route_path: string;
    element_type: string;
    published_content: string;
    published_format: CmsFormat;
    published_at: string;
  };

  type EditorBlock = PublishedBlock & {
    id: string;
    fallback_content: string;
    draft_content: string;
    draft_format: CmsFormat;
    status: 'draft' | 'published';
    published_version: number;
    updated_at: string;
  };

  const GLOBAL_ROUTE = '/_global';
  const pageRoute = window.location.pathname.replace(/\/$/, '') || '/';
  const editorMode = new URLSearchParams(window.location.search).get('cms-editor') === '1';
  const blockByKey = new Map<string, PublishedBlock | EditorBlock>();
  let previewState: 'draft' | 'published' = editorMode ? 'draft' : 'published';

  const preMergeFragments = discoverEditableText(document, pageRoute, GLOBAL_ROUTE);

  /**
   * True when a stored value is a pre-merge fragment: it holds exactly this
   * block's first text fragment while the block itself carries markup. Rendering
   * it would drop the rest of the sentence along with its accent.
   *
   * This deliberately ignores published_version. A block published before blocks
   * were merged stored a fragment, and that publish was not a decision to
   * truncate — it predates the choice existing. The seed migration cannot repair
   * those rows either, because it preserves anything a human published. So the
   * exact-fragment match is the only signal, and it is a narrow one: the stored
   * value must equal the first fragment character for character.
   *
   * The cost is that an editor cannot shorten a decorated sentence to exactly its
   * own first fragment — any other wording applies normally. That is a better
   * trade than silently losing words on a live page.
   *
   * Only consulted on the public site. In the editor an administrator must see
   * exactly what is stored, including a value that still needs migrating.
   */
  function isPreMergeRow(key: string, content: string) {
    return !editorMode && preMergeFragments.get(key) === content.trim();
  }

  const formatAttributes = ['size', 'weight', 'alignment', 'color', 'line-height'] as const;

  function applyFormat(node: HTMLElement, format: CmsFormat = {}) {
    formatAttributes.forEach((attribute) => node.removeAttribute(`data-cms-format-${attribute}`));
    if (format.size && format.size !== 'default') node.dataset.cmsFormatSize = format.size;
    if (format.weight && format.weight !== 'default') node.dataset.cmsFormatWeight = format.weight;
    if (format.alignment && format.alignment !== 'default') node.dataset.cmsFormatAlignment = format.alignment;
    if (format.color && format.color !== 'default') node.dataset.cmsFormatColor = format.color;
    if (format.lineHeight && format.lineHeight !== 'default') node.dataset.cmsFormatLineHeight = format.lineHeight;
  }

  function applyValue(key: string, content: string, format: CmsFormat) {
    document.querySelectorAll<HTMLElement>('[data-cms-key]').forEach((node) => {
      if (node.dataset.cmsKey !== key) return;
      if (node.dataset.cmsLayoutTarget === 'true') {
        try {
          const layout = JSON.parse(content) as { x?: number; y?: number; scale?: number };
          const x = Math.max(-800, Math.min(800, Number(layout.x) || 0));
          const y = Math.max(-800, Math.min(800, Number(layout.y) || 0));
          const scale = Math.max(40, Math.min(220, Number(layout.scale) || 100));
          node.style.setProperty('--cms-layout-x', `${x}px`);
          node.style.setProperty('--cms-layout-y', `${y}px`);
          node.style.setProperty('--cms-layout-scale', String(scale / 100));
          node.dataset.cmsLayoutValue = JSON.stringify({ x, y, scale });
        } catch {
          // Keep the authored fallback position if a legacy value is malformed.
        }
        return;
      }
      if (node.dataset.cmsRich === 'true') {
        if (isPreMergeRow(key, content)) return;
        // Sanitized on the way in as well as on the way out: the stored value is
        // admin-authored, but it still reaches every visitor's page.
        node.innerHTML = sanitizeInlineHtml(content);
      } else {
        const leading = node.dataset.cmsAuto === 'true' ? node.dataset.cmsLeading || '' : '';
        const trailing = node.dataset.cmsAuto === 'true' ? node.dataset.cmsTrailing || '' : '';
        node.textContent = `${leading}${content}${trailing}`;
      }
      applyFormat(node, format);

      const mirrorAttribute = node.dataset.cmsMirrorAttribute;
      if (mirrorAttribute) node.closest<HTMLElement>('[data-offer-step]')?.setAttribute(mirrorAttribute, content);
    });
  }

  function applyBlock(block: PublishedBlock | EditorBlock) {
    const draft = previewState === 'draft' && 'draft_content' in block;
    applyValue(
      block.content_key,
      draft ? block.draft_content : block.published_content,
      draft ? block.draft_format : block.published_format,
    );
  }

  function richKeys() {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-cms-rich="true"]'))
      .map((node) => node.dataset.cmsKey || '')
      .filter(Boolean);
  }

  function visibleKeys() {
    return new Set(
      Array.from(document.querySelectorAll<HTMLElement>('[data-cms-key]'))
        .map((node) => node.dataset.cmsKey || '')
        .filter(Boolean),
    );
  }

  function markActive(key: string) {
    document.querySelectorAll('.cms-editor-active').forEach((node) => node.classList.remove('cms-editor-active'));
    document.querySelectorAll(`[data-cms-key="${CSS.escape(key)}"]`).forEach((node) => node.classList.add('cms-editor-active'));
  }

  function announceReady() {
    if (!editorMode) return;
    document.body.classList.add('cms-editor-mode');
    document.dispatchEvent(new CustomEvent('cms:editor-ready'));
    const visible = visibleKeys();
    document.querySelectorAll<HTMLElement>('[data-cms-layout-target="true"]').forEach((node) => {
      const key = node.dataset.cmsKey;
      if (!key || blockByKey.has(key)) return;
      const content = node.dataset.cmsLayoutValue || '{"x":0,"y":0,"scale":100}';
      blockByKey.set(key, {
        id: `layout:${key}`,
        content_key: key,
        route_path: node.dataset.cmsRoute || pageRoute,
        element_type: 'paragraph',
        fallback_content: content,
        draft_content: content,
        published_content: content,
        draft_format: {},
        published_format: {},
        status: 'draft',
        published_version: 0,
        updated_at: new Date(0).toISOString(),
        published_at: new Date(0).toISOString(),
      } as EditorBlock);
    });
    window.parent.postMessage({
      type: 'cms:ready',
      route: pageRoute,
      // Database orphans and internal configuration rows can share a route but
      // are not editable on the rendered page. Keep them out of the visual UI.
      blocks: Array.from(blockByKey.values()).filter((block) => visible.has(block.content_key)),
      richKeys: richKeys(),
    }, window.location.origin);
  }

  async function createMissingVisibleBlocks() {
    const entries = new Map<string, {
      key: string;
      route: string;
      type: string;
      content: string;
    }>();

    // Discovery runs against the untouched server-rendered fallback before any
    // database value is applied. That DOM is therefore the safest recovery
    // source and avoids shipping the 500 KB generated registry to the editor.
    document.querySelectorAll<HTMLElement>('[data-cms-key]').forEach((node) => {
      const key = node.dataset.cmsKey;
      if (!key || entries.has(key) || blockByKey.has(key)) return;
      const route = node.dataset.cmsRoute || pageRoute;
      if (route !== pageRoute && route !== GLOBAL_ROUTE) return;
      const content = node.dataset.cmsLayoutTarget === 'true'
        ? node.dataset.cmsLayoutValue || '{"x":0,"y":0,"scale":100}'
        : (node.dataset.cmsRich === 'true'
        ? sanitizeInlineHtml(node.innerHTML)
        : node.textContent || '').trim();
      if (!content || content.length > 10000) return;
      entries.set(key, {
        key,
        route,
        type: node.dataset.cmsElementType || 'paragraph',
        content,
      });
    });

    const missing = Array.from(entries.values());

    async function createEntry(entry: (typeof missing)[number]) {
      const { data, error } = await supabase.rpc('cms_create_content_block', {
        requested_key: entry.key,
        requested_route: entry.route,
        requested_element_type: entry.type,
        requested_fallback: entry.content,
      });
      if (data) {
        blockByKey.set(entry.key, data as EditorBlock);
        return;
      }
      if (error?.code !== '23505') throw error;
      const { data: existing, error: existingError } = await supabase
        .from('cms_content_blocks')
        .select('id,content_key,route_path,element_type,fallback_content,draft_content,published_content,draft_format,published_format,status,published_version,updated_at,published_at')
        .eq('content_key', entry.key)
        .single();
      if (existingError) throw existingError;
      blockByKey.set(entry.key, existing as EditorBlock);
    }

    // Missing rows are a safety net for newly deployed copy, not a substitute
    // for the seed migration. A small worker pool keeps an affected page usable
    // without flooding Supabase or waiting on hundreds of sequential requests.
    const queue = [...missing];
    const workerCount = Math.min(8, queue.length);
    await Promise.all(Array.from({ length: workerCount }, async () => {
      while (queue.length > 0) {
        const entry = queue.shift();
        if (entry) await createEntry(entry);
      }
    }));
  }

  async function loadContent() {
    try {
      if (editorMode) {
        const { data: sessionData } = await supabase.auth.getSession();
        if (!sessionData.session) throw new Error('Session administrateur absente');

        const { data, error } = await supabase
          .from('cms_content_blocks')
          .select('id,content_key,route_path,element_type,fallback_content,draft_content,published_content,draft_format,published_format,status,published_version,updated_at,published_at')
          .in('route_path', [pageRoute, GLOBAL_ROUTE])
          .order('content_key');
        if (error) throw error;
        (data as EditorBlock[] | null)?.forEach((block) => blockByKey.set(block.content_key, block));
        await createMissingVisibleBlocks();
      } else {
        const { data, error } = await supabase
          .from('cms_published_content')
          .select('content_key,route_path,element_type,published_content,published_format,published_at')
          .in('route_path', [pageRoute, GLOBAL_ROUTE]);
        if (error) throw error;
        (data as PublishedBlock[] | null)?.forEach((block) => blockByKey.set(block.content_key, block));
      }

      blockByKey.forEach(applyBlock);
      announceReady();
    } catch (error) {
      console.warn('[CMS] Fallback content retained:', error);
      if (editorMode) {
        const message = error instanceof Error
          ? error.message
          : error && typeof error === 'object' && 'message' in error && typeof error.message === 'string'
            ? error.message
            : 'Chargement impossible';
        window.parent.postMessage({ type: 'cms:error', message }, window.location.origin);
      }
    }
  }

  if (editorMode) {
    let activeLayoutDrag: {
      node: HTMLElement;
      pointerId: number;
      startX: number;
      startY: number;
      originX: number;
      originY: number;
      scale: number;
    } | null = null;

    function layoutValue(node: HTMLElement) {
      try {
        const value = JSON.parse(node.dataset.cmsLayoutValue || '{}') as { x?: number; y?: number; scale?: number };
        return {
          x: Number(value.x) || 0,
          y: Number(value.y) || 0,
          scale: Math.max(40, Math.min(220, Number(value.scale) || 100)),
        };
      } catch {
        return { x: 0, y: 0, scale: 100 };
      }
    }

    document.addEventListener('pointerdown', (event) => {
      const clicked = event.target as HTMLElement;
      const node = clicked.closest<HTMLElement>('[data-cms-layout-target="true"]');
      if (!node || event.button !== 0) return;
      const value = layoutValue(node);
      activeLayoutDrag = {
        node,
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        originX: value.x,
        originY: value.y,
        scale: value.scale,
      };
      node.setPointerCapture(event.pointerId);
      node.classList.add('cms-layout-dragging');
      event.preventDefault();
      event.stopPropagation();
    }, true);

    document.addEventListener('pointermove', (event) => {
      if (!activeLayoutDrag || activeLayoutDrag.pointerId !== event.pointerId) return;
      const x = Math.round(activeLayoutDrag.originX + event.clientX - activeLayoutDrag.startX);
      const y = Math.round(activeLayoutDrag.originY + event.clientY - activeLayoutDrag.startY);
      const content = JSON.stringify({ x, y, scale: activeLayoutDrag.scale });
      applyValue(activeLayoutDrag.node.dataset.cmsKey || '', content, {});
      window.parent.postMessage({
        type: 'cms:layout-preview',
        key: activeLayoutDrag.node.dataset.cmsKey,
        content,
      }, window.location.origin);
    }, true);

    document.addEventListener('pointerup', (event) => {
      if (!activeLayoutDrag || activeLayoutDrag.pointerId !== event.pointerId) return;
      const { node } = activeLayoutDrag;
      node.classList.remove('cms-layout-dragging');
      if (node.hasPointerCapture(event.pointerId)) node.releasePointerCapture(event.pointerId);
      const block = blockByKey.get(node.dataset.cmsKey || '');
      if (block) {
        const content = node.dataset.cmsLayoutValue || ('draft_content' in block ? block.draft_content : block.published_content);
        markActive(node.dataset.cmsKey || '');
        window.parent.postMessage({
          type: 'cms:select',
          key: node.dataset.cmsKey,
          route: node.dataset.cmsRoute,
          elementType: 'layout',
          rich: false,
          block,
        }, window.location.origin);
        window.parent.postMessage({ type: 'cms:layout-preview', key: node.dataset.cmsKey, content }, window.location.origin);
      }
      activeLayoutDrag = null;
      event.preventDefault();
      event.stopPropagation();
    }, true);

    document.addEventListener('click', (event) => {
      const clicked = event.target as HTMLElement;
      const target = clicked.closest<HTMLElement>('[data-cms-key]');
      if (target?.dataset.cmsKey) {
        event.preventDefault();
        event.stopPropagation();
        const storedBlock = blockByKey.get(target.dataset.cmsKey);
        const block = storedBlock;
        if (!block) return;
        markActive(target.dataset.cmsKey);
        window.parent.postMessage({
          type: 'cms:select',
          key: target.dataset.cmsKey,
          route: target.dataset.cmsRoute,
          elementType: target.dataset.cmsLayoutTarget === 'true' ? 'layout' : target.dataset.cmsElementType,
          rich: target.dataset.cmsRich === 'true',
          block,
        }, window.location.origin);
        return;
      }

      const link = clicked.closest<HTMLAnchorElement>('a[href]');
      if (!link || link.hasAttribute('download')) return;
      const next = new URL(link.href, window.location.href);
      if (next.origin !== window.location.origin) {
        link.target = '_blank';
        link.rel = 'noreferrer';
        return;
      }
      if (next.pathname === pageRoute && next.hash) return;
      event.preventDefault();
      next.searchParams.set('cms-editor', '1');
      window.parent.postMessage({ type: 'cms:navigate-request', route: next.pathname, url: next.toString() }, window.location.origin);
    }, true);

    window.addEventListener('message', (event) => {
      if (event.origin !== window.location.origin || event.source !== window.parent || !event.data?.type) return;
      if (event.data.type === 'cms:update-preview') applyValue(event.data.key, event.data.content, event.data.format || {});
      if (event.data.type === 'cms:focus' && typeof event.data.key === 'string') {
        markActive(event.data.key);
        document.querySelector(`[data-cms-key="${CSS.escape(event.data.key)}"]`)
          ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (event.data.type === 'cms:set-preview-state') {
        previewState = event.data.state === 'published' ? 'published' : 'draft';
        blockByKey.forEach(applyBlock);
      }
      if (event.data.type === 'cms:replace-block' && event.data.block) {
        blockByKey.set(event.data.block.content_key, event.data.block);
        applyBlock(event.data.block);
      }
      if (event.data.type === 'cms:navigate-approved' && typeof event.data.url === 'string') {
        const next = new URL(event.data.url, window.location.href);
        if (next.origin === window.location.origin) window.location.assign(next);
      }
      if (event.data.type === 'cms:reload') window.location.reload();
    });
  }

  void loadContent();
</script>

<style is:global>
  .cms-preserve-lines { white-space: pre-line; }

  [data-cms-format-size='small'][data-cms-element-type='heading'] { font-size: clamp(1.35rem, 2.5vw, 2.25rem) !important; }
  [data-cms-format-size='large'][data-cms-element-type='heading'] { font-size: clamp(2.5rem, 5vw, 5rem) !important; }
  [data-cms-format-size='xlarge'][data-cms-element-type='heading'] { font-size: clamp(3rem, 6.5vw, 6rem) !important; }
  [data-cms-format-size='small']:not([data-cms-element-type='heading']) { font-size: 0.78rem !important; }
  [data-cms-format-size='large']:not([data-cms-element-type='heading']) { font-size: 1.125rem !important; }
  [data-cms-format-size='xlarge']:not([data-cms-element-type='heading']) { font-size: 1.3rem !important; }
  [data-cms-format-weight='regular'] { font-weight: 400 !important; }
  [data-cms-format-weight='medium'] { font-weight: 500 !important; }
  [data-cms-format-weight='semibold'] { font-weight: 600 !important; }
  [data-cms-format-weight='bold'] { font-weight: 700 !important; }
  [data-cms-format-alignment='left'] { text-align: left !important; }
  [data-cms-format-alignment='center'] { text-align: center !important; }
  [data-cms-format-alignment='right'] { text-align: right !important; }
  [data-cms-format-color='navy'] { color: var(--color-porters-navy, #283743) !important; }
  [data-cms-format-color='gold'] { color: var(--color-porters-gold, #be9e58) !important; }
  [data-cms-format-color='dark'] { color: var(--color-porters-black, #0b1020) !important; }
  [data-cms-format-color='light'] { color: var(--color-porters-white, #faf8f3) !important; }
  [data-cms-format-color='muted'] { color: rgba(40, 55, 67, 0.62) !important; }
  [data-cms-format-line-height='compact'] { line-height: 1.08 !important; }
  [data-cms-format-line-height='normal'] { line-height: 1.4 !important; }
  [data-cms-format-line-height='relaxed'] { line-height: 1.75 !important; }

  /*
   * Editor affordances never use a positive outline-offset. Two blocks share a
   * line whenever a sentence carries inline decoration, and offset outlines on
   * adjacent inline boxes visibly collide — both across a single space and
   * across the leading of a tight heading.
   */
  body.cms-editor-mode [data-cms-key] {
    border-radius: 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    cursor: pointer !important;
    outline: 1px dashed rgba(190, 158, 88, 0.5);
    outline-offset: 0;
    transition: outline-color 160ms ease, background-color 160ms ease;
  }

  body.cms-editor-mode [data-cms-key]:hover,
  body.cms-editor-mode [data-cms-key]:focus {
    background-color: rgba(190, 158, 88, 0.14);
    outline: 2px solid rgba(190, 158, 88, 0.9);
  }

  body.cms-editor-mode [data-cms-key].cms-editor-active {
    background-color: rgba(190, 158, 88, 0.18);
    outline: 2px solid #be9e58;
  }

  body.cms-editor-mode [data-cms-layout-target='true'] {
    touch-action: none;
    user-select: none;
  }

  body.cms-editor-mode [data-cms-layout-target='true'].cms-layout-dragging {
    outline-style: solid;
    outline-color: #be9e58;
  }
</style>
