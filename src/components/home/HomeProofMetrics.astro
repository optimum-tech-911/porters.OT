---
import { Image } from 'astro:assets';
import { cmsAttrs, cmsText } from '../../cms/content';
import bubbleSectionImage from '../../assets/home/bubble-woman-transparent.png';

type ProofMetric = {
  id: 'missions' | 'remuneration';
  target?: number;
  prefix?: string;
  suffix?: string;
  accessibleValue: string;
  labelKey: string;
  descriptionKey: string;
};

const metrics: ProofMetric[] = [
  {
    id: 'missions',
    target: 150,
    suffix: '+',
    accessibleValue: 'Plus de 150 missions en cours',
    labelKey: 'home.proof.missions.label',
    descriptionKey: 'home.proof.missions.description',
  },
  {
    id: 'remuneration',
    prefix: '1',
    accessibleValue: 'Première rémunération dès le premier mois',
    labelKey: 'home.proof.remuneration.label',
    descriptionKey: 'home.proof.remuneration.description',
  },
];
---

<home-proof-metrics
  class="home-proof"
  data-home-proof
  role="region"
  aria-labelledby="home-proof-title"
>
  <div class="home-proof__inner">
    <h2 id="home-proof-title" {...cmsAttrs('home.proof.title')}>{cmsText('home.proof.title')}</h2>

    <div class="home-proof__diagram" role="list" aria-label="Chiffres clés The Porters">
      <div class="home-proof__cluster">
        {metrics.map((metric, index) => (
          <div
            class:list={['home-proof__bubble', `home-proof__bubble--${metric.id}`]}
            style={`--proof-delay: ${520 + index * 150}ms; --float-delay: ${1500 + index * 280}ms`}
            role="listitem"
            aria-label={metric.accessibleValue}
          >
            <div class="home-proof__bubble-surface">
              <strong class="home-proof__value" data-cms-ignore>
                {metric.target ? (
                  <span
                    class="home-proof__number"
                    data-proof-count
                    data-target={metric.target}
                    data-suffix={metric.suffix}
                  >{metric.target}{metric.suffix}</span>
                ) : (
                  <span>{metric.prefix}er mois</span>
                )}
              </strong>
            </div>
          </div>
        ))}
        <span class="home-proof__connector home-proof__connector--missions"></span>
        <span class="home-proof__connector home-proof__connector--remuneration"></span>
      </div>

      {metrics.map((metric, index) => (
        <div
          class:list={['home-proof__callout', `home-proof__callout--${metric.id}`]}
          style={`--line-delay: ${760 + index * 150}ms; --copy-delay: ${920 + index * 150}ms`}
        >
          <span class="home-proof__line" aria-hidden="true"></span>
          <div class="home-proof__callout-copy">
            <strong {...cmsAttrs(metric.labelKey)}>{cmsText(metric.labelKey)}</strong>
            <p {...cmsAttrs(metric.descriptionKey)}>{cmsText(metric.descriptionKey)}</p>
          </div>
        </div>
      ))}

      <figure class="home-proof__portrait" data-proof-portrait data-cms-ignore tabindex="-1" aria-label="Femme de la section chiffres clés — déplaçable dans l’éditeur">
        <Image
          src={bubbleSectionImage}
          alt=""
          widths={[720, 1080, 1440]}
          sizes="(max-width: 640px) 150vw, (max-width: 1000px) 75vw, 62vw"
          format="webp"
          quality={92}
          loading="lazy"
        />
        <span class="home-proof__portrait-grip" data-portrait-grip>Glisser pour déplacer</span>
        <button class="home-proof__portrait-reset" type="button" data-portrait-reset>Réinitialiser</button>
        <button class="home-proof__portrait-resize" type="button" data-portrait-resize aria-label="Redimensionner la femme"></button>
      </figure>
    </div>
  </div>
</home-proof-metrics>

<script is:inline>
  (() => {
    const portrait = document.querySelector('[data-proof-portrait]');
    if (!(portrait instanceof HTMLElement) || portrait.dataset.layoutReady === 'true') return;
    portrait.dataset.layoutReady = 'true';

    const editorMode = new URLSearchParams(window.location.search).get('cms-editor') === '1';
    const resizeHandle = portrait.querySelector('[data-portrait-resize]');
    const resetButton = portrait.querySelector('[data-portrait-reset]');
    const storagePrefix = 'tp-home-proof-portrait-layout-v1';
    const breakpoint = () => window.innerWidth <= 520 ? 'mobile' : window.innerWidth <= 900 ? 'tablet' : 'desktop';
    let storageKey = `${storagePrefix}:${breakpoint()}`;
    let state = { x: 0, y: 0, scale: 1 };
    let gesture = null;

    const readState = () => {
      storageKey = `${storagePrefix}:${breakpoint()}`;
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y) && Number.isFinite(saved.scale)) {
          state = { x: saved.x, y: saved.y, scale: saved.scale };
        } else {
          state = { x: 0, y: 0, scale: 1 };
        }
      } catch {
        state = { x: 0, y: 0, scale: 1 };
      }
    };

    const applyState = () => {
      portrait.style.setProperty('--portrait-x', `${state.x}px`);
      portrait.style.setProperty('--portrait-y', `${state.y}px`);
      portrait.style.setProperty('--portrait-scale', `${state.scale}`);
    };

    const saveState = () => {
      try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {}
    };

    readState();
    applyState();

    const enableEditorControls = () => {
      if (!editorMode && !document.body.classList.contains('cms-editor-mode')) return;
      portrait.classList.add('is-layout-editable');
      portrait.closest('[data-home-proof]')?.classList.add('is-visible');
    };

    const selectPortrait = () => {
      enableEditorControls();
      document.querySelectorAll('.is-layout-selected').forEach((node) => {
        if (node !== portrait) node.classList.remove('is-layout-selected');
      });
      portrait.classList.add('is-layout-selected');
      portrait.focus({ preventScroll: true });
    };

    enableEditorControls();
    document.addEventListener('cms:editor-ready', enableEditorControls, { once: true });
    if (!editorMode) return;

    const beginGesture = (event, mode) => {
      if (!(event instanceof PointerEvent) || event.button !== 0) return;
      event.preventDefault();
      event.stopPropagation();
      selectPortrait();
      gesture = {
        mode,
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        x: state.x,
        y: state.y,
        scale: state.scale,
      };
      portrait.classList.add('is-adjusting');
      portrait.setPointerCapture?.(event.pointerId);
    };

    portrait.addEventListener('pointerdown', (event) => {
      if (event.target === resizeHandle || event.target === resetButton) return;
      beginGesture(event, 'move');
    });
    resizeHandle?.addEventListener('pointerdown', (event) => beginGesture(event, 'resize'));

    portrait.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      selectPortrait();
    });

    portrait.addEventListener('pointermove', (event) => {
      if (!gesture || event.pointerId !== gesture.pointerId) return;
      event.preventDefault();
      const dx = event.clientX - gesture.startX;
      const dy = event.clientY - gesture.startY;
      if (gesture.mode === 'move') {
        state.x = Math.round(gesture.x + dx);
        state.y = Math.round(gesture.y + dy);
      } else {
        const diagonal = (dx - dy) / 420;
        state.scale = Math.round(Math.min(2.2, Math.max(0.55, gesture.scale + diagonal)) * 100) / 100;
      }
      applyState();
    });

    const endGesture = (event) => {
      if (!gesture || event.pointerId !== gesture.pointerId) return;
      gesture = null;
      portrait.classList.remove('is-adjusting');
      saveState();
    };
    portrait.addEventListener('pointerup', endGesture);
    portrait.addEventListener('pointercancel', endGesture);

    resetButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      state = { x: 0, y: 0, scale: 1 };
      applyState();
      try { localStorage.removeItem(storageKey); } catch {}
    });

    document.addEventListener('pointerdown', (event) => {
      if (portrait.contains(event.target)) return;
      portrait.classList.remove('is-layout-selected');
    });

    let currentBreakpoint = breakpoint();
    window.addEventListener('resize', () => {
      const nextBreakpoint = breakpoint();
      if (nextBreakpoint === currentBreakpoint) return;
      currentBreakpoint = nextBreakpoint;
      readState();
      applyState();
    }, { passive: true });
  })();
</script>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-home-proof]:not([data-proof-ready])');
    if (!(root instanceof HTMLElement)) return;
    root.dataset.proofReady = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-visible');
      return;
    }

    root.classList.add('home-proof--motion');
    const reveal = () => {
      if (root.dataset.proofRevealed === 'true') return;
      root.dataset.proofRevealed = 'true';
      root.classList.add('is-visible');

      root.querySelectorAll('[data-proof-count]').forEach((counter) => {
        if (!(counter instanceof HTMLElement) || counter.dataset.counted === 'true') return;
        counter.dataset.counted = 'true';
        const target = Number(counter.dataset.target || 0);
        const suffix = counter.dataset.suffix || '';
        if (!Number.isFinite(target) || target <= 0) return;

        counter.textContent = `0${suffix}`;
        const start = performance.now();
        const duration = 1100;
        const tick = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          counter.textContent = `${Math.round(target * (1 - Math.pow(1 - progress, 3)))}${suffix}`;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };

    if (!('IntersectionObserver' in window)) {
      reveal();
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      reveal();
    }, { threshold: 0.22, rootMargin: '0px 0px -8% 0px' });

    observer.observe(root);
  })();
</script>

<style>
  .home-proof {
    display: block;
    overflow: clip;
    background:
      radial-gradient(circle at 14% 32%, rgba(198, 164, 90, 0.1), transparent 26rem),
      linear-gradient(135deg, #f5f9fb 0%, #edf4f8 100%);
    color: #203440;
  }

  .home-proof__inner {
    width: min(100% - 3rem, 80rem);
    margin-inline: auto;
    padding: clamp(4.5rem, 7vw, 6.5rem) 0 clamp(5rem, 8vw, 7rem);
  }

  .home-proof h2 {
    width: min(100%, 29rem);
    margin: 0;
    font-family: var(--font-display, 'Newsreader', Georgia, serif);
    font-size: clamp(2.55rem, 4.2vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .home-proof__diagram {
    --diagram-gap: clamp(1.5rem, 3vw, 3.25rem);
    display: grid;
    grid-template-columns: minmax(17rem, 23rem) minmax(27rem, 31rem) minmax(11rem, 1fr);
    grid-template-rows: repeat(3, 1fr);
    column-gap: var(--diagram-gap);
    position: relative;
    min-height: clamp(31rem, 43vw, 35rem);
    margin-top: clamp(1.8rem, 3vw, 2.8rem);
  }

  .home-proof__portrait {
    --portrait-x: 0px;
    --portrait-y: 0px;
    --portrait-scale: 1;
    position: absolute;
    bottom: 0;
    left: clamp(-6rem, -4vw, -2rem);
    z-index: 1;
    width: auto;
    height: clamp(34rem, 43vw, 43rem);
    max-width: none;
    margin: 0;
    transform: translate3d(var(--portrait-x), var(--portrait-y), 0) scale(var(--portrait-scale));
    transform-origin: left bottom;
    -webkit-mask-image: linear-gradient(to bottom, #000 0 76%, rgba(0, 0, 0, .98) 82%, rgba(0, 0, 0, .66) 91%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0 76%, rgba(0, 0, 0, .98) 82%, rgba(0, 0, 0, .66) 91%, transparent 100%);
    will-change: opacity, transform;
  }

  .home-proof__portrait img {
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    object-fit: contain;
    object-position: left bottom;
    will-change: filter, transform;
  }

  .home-proof__portrait-grip,
  .home-proof__portrait-reset,
  .home-proof__portrait-resize {
    display: none;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable {
    z-index: 20;
    cursor: grab;
    pointer-events: auto !important;
    outline: 2px dashed rgba(198, 164, 90, 0.92);
    outline-offset: 0.4rem;
    touch-action: none;
    user-select: none;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable:hover,
  body.cms-editor-mode .home-proof__portrait.is-layout-editable:focus,
  body.cms-editor-mode .home-proof__portrait.is-layout-editable.is-layout-selected {
    outline: 3px solid #c6a45a;
    outline-offset: 0.5rem;
    filter: drop-shadow(0 16px 26px rgba(16, 38, 48, 0.2));
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable.is-adjusting {
    cursor: grabbing;
    outline-style: solid;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable .home-proof__portrait-grip {
    position: absolute;
    top: 0.8rem;
    left: 50%;
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border-radius: 999px;
    padding: 0.42rem 0.75rem;
    background: #203440;
    color: #fff;
    box-shadow: 0 8px 24px rgba(16, 38, 48, 0.25);
    font: 700 0.66rem/1 sans-serif;
    letter-spacing: 0.04em;
    pointer-events: none;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable:not(.is-layout-selected) .home-proof__portrait-grip {
    background: #c6a45a;
    color: #102630;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable .home-proof__portrait-reset {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border: 0;
    border-radius: 999px;
    padding: 0.42rem 0.75rem;
    background: #fff;
    color: #203440;
    box-shadow: 0 8px 24px rgba(16, 38, 48, 0.18);
    cursor: pointer;
    font: 700 0.64rem/1 sans-serif;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable:not(.is-layout-selected) .home-proof__portrait-reset,
  body.cms-editor-mode .home-proof__portrait.is-layout-editable:not(.is-layout-selected) .home-proof__portrait-resize {
    display: none;
  }

  body.cms-editor-mode .home-proof__portrait.is-layout-editable .home-proof__portrait-resize {
    position: absolute;
    right: -0.65rem;
    bottom: -0.65rem;
    display: block;
    width: 1.45rem;
    height: 1.45rem;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #c6a45a;
    box-shadow: 0 6px 18px rgba(16, 38, 48, 0.25);
    cursor: nwse-resize;
    touch-action: none;
  }

  .home-proof__cluster {
    position: relative;
    z-index: 2;
    grid-column: 2;
    grid-row: 1 / span 3;
    min-height: inherit;
  }

  .home-proof__bubble {
    position: absolute;
    z-index: 2;
    width: var(--bubble-size);
    aspect-ratio: 1;
  }

  .home-proof__bubble-surface {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    border: 1px solid rgba(32, 52, 64, 0.12);
    border-radius: 50%;
    box-shadow: 0 24px 62px rgba(20, 41, 52, 0.13);
    transition: box-shadow 360ms ease, scale 360ms cubic-bezier(.2, .8, .2, 1);
    will-change: opacity, scale, translate;
  }

  .home-proof__bubble--missions {
    --bubble-size: min(64%, 21rem);
    top: 0;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
  }

  .home-proof__bubble--missions .home-proof__bubble-surface {
    border-color: rgba(255, 255, 255, 0.12);
    background: #203440;
    color: #fff;
  }

  .home-proof__bubble--remuneration {
    --bubble-size: min(44%, 14rem);
    top: 57%;
    right: 2%;
    z-index: 4;
  }

  .home-proof__bubble--remuneration .home-proof__bubble-surface {
    border: 5px solid #f5f9fb;
    background: #d5a34c;
    color: #162d39;
  }

  .home-proof__value {
    padding: 1rem;
    font-size: clamp(3.2rem, 6vw, 5.6rem);
    font-weight: 750;
    letter-spacing: -0.07em;
    line-height: 0.88;
    text-align: center;
    white-space: nowrap;
  }

  /* The compact metrics must never outgrow their circular surfaces. */
  .home-proof__bubble--remuneration .home-proof__value { font-size: clamp(1.75rem, 2.3vw, 2.35rem); }

  .home-proof__number {
    display: inline-block;
    min-width: 3ch;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .home-proof__connector {
    position: absolute;
    z-index: 1;
    height: 1px;
    background: rgba(32, 52, 64, 0.72);
  }

  .home-proof__connector--missions {
    top: 30%;
    right: calc(-1 * var(--diagram-gap));
    left: 82%;
  }

  .home-proof__connector--remuneration {
    top: 73%;
    right: calc(-1 * var(--diagram-gap));
    left: 90%;
  }

  .home-proof__callout {
    position: relative;
    z-index: 3;
    align-self: center;
    width: 100%;
    max-width: 18.5rem;
  }

  .home-proof__callout--missions {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }

  .home-proof__callout--remuneration {
    grid-column: 3;
    grid-row: 3;
    justify-self: end;
  }

  .home-proof__line {
    display: block;
    width: calc(100% + var(--diagram-gap));
    height: 1px;
    margin-bottom: 1rem;
    background: rgba(32, 52, 64, 0.72);
  }

  .home-proof__callout--missions .home-proof__line,
  .home-proof__callout--remuneration .home-proof__line {
    margin-left: calc(-1 * var(--diagram-gap));
    transform-origin: left center;
  }

  .home-proof__callout strong {
    display: block;
    font-size: clamp(0.8rem, 1.05vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.075em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .home-proof__callout p {
    margin: 0.45rem 0 0;
    color: rgba(32, 52, 64, 0.7);
    font-size: clamp(0.82rem, 1.04vw, 0.94rem);
    line-height: 1.48;
  }

  .home-proof--motion .home-proof__bubble-surface {
    opacity: 0;
    scale: 0.82;
    translate: 0 2rem;
    transition:
      opacity 680ms cubic-bezier(.2, .8, .2, 1),
      scale 860ms cubic-bezier(.16, 1, .3, 1),
      translate 860ms cubic-bezier(.16, 1, .3, 1);
    transition-delay: var(--proof-delay);
  }

  .home-proof--motion .home-proof__portrait {
    opacity: 0;
    transform: translate3d(calc(var(--portrait-x) - 2.25rem), calc(var(--portrait-y) + 0.65rem), 0) scale(calc(var(--portrait-scale) * 0.97));
    transition:
      opacity 680ms ease 80ms,
      transform 1050ms cubic-bezier(.16, 1, .3, 1) 80ms;
  }

  .home-proof--motion .home-proof__portrait {
    clip-path: inset(0 34% 0 0);
    transition:
      clip-path 1150ms cubic-bezier(.16, 1, .3, 1) 120ms,
      opacity 680ms ease 80ms,
      transform 1050ms cubic-bezier(.16, 1, .3, 1) 80ms;
  }

  .home-proof--motion .home-proof__portrait img {
    filter: blur(4px) saturate(0.88);
    transform: translateX(-3%) scale(1.035);
    transition:
      filter 850ms ease 260ms,
      transform 1250ms cubic-bezier(.16, 1, .3, 1) 180ms;
  }

  .home-proof--motion h2 {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 520ms ease,
      transform 720ms cubic-bezier(.16, 1, .3, 1);
  }

  .home-proof--motion .home-proof__connector,
  .home-proof--motion .home-proof__line {
    transform: scaleX(0);
    transition: transform 680ms cubic-bezier(.16, 1, .3, 1);
    transition-delay: var(--line-delay, 520ms);
  }

  .home-proof--motion .home-proof__callout-copy {
    opacity: 0;
    translate: 0 0.8rem;
    transition:
      opacity 450ms ease,
      translate 560ms cubic-bezier(.16, 1, .3, 1);
    transition-delay: var(--copy-delay);
  }

  .home-proof--motion.is-visible .home-proof__bubble-surface {
    opacity: 1;
    scale: 1;
    translate: 0;
  }

  .home-proof--motion.is-visible .home-proof__portrait {
    opacity: 1;
    transform: translate3d(var(--portrait-x), var(--portrait-y), 0) scale(var(--portrait-scale));
  }

  .home-proof--motion.is-visible .home-proof__portrait { clip-path: inset(0); }

  .home-proof--motion.is-visible .home-proof__portrait img {
    filter: none;
    transform: none;
  }

  .home-proof--motion.is-visible h2 {
    opacity: 1;
    transform: none;
  }

  .home-proof--motion.is-visible .home-proof__connector,
  .home-proof--motion.is-visible .home-proof__line { transform: scaleX(1); }

  .home-proof--motion.is-visible .home-proof__callout-copy {
    opacity: 1;
    translate: 0;
  }

  .home-proof.is-visible .home-proof__bubble-surface {
    animation: proof-float 7.5s ease-in-out var(--float-delay) infinite alternate both;
  }

  @keyframes proof-float {
    from { translate: 0 0; }
    to { translate: 0 -0.4rem; }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-proof.is-visible .home-proof__bubble:hover { z-index: 6; }

    .home-proof.is-visible .home-proof__bubble:hover .home-proof__bubble-surface {
      animation-play-state: paused;
      box-shadow: 0 34px 80px rgba(20, 41, 52, 0.2);
      scale: 1.035;
    }

    .home-proof.is-visible .home-proof__diagram:has(.home-proof__bubble--missions:hover) .home-proof__callout--missions .home-proof__callout-copy,
    .home-proof.is-visible .home-proof__diagram:has(.home-proof__bubble--remuneration:hover) .home-proof__callout--remuneration .home-proof__callout-copy {
      translate: 0.3rem 0;
    }
  }

  @media (max-width: 1180px) {
    .home-proof__inner { width: min(100% - 2rem, 68rem); }

    .home-proof__diagram {
      --diagram-gap: clamp(1rem, 2.2vw, 1.75rem);
      grid-template-columns: minmax(15rem, 21rem) minmax(25rem, 29rem) minmax(9rem, 1fr);
      min-height: 31rem;
      margin-top: 2.25rem;
    }

    .home-proof__portrait {
      left: clamp(-5rem, -4vw, -2rem);
