---
import { cmsAttrs, cmsText } from '../../cms/content';

type HeroSlide = {
  id: string;
  base: string;
  width: number;
  height: number;
  desktopPosition: string;
  mobilePosition: string;
  duration: number;
  zoom: 'in' | 'out';
};

const heroSlides: HeroSlide[] = [
  {
    id: 'consultant-window',
    base: 'consultant-window',
    width: 1024,
    height: 1536,
    desktopPosition: '62% 42%',
    mobilePosition: '61% 38%',
    duration: 8400,
    zoom: 'in',
  },
  {
    id: 'walking-corridor',
    base: 'walking-corridor',
    width: 1440,
    height: 1080,
    desktopPosition: '56% 50%',
    mobilePosition: '55% 44%',
    duration: 8000,
    zoom: 'out',
  },
  {
    id: 'conversation-corridor',
    base: 'conversation-corridor',
    width: 1440,
    height: 1080,
    desktopPosition: '43% 50%',
    mobilePosition: '42% 42%',
    duration: 8200,
    zoom: 'in',
  },
  {
    id: 'consultant-window-full',
    base: 'consultant-window-full',
    width: 1024,
    height: 1536,
    desktopPosition: '47% 46%',
    mobilePosition: '47% 43%',
    duration: 8600,
    zoom: 'out',
  },
];

const mobileOrder = [
  'consultant-window',
  'consultant-window-full',
  'walking-corridor',
  'conversation-corridor',
];

const featureCards = [
  { id: 'contact', key: 'home.hero.trust.interlocutors', label: cmsText('home.hero.trust.interlocutors') },
  { id: 'missions', key: 'home.hero.trust.secured_missions', label: cmsText('home.hero.trust.secured_missions') },
  { id: 'status', key: 'home.hero.trust.employee_framework', label: cmsText('home.hero.trust.employee_framework') },
  { id: 'expertise', key: 'home.hero.trust.it_expertise', label: cmsText('home.hero.trust.it_expertise') },
];

const assetRoot = '/images/hero/editorial';
const portraitWidths = [640, 1024];
const landscapeWidths = [720, 1440];
const sourceSet = (slide: HeroSlide, format: 'avif' | 'webp') => {
  const widths = slide.width === 1024 ? portraitWidths : landscapeWidths;
  return widths.map((width) => `${assetRoot}/${slide.base}-${width}.${format} ${width}w`).join(', ');
};
const fallbackSource = (slide: HeroSlide) => `${assetRoot}/${slide.base}-${slide.width}.webp`;
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
---

<section
  class="home-hero"
  aria-labelledby="home-hero-title"
  data-hero-root
  data-mobile-order={mobileOrder.join(',')}
>
  <div class="hero-shell">
    <div class="hero-copy">
      <p class="hero-eyebrow hero-enter hero-enter--eyebrow" {...cmsAttrs('home.hero.eyebrow')}>
        {cmsText('home.hero.eyebrow')}
      </p>

      <h1
        id="home-hero-title"
        class="hero-title hero-enter hero-enter--title cms-preserve-lines"
        {...cmsAttrs('home.hero.title')}
      >
        {cmsText('home.hero.title')}
      </h1>

      <p class="hero-subhead hero-enter hero-enter--copy" {...cmsAttrs('home.hero.description')}>
        {cmsText('home.hero.description')}
      </p>

      <div class="hero-actions hero-enter hero-enter--actions">
        <a href="/rendez-vous" class="hero-action hero-action--primary">
          <span {...cmsAttrs('home.hero.primary_cta')}>{cmsText('home.hero.primary_cta')}</span>
          <span class="hero-action__arrow" aria-hidden="true">→</span>
        </a>
        <a href="/portage-salarial" class="hero-action hero-action--secondary">
          <span {...cmsAttrs('home.hero.secondary_cta')}>{cmsText('home.hero.secondary_cta')}</span>
          <span class="hero-action__arrow" aria-hidden="true">→</span>
        </a>
        <a href="/entreprises" class="hero-action hero-action--tertiary">
          <span {...cmsAttrs('home.hero.enterprise_cta')}>{cmsText('home.hero.enterprise_cta')}</span>
          <span class="hero-action__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero-media hero-enter hero-enter--media" data-hero-media>
      <div class="hero-media__halo" aria-hidden="true"></div>

      <svg class="hero-orbit" viewBox="0 0 760 720" aria-hidden="true">
        <path id="hero-orbit-primary" d="M57 365C75 155 238 44 452 71c189 23 304 170 249 366-43 153-177 243-359 222C156 637 41 534 57 365Z" />
        <path id="hero-orbit-secondary" d="M112 468c101 102 251 140 392 79 117-50 181-155 176-272" />
        <circle class="hero-orbit__node hero-orbit__node--one" cx="62" cy="356" r="6" />
        <circle class="hero-orbit__node hero-orbit__node--two" cx="684" cy="280" r="6" />
        <circle class="hero-orbit__node hero-orbit__node--three" cx="505" cy="548" r="7" />
        <circle class="hero-orbit__particle hero-orbit__particle--one" r="4.5">
          <animateMotion dur="19s" begin="-5s" repeatCount="indefinite">
            <mpath href="#hero-orbit-primary" />
          </animateMotion>
        </circle>
        <circle class="hero-orbit__particle hero-orbit__particle--two" r="3.5">
          <animateMotion dur="14s" begin="-9s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
            <mpath href="#hero-orbit-secondary" />
          </animateMotion>
        </circle>
      </svg>

      <div class="hero-photo-frame">
        {heroSlides.map((slide, index) => (
          <div
            class:list={['hero-slide', { 'is-active': index === 0 }]}
            data-hero-slide={slide.id}
            data-duration={slide.duration}
            data-loaded={index === 0 ? 'true' : 'false'}
            data-zoom={slide.zoom}
            style={`--desktop-position:${slide.desktopPosition};--mobile-position:${slide.mobilePosition};--slide-duration:${slide.duration}ms`}
            aria-hidden="true"
          >
            <picture data-hero-picture>
              {index === 0 ? (
                <>
                  <source type="image/avif" srcset={sourceSet(slide, 'avif')} sizes="(max-width: 900px) 86vw, (max-width: 1280px) 46vw, 660px" />
                  <source type="image/webp" srcset={sourceSet(slide, 'webp')} sizes="(max-width: 900px) 86vw, (max-width: 1280px) 46vw, 660px" />
                </>
              ) : (
                <>
                  <source type="image/avif" data-srcset={sourceSet(slide, 'avif')} sizes="(max-width: 900px) 86vw, (max-width: 1280px) 46vw, 660px" />
                  <source type="image/webp" data-srcset={sourceSet(slide, 'webp')} sizes="(max-width: 900px) 86vw, (max-width: 1280px) 46vw, 660px" />
                </>
              )}
              <img
                src={index === 0 ? fallbackSource(slide) : transparentPixel}
                srcset={index === 0 ? sourceSet(slide, 'webp') : undefined}
                data-src={index === 0 ? undefined : fallbackSource(slide)}
                data-srcset={index === 0 ? undefined : sourceSet(slide, 'webp')}
                sizes="(max-width: 900px) 86vw, (max-width: 1280px) 46vw, 660px"
                alt=""
                width={slide.width}
                height={slide.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : 'low'}
              />
            </picture>
          </div>
        ))}
        <div class="hero-photo-frame__wash" aria-hidden="true"></div>
      </div>

      <ul class="hero-features" aria-label="Les atouts The Porters">
        {featureCards.map((card, index) => (
          <li
            class:list={['hero-feature', `hero-feature--${card.id}`]}
            style={`--feature-delay:${360 + index * 90}ms;--float-duration:${7.4 + index * 0.7}s;--float-delay:${1.3 - index * 0.55}s`}
            data-hero-feature={card.id}
          >
            <span class="hero-feature__surface">
              <span class="hero-feature__icon" aria-hidden="true">
                {card.id === 'contact' && (
                  <svg viewBox="0 0 32 32">
                    <circle cx="16" cy="10" r="5"></circle>
                    <path d="M6.5 27c.6-6 4.1-9 9.5-9s8.9 3 9.5 9"></path>
                    <path d="M4 13v6M28 13v6"></path>
                  </svg>
                )}
                {card.id === 'missions' && (
                  <svg viewBox="0 0 32 32">
                    <path d="M16 3.5 26 7v8.2c0 6.4-4.1 10.9-10 13.3-5.9-2.4-10-6.9-10-13.3V7l10-3.5Z"></path>
                    <path d="m11.2 15.8 3.1 3.1 6.7-7"></path>
                  </svg>
                )}
                {card.id === 'status' && (
                  <svg viewBox="0 0 32 32">
                    <rect x="4" y="9" width="24" height="17" rx="3"></rect>
                    <path d="M12 9V6.5h8V9M4 15.5c5.7 2.9 18.3 2.9 24 0M14 17h4"></path>
                  </svg>
                )}
                {card.id === 'expertise' && (
                  <svg viewBox="0 0 32 32">
                    <path d="m16 3.5 3.6 7.3 8.1 1.2-5.9 5.7 1.4 8.1-7.2-3.9-7.2 3.9 1.4-8.1L4.3 12l8.1-1.2L16 3.5Z"></path>
                  </svg>
                )}
              </span>
              <span class="hero-feature__label" {...cmsAttrs(card.key)}>{card.label}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="hero-mobile-expertise">
        <span class="hero-mobile-expertise__line" aria-hidden="true"></span>
        <span class="hero-mobile-expertise__icon" aria-hidden="true">
          <svg viewBox="0 0 32 32">
            <path d="m16 3.5 3.6 7.3 8.1 1.2-5.9 5.7 1.4 8.1-7.2-3.9-7.2 3.9 1.4-8.1L4.3 12l8.1-1.2L16 3.5Z"></path>
          </svg>
        </span>
        <span class="hero-mobile-expertise__label" {...cmsAttrs('home.hero.trust.it_expertise')}>
          {cmsText('home.hero.trust.it_expertise')}
        </span>
        <span class="hero-mobile-expertise__line" aria-hidden="true"></span>
      </div>

      <div class="hero-slide-controls" role="group" aria-label="Choisir la photographie du hero">
        {heroSlides.map((_, index) => (
          <button
            type="button"
            class:list={['hero-slide-control', { 'is-active': index === 0 }]}
            data-hero-control={index}
            aria-label={`Afficher la photographie ${index + 1}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const setupEditorialHero = (root: HTMLElement) => {
    const media = root.querySelector<HTMLElement>('[data-hero-media]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const controls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-control]'));
    const featureCards = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-feature]'));
    const orbitGraphic = root.querySelector<SVGSVGElement>('.hero-orbit');
    const mobileQuery = window.matchMedia('(max-width: 900px)');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopOrder = slides.map((slide) => slide.dataset.heroSlide || '');
    const mobileOrder = (root.dataset.mobileOrder || '').split(',').filter(Boolean);
    let order = mobileQuery.matches ? mobileOrder : desktopOrder;
    let activeSlideId = order[0];
    let activePosition = 0;
    let autoplayTimer: number | undefined;
    let transitionTimer: number | undefined;
    let pointerFrame: number | undefined;
    let controlsPaused = false;
    let destroyed = false;
    let hoveredFeature: HTMLElement | null = null;
    const featureAnimationByCard = new Map<HTMLElement, Animation>();

    type FeatureMotionSettings = {
      duration: number;
      delay: number;
      points: Array<[number, number]>;
    };

    const featureMotion: Record<string, FeatureMotionSettings> = {
      contact: {
        duration: 13200,
        delay: 2400,
        points: [[0, 0], [18, -11], [32, 3], [19, 19], [-6, 12], [0, 0]],
      },
      missions: {
        duration: 15700,
        delay: 7100,
        points: [[0, 0], [-9, -18], [9, -34], [30, -18], [22, 8], [0, 0]],
      },
      status: {
        duration: 14600,
        delay: 4600,
        points: [[0, 0], [20, 4], [30, -13], [13, -28], [-8, -16], [0, 0]],
      },
      expertise: {
        duration: 16900,
        delay: 9200,
        points: [[0, 0], [-19, 10], [-34, -7], [-15, -27], [12, -18], [0, 0]],
      },
    };

    const stopFeatureMotion = () => {
      featureAnimationByCard.forEach((animation) => animation.cancel());
      featureAnimationByCard.clear();
    };

    const startFeatureMotion = () => {
      stopFeatureMotion();
      if (mobileQuery.matches || motionQuery.matches || document.visibilityState !== 'visible') return;

      featureCards.forEach((card) => {
        const id = card.dataset.heroFeature || '';
        const settings = featureMotion[id];
        if (!settings) return;
        const keyframes = settings.points.map(([x, y], index) => ({
          transform: `translate3d(${x}px, ${y}px, 0)`,
          offset: index / (settings.points.length - 1),
        }));
        const animation = card.animate(keyframes, {
          duration: settings.duration,
          delay: -settings.delay,
          iterations: Infinity,
          easing: 'linear',
        });
        featureAnimationByCard.set(card, animation);
      });
    };

    const setOrbitalAnimationState = (paused: boolean) => {
      featureAnimationByCard.forEach((animation, card) => {
        if (paused || card === hoveredFeature) animation.pause();
        else animation.play();
      });
      if (paused) orbitGraphic?.pauseAnimations?.();
      else orbitGraphic?.unpauseAnimations?.();
    };

    const resetPointerDepth = () => {
      featureCards.forEach((card) => {
        const surface = card.querySelector<HTMLElement>('.hero-feature__surface');
        surface?.style.setProperty('--card-shift-x', '0px');
        surface?.style.setProperty('--card-shift-y', '0px');
      });
      media?.style.setProperty('--photo-shift-x', '0px');
      media?.style.setProperty('--photo-shift-y', '0px');
      media?.style.setProperty('--orbit-shift-x', '0px');
      media?.style.setProperty('--orbit-shift-y', '0px');
    };

    const pulseFeatures = () => {
      if (motionQuery.matches) return;
      featureCards.forEach((card, index) => {
        const icon = card.querySelector<HTMLElement>('.hero-feature__icon');
        icon?.animate(
          [
            { transform: 'scale(1)', color: 'var(--hero-navy)' },
            { transform: 'scale(1.09)', color: '#956a18', offset: 0.45 },
            { transform: 'scale(1)', color: 'var(--hero-navy)' },
          ],
          {
            duration: 620,
            delay: index * 55,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          },
        );
      });
    };

    const slideIndexForId = (id: string) => slides.findIndex((slide) => slide.dataset.heroSlide === id);
    const slideForId = (id: string) => slides[slideIndexForId(id)];

    const loadSlide = async (id: string) => {
      const slide = slideForId(id);
      if (!slide || slide.dataset.loaded === 'true') return;
      const picture = slide.querySelector<HTMLPictureElement>('[data-hero-picture]');
      const image = picture?.querySelector<HTMLImageElement>('img');
      if (!picture || !image) return;

      picture.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((source) => {
        if (source.dataset.srcset) source.srcset = source.dataset.srcset;
      });
      if (image.dataset.srcset) image.srcset = image.dataset.srcset;
      if (image.dataset.src) image.src = image.dataset.src;
      slide.dataset.loaded = 'true';

      try {
        await image.decode();
      } catch {
        // The fallback stays in place if decoding fails; the next transition can retry naturally.
      }
    };

    const syncControls = () => {
      controls.forEach((control, index) => {
        const active = index === activePosition;
        control.classList.toggle('is-active', active);
        control.setAttribute('aria-pressed', String(active));
      });
    };

    const clearAutoplay = () => {
      if (autoplayTimer) window.clearTimeout(autoplayTimer);
      autoplayTimer = undefined;
    };

    const canAutoplay = () => (
      !motionQuery.matches
      && !controlsPaused
      && document.visibilityState === 'visible'
      && order.length > 1
    );

    const scheduleAutoplay = () => {
      clearAutoplay();
      if (!canAutoplay()) return;
      const activeSlide = slideForId(activeSlideId);
      const duration = Number(activeSlide?.dataset.duration || 8200);
      autoplayTimer = window.setTimeout(() => {
        void showPosition((activePosition + 1) % order.length);
      }, duration);
    };

    const showPosition = async (position: number) => {
      const normalizedPosition = (position + order.length) % order.length;
      const nextId = order[normalizedPosition];
      if (!nextId || nextId === activeSlideId || destroyed) {
        scheduleAutoplay();
        return;
      }

      clearAutoplay();
      await loadSlide(nextId);
      if (destroyed) return;

      const previousSlide = slideForId(activeSlideId);
      const nextSlide = slideForId(nextId);
      if (!nextSlide) return;

      if (transitionTimer) window.clearTimeout(transitionTimer);
      nextSlide.classList.add('is-adjacent');
      nextSlide.getBoundingClientRect();

      previousSlide?.classList.remove('is-active');
      previousSlide?.classList.add('is-adjacent');
      nextSlide.classList.remove('is-adjacent');
      nextSlide.classList.add('is-active');

      activeSlideId = nextId;
      activePosition = normalizedPosition;
      root.dataset.activeSlide = nextId;
      syncControls();
      pulseFeatures();

      transitionTimer = window.setTimeout(() => {
        slides.forEach((slide) => {
          if (slide !== nextSlide) slide.classList.remove('is-adjacent');
        });
      }, 1600);
      scheduleAutoplay();
    };

    const hydrateDeferredSlides = () => {
      order.slice(1).forEach((id, index) => {
        window.setTimeout(() => void loadSlide(id), index * 180);
      });
    };

    controls.forEach((control, index) => {
      control.addEventListener('click', () => void showPosition(index));
      control.addEventListener('pointerenter', () => {
        controlsPaused = true;
        clearAutoplay();
      });
      control.addEventListener('pointerleave', () => {
        controlsPaused = false;
        scheduleAutoplay();
      });
      control.addEventListener('focus', () => {
        controlsPaused = true;
        clearAutoplay();
      });
      control.addEventListener('blur', () => {
        controlsPaused = false;
        scheduleAutoplay();
      });
    });

    featureCards.forEach((card) => {
      card.addEventListener('pointerenter', () => {
        hoveredFeature = card;
        featureAnimationByCard.get(card)?.pause();
      });
      card.addEventListener('pointerleave', () => {
        hoveredFeature = null;
        if (!motionQuery.matches && document.visibilityState === 'visible') {
          featureAnimationByCard.get(card)?.play();
        }
      });
    });

    media?.addEventListener('pointermove', (event) => {
      if (mobileQuery.matches || motionQuery.matches || pointerFrame) return;
      pointerFrame = window.requestAnimationFrame(() => {
        pointerFrame = undefined;
        const rect = media.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
        const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
        const depths = [0.9, -0.62, 0.48, -0.76];

        featureCards.forEach((card, index) => {
          const surface = card.querySelector<HTMLElement>('.hero-feature__surface');
          const depth = depths[index] || 0.5;
          surface?.style.setProperty('--card-shift-x', `${(x * 7 * depth).toFixed(2)}px`);
          surface?.style.setProperty('--card-shift-y', `${(y * 5 * depth).toFixed(2)}px`);
        });

        media.style.setProperty('--photo-shift-x', `${(x * 2.5).toFixed(2)}px`);
        media.style.setProperty('--photo-shift-y', `${(y * 2).toFixed(2)}px`);
        media.style.setProperty('--orbit-shift-x', `${(x * -4).toFixed(2)}px`);
        media.style.setProperty('--orbit-shift-y', `${(y * -3).toFixed(2)}px`);
      });
    });

    media?.addEventListener('pointerleave', resetPointerDepth);

    const syncResponsiveOrder = () => {
      order = mobileQuery.matches ? mobileOrder : desktopOrder;
      activePosition = Math.max(0, order.indexOf(activeSlideId));
      resetPointerDepth();
      startFeatureMotion();
      syncControls();
      scheduleAutoplay();
    };

    const syncVisibility = () => {
      const hidden = document.visibilityState !== 'visible';
      media?.classList.toggle('is-paused', hidden);
      setOrbitalAnimationState(hidden || motionQuery.matches);
      if (hidden) clearAutoplay();
      else {
        if (featureAnimationByCard.size === 0) startFeatureMotion();
        scheduleAutoplay();
      }
    };

    const syncMotionPreference = () => {
      media?.classList.toggle('is-reduced-motion', motionQuery.matches);
      resetPointerDepth();
      startFeatureMotion();
      setOrbitalAnimationState(motionQuery.matches || document.visibilityState !== 'visible');
      if (motionQuery.matches) clearAutoplay();
      else scheduleAutoplay();
    };

    mobileQuery.addEventListener('change', syncResponsiveOrder);
    motionQuery.addEventListener('change', syncMotionPreference);
    document.addEventListener('visibilitychange', syncVisibility);
    window.addEventListener('pagehide', () => {
      destroyed = true;
      clearAutoplay();
      if (transitionTimer) window.clearTimeout(transitionTimer);
      if (pointerFrame) window.cancelAnimationFrame(pointerFrame);
      stopFeatureMotion();
    }, { once: true });

    window.setTimeout(hydrateDeferredSlides, 900);
    syncMotionPreference();
    syncControls();
    scheduleAutoplay();
  };

  document.querySelectorAll<HTMLElement>('[data-hero-root]').forEach(setupEditorialHero);
</script>

<style>
  .home-hero {
    --hero-navy: #102b3a;
    --hero-navy-deep: #082230;
    --hero-gold: #c79838;
    --hero-cream: #f8f4ed;
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 71% 42%, rgba(255, 255, 255, 0.92), transparent 29rem),
      linear-gradient(110deg, #fbf8f3 0%, var(--hero-cream) 62%, #f1ede6 100%);
    color: var(--hero-navy);
  }

  .home-hero,
  .home-hero *,
  .home-hero *::before,
  .home-hero *::after {
    box-sizing: border-box;
  }

  .hero-shell {
    display: grid;
    width: min(100% - 3rem, 94rem);
    min-height: clamp(42rem, calc(100svh - 5.75rem), 51rem);
    grid-template-columns: minmax(0, 0.92fr) minmax(31rem, 1.08fr);
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.5rem);
    margin-inline: auto;
  }

  .hero-copy {
    position: relative;
    z-index: 6;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(3.4rem, 6vh, 5.2rem) 1rem clamp(3.4rem, 6vh, 5.2rem) 0;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.82rem;
    margin: 0 0 1.45rem;
    color: #aa7b23;
    font-size: clamp(0.67rem, 0.72vw, 0.78rem);
    font-weight: 760;
    letter-spacing: 0.135em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-eyebrow::before {
    width: 2rem;
    height: 1.5px;
    flex: 0 0 auto;
    background: currentColor;
    content: '';
  }

  .hero-title {
    max-width: 10.7ch;
    margin: 0;
