---
import { cmsAttrs, cmsText } from '../../cms/content';

const trustPoints = [
  {
    key: 'home.hero.trust.interlocutors',
    note: 'Un point de contact identifié',
    href: '/equipe',
  },
  {
    key: 'home.hero.trust.secured_missions',
    note: 'Contrat et protection sociale',
    href: '/portage-salarial',
  },
  {
    key: 'home.hero.trust.employee_framework',
    note: 'Clients, missions et TJM restent les vôtres',
    href: '/consultants',
  },
  {
    key: 'home.hero.trust.it_expertise',
    note: 'Cyber, data, cloud, produit et agilité',
    href: '/expertises',
  },
];

const heroTitleLines = [
  { key: 'home.hero.editorial.title_line_1', accent: false },
  { key: 'home.hero.editorial.title_line_2', accent: false },
  { key: 'home.hero.editorial.title_line_3', accent: true },
];
---

<section class="editorial-hero" aria-labelledby="home-hero-title">
  <div class="editorial-hero__shell">
    <div class="editorial-hero__copy">
      <p class="editorial-hero__eyebrow" {...cmsAttrs('home.hero.editorial.eyebrow')}>
        {cmsText('home.hero.editorial.eyebrow')}
      </p>

      <h1
        id="home-hero-title"
        class="editorial-hero__title"
      >
        {heroTitleLines.map((line) => (
          <span class:list={['editorial-hero__title-line', { 'is-accent': line.accent }]}>
            <span {...cmsAttrs(line.key)}>{cmsText(line.key)}</span>
          </span>
        ))}
      </h1>

      <p class="editorial-hero__description" {...cmsAttrs('home.hero.editorial.description')}>
        {cmsText('home.hero.editorial.description')}
      </p>

      <div class="editorial-hero__actions">
        <a class="editorial-hero__action editorial-hero__action--primary" href="/simulateur">
          <span {...cmsAttrs('home.hero.editorial_v2.action.simulator')}>{cmsText('home.hero.editorial_v2.action.simulator')}</span>
          <b aria-hidden="true">→</b>
        </a>
        <a class="editorial-hero__action editorial-hero__action--secondary" href="/rendez-vous">
          <span {...cmsAttrs('home.hero.editorial_v2.action.advisor')}>{cmsText('home.hero.editorial_v2.action.advisor')}</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>

      <a class="editorial-hero__enterprise" href="/entreprises">
        <span {...cmsAttrs('home.hero.editorial_v2.action.enterprise')}>{cmsText('home.hero.editorial_v2.action.enterprise')}</span>
        <b aria-hidden="true">↗</b>
      </a>
    </div>

    <div class="editorial-hero__visual" aria-label="Les services The Porters">
      <div class="editorial-hero__stone" aria-hidden="true"></div>
      <div class="editorial-hero__navy" aria-hidden="true"></div>
      <div class="editorial-hero__gold-frame" aria-hidden="true"></div>
      <figure>
        <img
          src="/images/hero/porters-meeting.jpg"
          width="1132"
          height="1389"
          alt="Présentation des services The Porters pendant une réunion de travail"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="editorial-hero__service-note">
        <span>Ce que nous prenons en charge</span>
        <strong>Contrat · Facturation · Paie · Suivi</strong>
      </div>
      <span class="editorial-hero__rail" aria-hidden="true">Contrat · Facturation · Paie · Protection</span>
    </div>
  </div>

  <div class="editorial-hero__trust" aria-label="Repères The Porters">
    <div class="editorial-hero__trust-intro">
      <span>Le cadre, sans le grand discours</span>
      <p>Quatre repères pour comprendre la relation.</p>
    </div>
    <div class="editorial-hero__trust-list">
      {trustPoints.map((point, index) => (
        <a href={point.href} aria-label={`${cmsText(point.key)} — en savoir plus`}>
          <span>0{index + 1}</span>
          <div>
            <strong {...cmsAttrs(point.key)}>{cmsText(point.key)}</strong>
            <small>{point.note}</small>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .editorial-hero {
    --hero-navy: #102630;
    --hero-ink: #203440;
    --hero-gold: #c6a45a;
    overflow: hidden;
    background: #f4f0e8;
    color: var(--hero-ink);
  }

  .editorial-hero__shell {
    position: relative;
    width: 100%;
    height: clamp(45rem, calc(100svh - 14.25rem), 53.25rem);
    min-height: 45rem;
  }

  .editorial-hero__copy {
    position: absolute;
    top: clamp(7rem, 15.2vh, 10.25rem);
    left: clamp(2rem, 4.58vw, 5.5rem);
    z-index: 2;
    width: min(41.5%, 50rem);
  }

  .editorial-hero__eyebrow {
    margin: 0 0 1.25rem;
    color: #a47f34;
    font-size: 0.68rem;
    font-weight: 780;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .editorial-hero__title {
    max-width: none;
    margin: 0;
    color: var(--hero-ink);
    font-family: "Newsreader", "Iowan Old Style", "Baskerville", Georgia, serif;
    font-size: clamp(3.65rem, 3.65vw, 4.4rem);
    font-weight: 480;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .editorial-hero__title-line {
    display: block;
  }

  .editorial-hero__title-line.is-accent > span {
    padding-inline: 0.08em;
    background: linear-gradient(transparent 68%, rgba(198, 164, 90, 0.28) 68%);
    box-decoration-break: clone;
    border-bottom: 2px solid rgba(164, 127, 52, 0.78);
    -webkit-box-decoration-break: clone;
  }

  .editorial-hero__description {
    max-width: 33rem;
    margin: 2.2rem 0 0;
    color: rgba(32, 52, 64, 0.68);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    line-height: 1.72;
  }

  .editorial-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.7rem;
  }

  .editorial-hero__action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    border: 1px solid rgba(32, 52, 64, 0.2);
    border-radius: 999px;
    padding: 0.85rem 1.35rem;
    color: var(--hero-ink);
    font-size: 0.76rem;
    font-weight: 780;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 220ms var(--ease-soft);
  }

  .editorial-hero__action--primary {
    border-color: var(--hero-gold);
    background: var(--hero-gold);
  }

  .editorial-hero__action:hover,
  .editorial-hero__action:focus-visible {
    border-color: var(--hero-navy);
    background: var(--hero-navy);
    color: #fff;
    transform: translateY(-2px);
  }

  .editorial-hero__action b,
  .editorial-hero__enterprise b {
    transition: transform 180ms ease;
  }

  .editorial-hero__action:hover b,
  .editorial-hero__enterprise:hover b {
    transform: translateX(0.2rem);
  }

  .editorial-hero__enterprise {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    color: rgba(32, 52, 64, 0.72);
    font-size: 0.72rem;
    font-weight: 730;
  }

  .editorial-hero__enterprise:hover {
    color: var(--hero-ink);
  }

  .editorial-hero__visual {
    position: absolute;
    top: .75rem;
    right: 0;
    bottom: 0;
    left: 44.58%;
    isolation: isolate;
  }

  .editorial-hero__stone {
    position: absolute;
    top: 14.2%;
    bottom: 0;
    left: 0;
    width: 38.7%;
    z-index: -3;
    background: #e8e1d5;
  }

  .editorial-hero__navy {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 10.8%;
    left: 21.05%;
    z-index: -2;
    background: var(--hero-navy);
  }

  .editorial-hero__gold-frame {
    position: absolute;
    top: 7.1%;
    bottom: 2.2%;
    left: 9.2%;
    width: 55.65%;
    z-index: -1;
    border: 1px solid rgba(198, 164, 90, 0.72);
  }

  .editorial-hero__visual figure {
    position: absolute;
    top: 3.9%;
    bottom: 5.4%;
    left: 6.77%;
    width: 55.65%;
    margin: 0;
    overflow: hidden;
    background: #d8d3c8;
    box-shadow: 0 30px 70px rgba(16, 38, 48, 0.24);
  }

  .editorial-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 43%;
    transition: transform 900ms var(--ease-soft);
  }

  .editorial-hero__visual:hover img {
    transform: scale(1.018);
  }

  .editorial-hero__service-note {
    position: absolute;
    right: 0;
    bottom: 3.2%;
    z-index: 2;
    display: grid;
    width: min(21rem, 70%);
    gap: 0.42rem;
    border-left: 3px solid var(--hero-gold);
    padding: 1rem 1.2rem;
    background: rgba(244, 240, 232, 0.96);
    box-shadow: 0 16px 34px rgba(16, 38, 48, 0.13);
  }

  .editorial-hero__rail {
    position: absolute;
    top: 24%;
    right: 5.5%;
    color: rgba(255,255,255,.38);
    font-size: .56rem;
    font-weight: 700;
    letter-spacing: .25em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .editorial-hero__service-note span {
    color: #a47f34;
    font-size: 0.54rem;
    font-weight: 780;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .editorial-hero__service-note strong {
    color: var(--hero-ink);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .editorial-hero__trust {
    display: grid;
    min-height: 7.75rem;
    grid-template-columns: minmax(14rem, 0.32fr) minmax(0, 1fr);
    border-top: 1px solid rgba(32, 52, 64, 0.11);
    background: #fff;
  }

  .editorial-hero__trust-intro {
    display: grid;
    align-content: center;
    padding: 1.6rem clamp(1.5rem, 4vw, 4rem);
    border-right: 1px solid rgba(32, 52, 64, 0.11);
    text-align: right;
  }

  .editorial-hero__trust-intro span {
    color: var(--hero-ink);
    font-size: 0.72rem;
    font-weight: 760;
  }

  .editorial-hero__trust-intro p {
    margin: 0.35rem 0 0;
    color: rgba(32, 52, 64, 0.52);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .editorial-hero__trust-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .editorial-hero__trust-list > a {
    display: grid;
    min-width: 0;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.72rem;
    padding: 1.45rem 1.2rem;
    border-right: 1px solid rgba(32, 52, 64, 0.08);
    color: inherit;
    transition: background-color 180ms ease, transform 220ms var(--ease-soft);
  }

  .editorial-hero__trust-list > a:hover,
  .editorial-hero__trust-list > a:focus-visible {
    background: rgba(198, 164, 90, 0.09);
    outline: none;
    transform: translateY(-2px);
  }

  .editorial-hero__trust-list > a > span {
    color: #b79245;
    font: 700 0.55rem/1 var(--font-mono);
  }

  .editorial-hero__trust-list > a > b {
    color: #b79245;
    font-size: .7rem;
    transition: transform 180ms ease;
  }

  .editorial-hero__trust-list > a:hover > b,
  .editorial-hero__trust-list > a:focus-visible > b {
    transform: translate(2px,-2px);
  }

  .editorial-hero__trust-list strong,
  .editorial-hero__trust-list small {
    display: block;
  }

  .editorial-hero__trust-list strong {
    color: var(--hero-ink);
    font-size: 0.72rem;
  }

  .editorial-hero__trust-list small {
    margin-top: 0.22rem;
    color: rgba(32, 52, 64, 0.48);
    font-size: 0.61rem;
    line-height: 1.35;
  }

  @media (max-width: 1180px) and (min-width: 801px) {
    .editorial-hero__shell {
      height: 45rem;
    }

    .editorial-hero__title {
      font-size: clamp(3.3rem, 5.4vw, 4rem);
    }

    .editorial-hero__trust {
      grid-template-columns: 1fr;
    }

    .editorial-hero__trust-intro {
      display: none;
    }
  }

  @media (min-width: 1181px) {
    .editorial-hero__title-line.is-accent {
      white-space: nowrap;
    }
  }

  @media (max-width: 800px) {
    .editorial-hero__shell {
      display: grid;
      grid-template-columns: 1fr;
      height: auto;
      min-height: 0;
      gap: 3.25rem;
      width: min(100% - 3rem, 44rem);
      margin-inline: auto;
      padding-block: 4.5rem 3rem;
    }

    .editorial-hero__copy {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      max-width: 44rem;
    }

    /*
      15vw resolved to ~115px at 768px, so the headline filled the viewport and
      pushed the lead and both CTAs below the fold. It also forced accent lines to
      wrap mid-phrase, which split the gold highlight into two misaligned bars:
      box-decoration-break was already correct, the wrap was the real cause.
      8.5vw keeps the editorial scale without either problem.
    */
    .editorial-hero__title {
      max-width: 14ch;
      font-size: clamp(3rem, 8.5vw, 4.6rem);
    }

    .editorial-hero__visual {
      position: relative;
      inset: auto;
      min-height: clamp(31rem, 110vw, 42rem);
    }

    .editorial-hero__navy {
      right: -20vw;
      left: 10%;
    }

    .editorial-hero__gold-frame { right:2%;bottom:0;left:4%;width:auto; }
    .editorial-hero__visual figure { inset:5% 9% 4% 10%;width:auto; }
    .editorial-hero__stone,.editorial-hero__rail { display:none; }

    .editorial-hero__trust-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .editorial-hero__shell {
      width: min(100% - 2rem, 96rem);
      padding-top: 3.6rem;
    }

    /* 17vw was ~66px on a 390px screen: "À chaque étape." could not hold one line. */
    .editorial-hero__title {
      max-width: 15ch;
      font-size: clamp(2.35rem, 10.5vw, 3.3rem);
    }

    .editorial-hero__actions {
      display: grid;
    }

    .editorial-hero__action {
      width: 100%;
    }

    .editorial-hero__visual {
      min-height: 30rem;
    }

    .editorial-hero__visual figure {
      inset: 6% 4% 0 9%;
    }

    .editorial-hero__service-note {
      right: -0.25rem;
      width: 82%;
    }

    .editorial-hero__trust-list {
      grid-template-columns: 1fr;
    }

    .editorial-hero__trust-list > a {
      border-bottom: 1px solid rgba(32, 52, 64, 0.08);
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-hero__visual img,
    .editorial-hero__action,
    .editorial-hero__action b,
    .editorial-hero__enterprise b {
      transition: none;
    }
  }
</style>
