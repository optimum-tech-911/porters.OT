---
import { cmsAttrs, cmsText } from '../../cms/content';
import { googleReviewHighlights } from '../../content/pages/home';
import { helloWorkUrl } from '../../data/hello-work.data';

type HeroJob = {
  title: string;
  city: string;
  contract: string;
  salary: string;
  href: string;
};

interface Props {
  jobs?: HeroJob[];
}

const { jobs = [] } = Astro.props;
const reviewNotes = googleReviewHighlights;

const heroTitleLines = [
  { key: 'home.hero.editorial.title_line_1', accent: false },
  { key: 'home.hero.editorial.title_line_2', accent: false },
  { key: 'home.hero.editorial.title_line_3', accent: true },
];
---

<section class="editorial-hero" data-motion-scene aria-labelledby="home-hero-title">
  <div class="editorial-hero__shell">
    <div class="editorial-hero__copy">
      <p class="editorial-hero__eyebrow" {...cmsAttrs('home.hero.editorial.eyebrow')}>
        {cmsText('home.hero.editorial.eyebrow')}
      </p>

      <h1
        id="home-hero-title"
        class="editorial-hero__title"
      >
        {heroTitleLines.map((line) => (
          <span class:list={['editorial-hero__title-line', { 'is-accent': line.accent }]}>
            <span {...cmsAttrs(line.key)}>{cmsText(line.key)}</span>
          </span>
        ))}
      </h1>

      <p class="editorial-hero__description" {...cmsAttrs('home.hero.editorial.description')}>
        {cmsText('home.hero.editorial.description')}
      </p>

      <div class="editorial-hero__actions">
        <a class="editorial-hero__action editorial-hero__action--primary" href="/simulateur">
          <span {...cmsAttrs('home.hero.editorial_v2.action.simulator')}>{cmsText('home.hero.editorial_v2.action.simulator')}</span>
          <b aria-hidden="true">→</b>
        </a>
        <a class="editorial-hero__action editorial-hero__action--secondary" href="/rendez-vous">
          <span {...cmsAttrs('home.hero.editorial_v2.action.advisor')}>{cmsText('home.hero.editorial_v2.action.advisor')}</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>

      <a class="editorial-hero__enterprise" href="/entreprises">
        <span {...cmsAttrs('home.hero.editorial_v2.action.enterprise')}>{cmsText('home.hero.editorial_v2.action.enterprise')}</span>
        <b aria-hidden="true">↗</b>
      </a>
    </div>

    <div class="editorial-hero__visual" aria-label="L’accompagnement The Porters et les avis clients">
      <div class="editorial-hero__stone" aria-hidden="true"></div>
      <div class="editorial-hero__navy" aria-hidden="true"></div>
      <div class="editorial-hero__gold-frame" aria-hidden="true"></div>
      <figure>
        <img
          src="/images/hero/porters-meeting.jpg"
          width="1132"
          height="1389"
          alt="Présentation des services The Porters pendant une réunion de travail"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="editorial-hero__review-notes" aria-label="Avis clients">
        {reviewNotes.map((review, index) => (
          <article
            class:list={['editorial-hero__review-note', `editorial-hero__review-note--${index + 1}`]}
            style={`--review-delay:${index * 4.5}s`}
          >
            <span aria-label="5 étoiles sur 5">★★★★★</span>
            <p>«&nbsp;{review.quote}&nbsp;»</p>
            <strong>{review.author}</strong>
            <small>Avis Google</small>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="editorial-hero__jobs" aria-label="Offres The Porters sur HelloWork">
    <a
      class="editorial-hero__jobs-intro"
      href={helloWorkUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>HelloWork</span>
      <strong>Offres The Porters</strong>
      <b aria-hidden="true">↗</b>
    </a>
    <div class="editorial-hero__jobs-marquee">
      <div class="editorial-hero__jobs-track">
        {[false, true].map((duplicate) => (
          <div class="editorial-hero__jobs-group" aria-hidden={duplicate ? 'true' : undefined}>
            {jobs.map((job) => (
              <a
                href={helloWorkUrl}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={duplicate ? -1 : undefined}
                data-hero-job
                data-job-title={job.title}
                data-job-salary={job.salary}
                data-job-meta={`${job.city} · ${job.contract}`}
                aria-label={`${job.title}, ${job.salary} — voir toutes les offres The Porters sur HelloWork`}
              >
                <div class="editorial-hero__job-copy">
                  <span>{job.salary}</span>
                  <strong>{job.title}</strong>
                  <small>{job.city} · {job.contract}</small>
                </div>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="editorial-hero__job-preview" id="hero-job-preview" aria-hidden="true" hidden>
    <small>HelloWork · The Porters</small>
    <span data-preview-salary></span>
    <strong data-preview-title></strong>
    <p data-preview-meta></p>
    <b>Voir toutes nos opportunités&nbsp; ↗</b>
  </div>
</section>

<script>
  const heroJobPreview = document.querySelector<HTMLElement>('#hero-job-preview');
  const heroJobTriggers = document.querySelectorAll<HTMLElement>('[data-hero-job]');
  const previewSalary = heroJobPreview?.querySelector<HTMLElement>('[data-preview-salary]');
  const previewTitle = heroJobPreview?.querySelector<HTMLElement>('[data-preview-title]');
  const previewMeta = heroJobPreview?.querySelector<HTMLElement>('[data-preview-meta]');
  let previewHideTimer = 0;
  let previewLeaveTimer = 0;

  const finishHidingJobPreview = () => {
    if (!heroJobPreview) return;
    heroJobPreview.hidden = true;
    heroJobPreview.classList.remove('is-leaving');
  };

  const hideJobPreview = (immediate = false) => {
    window.clearTimeout(previewHideTimer);
    window.clearTimeout(previewLeaveTimer);
    if (!heroJobPreview) return;
    heroJobPreview.classList.remove('is-open');
    heroJobPreview.setAttribute('aria-hidden', 'true');
    if (immediate) {
      finishHidingJobPreview();
      return;
    }
    heroJobPreview.classList.add('is-leaving');
    previewLeaveTimer = window.setTimeout(finishHidingJobPreview, 190);
  };

  const showJobPreview = (trigger: HTMLElement) => {
    if (!heroJobPreview) return;
    window.clearTimeout(previewHideTimer);
    window.clearTimeout(previewLeaveTimer);
    if (previewSalary) previewSalary.textContent = trigger.dataset.jobSalary || '';
    if (previewTitle) previewTitle.textContent = trigger.dataset.jobTitle || '';
    if (previewMeta) previewMeta.textContent = trigger.dataset.jobMeta || '';

    heroJobPreview.hidden = false;
    heroJobPreview.classList.remove('is-open', 'is-leaving');
    heroJobPreview.setAttribute('aria-hidden', 'false');

    requestAnimationFrame(() => {
      const rect = trigger.getBoundingClientRect();
      const width = heroJobPreview.offsetWidth;
      const height = heroJobPreview.offsetHeight;
      const left = Math.min(window.innerWidth - width - 12, Math.max(12, rect.left + rect.width / 2 - width / 2));
      const preferredTop = rect.top - height - 14;
      const opensAbove = preferredTop > 12;
      const top = opensAbove ? preferredTop : Math.min(window.innerHeight - height - 12, rect.bottom + 14);
      const originX = Math.min(width - 24, Math.max(24, rect.left + rect.width / 2 - left));
      heroJobPreview.style.left = `${left}px`;
      heroJobPreview.style.top = `${top}px`;
      heroJobPreview.style.setProperty('--preview-origin-x', `${originX}px`);
      heroJobPreview.style.setProperty('--preview-origin-y', opensAbove ? '100%' : '0%');
      heroJobPreview.style.setProperty('--preview-drift', opensAbove ? '12px' : '-12px');
      requestAnimationFrame(() => heroJobPreview.classList.add('is-open'));
    });
  };

  // Keep the preview outside the hero's overflow and stacking context.
  if (heroJobPreview && heroJobPreview.parentElement !== document.body) {
    document.body.append(heroJobPreview);
  }

  heroJobTriggers.forEach((trigger) => {
    trigger.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'touch') showJobPreview(trigger);
    });
    trigger.addEventListener('pointerleave', () => {
      previewHideTimer = window.setTimeout(hideJobPreview, 100);
    });
    trigger.addEventListener('focus', () => showJobPreview(trigger));
    trigger.addEventListener('blur', () => hideJobPreview());
  });

  window.addEventListener('scroll', () => hideJobPreview(true), { passive: true });
  window.addEventListener('resize', () => hideJobPreview(true));
</script>

<style>
  .editorial-hero {
    --hero-navy: #102630;
    --hero-ink: #203440;
    --hero-gold: #c6a45a;
    overflow: hidden;
    background: #f4f0e8;
    color: var(--hero-ink);
  }

  .editorial-hero__shell {
    position: relative;
    width: 100%;
    height: clamp(45rem, calc(100svh - 14.25rem), 53.25rem);
    min-height: 45rem;
  }

  .editorial-hero__copy {
    position: absolute;
    top: clamp(7rem, 15.2vh, 10.25rem);
    left: clamp(2rem, 4.58vw, 5.5rem);
    z-index: 2;
    width: min(46%, 55rem);
  }

  .editorial-hero__eyebrow,
  .editorial-hero__title-line,
  .editorial-hero__description,
  .editorial-hero__actions,
  .editorial-hero__enterprise {
    opacity: 0;
    animation: hero-copy-arrive 760ms var(--ease-soft) forwards;
  }

  .editorial-hero__eyebrow { animation-delay: 80ms; }
  .editorial-hero__title-line:nth-child(1) { animation-delay: 150ms; }
  .editorial-hero__title-line:nth-child(2) { animation-delay: 235ms; }
  .editorial-hero__title-line:nth-child(3) { animation-delay: 320ms; }
  .editorial-hero__description { animation-delay: 440ms; }
  .editorial-hero__actions { animation-delay: 550ms; }
  .editorial-hero__enterprise { animation-delay: 650ms; }

  .editorial-hero__eyebrow {
    margin: 0 0 1.25rem;
    color: #a47f34;
    font-size: clamp(0.82rem, 0.9vw, 1rem);
    font-weight: 780;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .editorial-hero__title {
    max-width: none;
    margin: 0;
    color: var(--hero-ink);
    font-family: "Newsreader", "Iowan Old Style", "Baskerville", Georgia, serif;
    font-size: clamp(4.25rem, 4.45vw, 5.35rem);
    font-weight: 480;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .editorial-hero__title-line {
    display: block;
  }

  .editorial-hero__title-line.is-accent > span {
    padding-inline: 0.08em;
    background: linear-gradient(transparent 68%, rgba(198, 164, 90, 0.28) 68%);
    box-decoration-break: clone;
    border-bottom: 2px solid rgba(164, 127, 52, 0.78);
    -webkit-box-decoration-break: clone;
  }

  .editorial-hero__description {
    max-width: 33rem;
    margin: 2.2rem 0 0;
    color: rgba(32, 52, 64, 0.68);
    max-width: 38rem;
    font-size: clamp(1.15rem, 1.4vw, 1.32rem);
    line-height: 1.72;
  }

  .editorial-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.7rem;
  }

  .editorial-hero__action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    border: 1px solid rgba(32, 52, 64, 0.2);
    border-radius: 999px;
    padding: 0.85rem 1.35rem;
    color: var(--hero-ink);
    font-size: clamp(0.9rem, 0.92vw, 1rem);
    font-weight: 780;
    opacity: 1;
    animation: hero-button-pop 720ms var(--ease-soft) backwards;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 220ms var(--ease-soft);
  }

  .editorial-hero__action:nth-child(1) { animation-delay: 620ms; }
  .editorial-hero__action:nth-child(2) { animation-delay: 720ms; }

  .editorial-hero__action--primary {
    border-color: var(--hero-gold);
    background: var(--hero-gold);
  }

  .editorial-hero__action:hover,
  .editorial-hero__action:focus-visible {
    border-color: var(--hero-navy);
    background: var(--hero-navy);
    color: #fff;
    transform: translateY(-2px);
  }

  .editorial-hero__action b,
  .editorial-hero__enterprise b {
    transition: transform 180ms ease;
  }

  .editorial-hero__action:hover b,
  .editorial-hero__enterprise:hover b {
    transform: translateX(0.2rem);
  }

  .editorial-hero__enterprise {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    color: rgba(32, 52, 64, 0.72);
    font-size: 0.72rem;
    font-weight: 730;
  }

  .editorial-hero__enterprise:hover {
    color: var(--hero-ink);
  }

  .editorial-hero__visual {
    position: absolute;
    top: .75rem;
    right: 0;
    bottom: 0;
    left: 44.58%;
    isolation: isolate;
    opacity: 0;
    animation: hero-visual-arrive 980ms 240ms var(--ease-soft) forwards;
  }

  .editorial-hero__stone {
    position: absolute;
    top: 14.2%;
    bottom: 0;
    left: 0;
    width: 38.7%;
    z-index: -3;
    background: #e8e1d5;
  }

  .editorial-hero__navy {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 10.8%;
    left: 21.05%;
    z-index: -2;
    background: var(--hero-navy);
  }

  .editorial-hero__gold-frame {
    position: absolute;
    top: 7.1%;
    bottom: 2.2%;
    left: 9.2%;
    width: 55.65%;
    z-index: -1;
    border: 1px solid rgba(198, 164, 90, 0.72);
  }

  .editorial-hero__visual figure {
    position: absolute;
    top: 3.9%;
    bottom: 5.4%;
    left: 6.77%;
    width: 55.65%;
    margin: 0;
    overflow: hidden;
    background: #d8d3c8;
    box-shadow: 0 30px 70px rgba(16, 38, 48, 0.24);
  }

  .editorial-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 43%;
    transition: transform 900ms var(--ease-soft);
  }

  .editorial-hero__visual:hover img {
    transform: scale(1.018);
  }

  .editorial-hero__review-notes {
    position: absolute;
    top: 10%;
    right: 4.5%;
    bottom: 10%;
    z-index: 2;
    width: min(15rem, 31%);
    pointer-events: none;
  }

  .editorial-hero__review-note {
    position: absolute;
    width: 100%;
    border: 1px solid rgba(198, 164, 90, 0.48);
    border-radius: 0.85rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 45px rgba(5, 20, 27, 0.22);
    opacity: 0;
    transform-origin: 85% 100%;
    animation: hero-review-cycle 13.5s var(--ease-soft) infinite both;
    animation-delay: calc(1.15s + var(--review-delay));
  }

  .editorial-hero__review-note--1 {
    top: 7%;
    right: 0;
  }

  .editorial-hero__review-note--2,
  .editorial-hero__review-note--3 {
    right: 16%;
    bottom: 6%;
    transform-origin: 15% 100%;
  }

  .editorial-hero__review-note--3 {
    right: 2%;
    bottom: 30%;
  }

  .editorial-hero__review-note > span {
    color: var(--hero-gold);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .editorial-hero__review-note p {
    margin: 0.65rem 0 0.8rem;
    color: var(--hero-ink);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .editorial-hero__review-note strong,
  .editorial-hero__review-note small {
    display: block;
  }

  .editorial-hero__review-note strong {
    color: var(--hero-ink);
    font-size: 0.68rem;
  }

  .editorial-hero__review-note small {
    margin-top: 0.12rem;
    color: rgba(32, 52, 64, 0.52);
    font-size: 0.58rem;
  }

  .editorial-hero__jobs {
    display: grid;
    min-height: 7.25rem;
    grid-template-columns: minmax(12rem, 0.24fr) minmax(0, 1fr);
    border-top: 1px solid rgba(32, 52, 64, 0.11);
    background: #fff;
    opacity: 0;
    animation: hero-jobs-arrive 820ms 840ms var(--ease-soft) forwards;
  }

  .editorial-hero__jobs-intro {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 1.35rem clamp(1.25rem, 3vw, 3rem);
    border-right: 1px solid rgba(32, 52, 64, 0.11);
    color: var(--hero-ink);
  }

  .editorial-hero__jobs-intro span {
    color: #a47f34;
    font-size: 0.56rem;
    font-weight: 780;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .editorial-hero__jobs-intro strong {
    margin-top: 0.25rem;
    font-size: 0.82rem;
  }

  .editorial-hero__jobs-intro b {
    position: absolute;
    opacity: 0;
  }

  .editorial-hero__jobs-marquee {
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .editorial-hero__jobs-track {
    display: flex;
    width: max-content;
    height: 100%;
    animation: hero-jobs-scroll 26s linear infinite;
    will-change: transform;
  }

  .editorial-hero__jobs-marquee:hover .editorial-hero__jobs-track,
  .editorial-hero__jobs-marquee:focus-within .editorial-hero__jobs-track {
    animation-play-state: paused;
  }

  .editorial-hero__jobs-group {
    display: flex;
    height: 100%;
  }

  .editorial-hero__jobs-group > a {
    position: relative;
    display: grid;
    width: clamp(14rem, 20vw, 19rem);
    min-width: clamp(14rem, 20vw, 19rem);
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-right: 1px solid rgba(32, 52, 64, 0.09);
    color: var(--hero-ink);
    transition: background 180ms ease, box-shadow 220ms ease;
  }

  .editorial-hero__jobs-group > a:hover,
  .editorial-hero__jobs-group > a:focus-visible {
    background: rgba(198, 164, 90, 0.09);
    box-shadow: inset 0 3px 0 var(--hero-gold);
    outline: none;
  }

  .editorial-hero__jobs-group strong,
  .editorial-hero__jobs-group small {
    display: block;
  }

  .editorial-hero__jobs-group strong {
    color: var(--hero-ink);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .editorial-hero__job-copy > span {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.42rem;
    border-radius: 999px;
    padding: 0.28rem 0.55rem;
    background: var(--hero-navy);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 820;
    letter-spacing: -0.01em;
    box-shadow: 0 7px 18px rgba(16, 38, 48, 0.16);
  }

  .editorial-hero__jobs-group small {
    margin-top: 0.3rem;
    color: rgba(32, 52, 64, 0.55);
    font-size: 0.62rem;
  }

  .editorial-hero__jobs-group b {
    color: var(--hero-gold);
    font-size: 0.78rem;
  }

  .editorial-hero__job-preview {
    --preview-origin-x: 50%;
    --preview-origin-y: 100%;
    --preview-drift: 12px;
    position: fixed;
    inset: auto;
    z-index: 2147483000;
    display: grid;
    width: min(21rem, calc(100vw - 1.5rem));
    gap: 0.35rem;
    border: 1px solid rgba(198, 164, 90, 0.45);
    border-radius: 0.85rem;
    margin: 0;
    padding: 1rem;
    background: rgba(16, 38, 48, 0.98);
    color: #fff;
    box-shadow: 0 24px 55px rgba(5, 20, 27, 0.3);
    opacity: 0;
    visibility: hidden;
    clip-path: inset(82% 42% 0 42% round 0.85rem);
    transform: translateY(var(--preview-drift)) scale(0.18, 0.08);
    transform-origin: var(--preview-origin-x) var(--preview-origin-y);
    filter: blur(5px);
    transition:
      opacity 150ms ease,
      visibility 150ms ease,
      clip-path 390ms cubic-bezier(0.2, 0.9, 0.25, 1),
      transform 390ms cubic-bezier(0.2, 1.2, 0.3, 1),
      filter 260ms ease;
    pointer-events: none;
  }

  .editorial-hero__job-preview[hidden] {
    display: none;
  }

  .editorial-hero__job-preview::after {
    position: absolute;
    left: var(--preview-origin-x);
    width: 0.75rem;
    height: 0.75rem;
    border-right: 1px solid rgba(198, 164, 90, 0.45);
    border-bottom: 1px solid rgba(198, 164, 90, 0.45);
    background: #102630;
    content: '';
    transform: translateX(-50%) rotate(45deg);
  }

  .editorial-hero__job-preview[style*="100%"]::after {
    bottom: -0.42rem;
  }

  .editorial-hero__job-preview[style*="0%"]::after {
    top: -0.42rem;
    transform: translateX(-50%) rotate(225deg);
  }

  .editorial-hero__job-preview small {
    margin: 0;
    color: #d8bb70;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .editorial-hero__job-preview > span {
    display: inline-flex;
    width: fit-content;
    margin-block: 0.25rem;
    border-radius: 999px;
    padding: 0.38rem 0.62rem;
    background: var(--hero-gold);
    color: var(--hero-navy);
    font-size: 0.74rem;
    font-weight: 820;
  }

  .editorial-hero__job-preview strong {
    color: #fff;
    font-size: 0.9rem;
  }

  .editorial-hero__job-preview p {
    margin: 0;
    color: rgba(255,255,255,.62);
    font-size: .68rem;
  }

  .editorial-hero__job-preview b {
    margin-top: 0.35rem;
    color: #f2d996;
    font-size: 0.68rem;
  }

  .editorial-hero__job-preview.is-open {
    opacity: 1;
    visibility: visible;
    clip-path: inset(0 round 0.85rem);
    transform: none;
    filter: none;
  }

  .editorial-hero__job-preview.is-leaving {
    opacity: 0;
    visibility: hidden;
    clip-path: inset(82% 42% 0 42% round 0.85rem);
    transform: translateY(var(--preview-drift)) scale(0.18, 0.08);
    filter: blur(4px);
  }

  @keyframes hero-jobs-scroll {
    to { transform: translateX(-50%); }
  }

  @keyframes hero-review-cycle {
    0% {
