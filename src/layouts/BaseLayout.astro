---
import '../styles/global.css';
import ChatbotAssistant from '../components/Chatbot/ChatbotAssistant.astro';
import CmsRuntime from '../components/cms/CmsRuntime.astro';
import HelloWorkOpportunityPopup from '../components/ui/HelloWorkOpportunityPopup.astro';
import { supabaseUrl } from '../lib/supabase';

interface Props {
  seo: {
    title: string;
    description: string;
    canonical?: string;
    ogImage?: string;
    type?: 'website' | 'article';
    noindex?: boolean;
    structuredData?: Record<string, unknown>;
  };
}

const { seo } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://www.porters.fr');
const canonicalUrl = seo.canonical || (Astro.url.pathname === '/'
  ? siteUrl.origin
  : new URL(Astro.url.pathname, siteUrl).toString());
const ogImage = seo.ogImage || new URL('/images/seo/portage-salarial-it-social.jpg', siteUrl).toString();
const siteName = 'The Porters';
const logoUrl = new URL('/favicon.svg', siteUrl).toString();
const organizationId = 'https://www.porters.fr/#organization';

// Organization structured data (global)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: 'The Porters',
  legalName: 'THE PORTERS',
  url: 'https://www.porters.fr',
  logo: logoUrl,
  description: 'Portage salarial pour consultants IT : contrats, facturation, paie et suivi administratif dans un cadre lisible.',
  email: 'contact@porters.fr',
  telephone: '+33768670850',
  vatID: 'FR42828954735',
  taxID: '828954735',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '120 rue de Thor',
    postalCode: '34000',
    addressLocality: 'Montpellier',
    addressCountry: 'FR',
  },
  areaServed: {
    '@type': 'Country',
    name: 'France',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'contact@porters.fr',
    telephone: '+33768670850',
    availableLanguage: 'French',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.porters.fr/#website',
  url: 'https://www.porters.fr/',
  name: siteName,
  inLanguage: 'fr-FR',
  publisher: { '@id': organizationId },
};

// Breadcrumb structured data
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: 'https://www.porters.fr',
    },
    ...pathSegments.map((segment, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
      item: `https://www.porters.fr/${pathSegments.slice(0, index + 1).join('/')}`,
    })),
  ],
} : null;

const allStructuredData = [
  organizationSchema,
  websiteSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(seo.structuredData ? [seo.structuredData] : []),
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Public CMS copy is resolved before the page becomes visible. The HTML
         fallback stays available to crawlers and visitors without JavaScript. -->
    <link rel="preconnect" href={supabaseUrl} crossorigin />
    <style is:inline>
      body > :not(#cms-loading-cover) { transition: opacity .48s cubic-bezier(.22, 1, .36, 1); }
      html.cms-loading body > :not(#cms-loading-cover) { opacity: 0 !important; pointer-events: none !important; }
      #cms-loading-cover {
        position: fixed;
        z-index: 9999;
        inset: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #f5f1e9;
        color: #203440;
        text-align: center;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .46s ease, visibility 0s linear .46s;
      }
      html.cms-loading #cms-loading-cover { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity .2s ease; }
      #cms-loading-cover::before,
      #cms-loading-cover::after {
        position: absolute;
        width: min(74vw, 48rem);
        aspect-ratio: 1;
        border: 1px solid rgba(185, 147, 75, .14);
        border-radius: 50%;
        content: '';
        pointer-events: none;
      }
      #cms-loading-cover::before { top: -24rem; left: -17rem; animation: cms-loading-orbit 7s ease-in-out infinite alternate; }
      #cms-loading-cover::after { right: -18rem; bottom: -25rem; animation: cms-loading-orbit 8s ease-in-out infinite alternate-reverse; }
      .cms-loading-content { position: relative; z-index: 1; display: grid; justify-items: center; gap: 1rem; padding: 2rem; }
      .cms-loading-emblem { position: relative; display: grid; place-items: center; width: 4rem; height: 4rem; margin-bottom: .3rem; border: 1px solid rgba(185, 147, 75, .55); border-radius: 50%; }
      .cms-loading-emblem::before { position: absolute; inset: -.42rem; border: 1px dashed rgba(185, 147, 75, .45); border-radius: 50%; content: ''; animation: cms-loading-spin 8s linear infinite; }
      .cms-loading-emblem::after { width: .7rem; height: .7rem; background: #bc9953; border-radius: 50%; content: ''; animation: cms-loading-breathe 1.7s ease-in-out infinite; }
      .cms-loading-content strong { font: 600 clamp(2rem, 6vw, 3rem)/1 Georgia, serif; letter-spacing: -.045em; }
      .cms-loading-content small { font: 500 .7rem/1.4 system-ui, sans-serif; letter-spacing: .18em; text-transform: uppercase; color: #79858a; }
      .cms-loading-track { display: block; width: 9rem; height: 2px; margin: .35rem auto 0; overflow: hidden; background: #e4d8bf; }
      .cms-loading-track::after { display: block; width: 40%; height: 100%; background: #b9934b; content: ''; animation: cms-loading-progress 1.4s cubic-bezier(.65, 0, .35, 1) infinite alternate; }
      @keyframes cms-loading-progress { to { transform: translateX(5.4rem); } }
      @keyframes cms-loading-spin { to { transform: rotate(360deg); } }
      @keyframes cms-loading-breathe { 50% { opacity: .45; transform: scale(.65); } }
      @keyframes cms-loading-orbit { to { transform: translate(2rem, -1.5rem) scale(1.07); } }
      @media (prefers-reduced-motion: reduce) {
        body > :not(#cms-loading-cover), #cms-loading-cover { transition-duration: .01ms; }
        #cms-loading-cover::before, #cms-loading-cover::after, .cms-loading-emblem::before, .cms-loading-emblem::after, .cms-loading-track::after { animation: none; }
        .cms-loading-track::after { width: 100%; }
      }
    </style>
    <script is:inline>
      if (new URLSearchParams(location.search).get('cms-editor') !== '1') {
        const root = document.documentElement;
        root.dataset.cmsGateState = 'pending';
        root.classList.add('cms-loading');
        // A failed or slow CMS request must never leave the site invisible.
        setTimeout(() => {
          if (root.dataset.cmsGateState !== 'pending') return;
          root.dataset.cmsGateState = 'expired';
          root.classList.remove('cms-loading');
        }, 5000);
      }
    </script>

    <!-- SEO -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonicalUrl} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="describedby" href="/llms.txt" />

    <!-- Open Graph -->
    <meta property="og:type" content={seo.type || 'website'} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="The Porters accompagne les consultants IT en portage salarial en France." />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="The Porters accompagne les consultants IT en portage salarial en France." />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400..600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    {allStructuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    ))}
  </head>
  <body class="bg-porters-white text-porters-black font-body antialiased">
    <div id="cms-loading-cover" role="status" aria-live="polite" data-cms-ignore>
      <div class="cms-loading-content">
        <span class="cms-loading-emblem" aria-hidden="true"></span>
        <strong>The Porters</strong>
        <small>Préparation de votre visite</small>
        <span class="cms-loading-track" aria-hidden="true"></span>
      </div>
    </div>
    <div class="page-scroll-progress" aria-hidden="true"></div>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <ChatbotAssistant />
    {Astro.url.pathname.replace(/\/$/, '') === '' && <HelloWorkOpportunityPopup />}
    <CmsRuntime />

    <!-- Orchestrated section entrance observer -->
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Keep a lightweight progress cue in sync with the document scroll.
      // One animation frame per scroll burst avoids doing layout work per event.
      const root = document.documentElement;
      let progressFrame = 0;
      const updateScrollProgress = () => {
        const scrollable = root.scrollHeight - window.innerHeight;
        root.style.setProperty('--page-scroll-progress', String(
          scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0
        ));
        progressFrame = 0;
      };
      const queueScrollProgress = () => {
        if (!progressFrame) progressFrame = window.requestAnimationFrame(updateScrollProgress);
      };
      window.addEventListener('scroll', queueScrollProgress, { passive: true });
      window.addEventListener('resize', queueScrollProgress, { passive: true });
      updateScrollProgress();

      // The first viewport should animate when the CMS cover begins to leave,
      // rather than finishing its entrance unseen behind the cover.
      const afterCmsReveal = (start: () => void) => {
        if (!root.classList.contains('cms-loading')) { start(); return; }
        const readyObserver = new MutationObserver(() => {
          if (root.classList.contains('cms-loading')) return;
          readyObserver.disconnect();
          window.setTimeout(start, 80);
        });
        readyObserver.observe(root, { attributes: true, attributeFilter: ['class'] });
      };

      /* Sections with hand-authored choreography replay when they re-enter the
         viewport. Each pass rotates the direction/shape so the motion responds
         to the scroll instead of behaving like a one-time page-load effect. */
      const motionSections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-motion-section]')
      );
      const sectionPasses = new WeakMap<HTMLElement, number>();
      const sectionFrames = new WeakMap<HTMLElement, number>();

      motionSections.forEach((section, sectionIndex) => {
        const items = Array.from(section.querySelectorAll<HTMLElement>('[data-motion-item]'));
        section.classList.add('motion-section-ready');
        sectionPasses.set(section, sectionIndex % 4);
        items.forEach((item, index) => {
          if (!item.style.getPropertyValue('--motion-order')) {
            item.style.setProperty('--motion-order', String(Math.min(index, 12)));
          }
        });
      });

      if (reducedMotion || !('IntersectionObserver' in window)) {
        motionSections.forEach((section) => {
          section.classList.add('is-motion-visible');
        });
      } else {
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const section = entry.target as HTMLElement;
              if (entry.isIntersecting) {
                const pass = sectionPasses.get(section) || 0;
                section.dataset.scrollMotionVariant = String(pass % 4);
                sectionPasses.set(section, pass + 1);
                const frame = (sectionFrames.get(section) || 0) + 1;
                sectionFrames.set(section, frame);
                section.classList.remove('is-motion-visible');
                window.requestAnimationFrame(() => {
                  const bounds = section.getBoundingClientRect();
                  if (sectionFrames.get(section) === frame && bounds.bottom > 0 && bounds.top < window.innerHeight) {
                    section.classList.add('is-motion-visible');
                  }
                });
              } else {
                sectionFrames.set(section, (sectionFrames.get(section) || 0) + 1);
                section.classList.remove('is-motion-visible');
              }
            });
          },
          { threshold: 0.04, rootMargin: '0px 0px -6% 0px' }
        );

        afterCmsReveal(() => motionSections.forEach((section) => sectionObserver.observe(section)));
      }

      const motionOwnedSelector = [
        '[data-motion-section]',
        '[data-motion-scene]',
        '[data-project-lab]',
        '[data-expertise-lab]',
        '[data-expertise-constellation]',
        '[data-expertise-workbench]',
        '[data-expertise-journey]',
        '[data-enterprise-process]',
        '[data-history-schema]',
        '[data-method-lab]',
        '[data-offer-schema]',
        '[data-table-man]',
        '[data-tri]',
        '[data-home-proof]',
        '.auto-marquee',
        '[class*="marquee__track"]',
      ].join(',');

      const isMotionOwned = (element: Element) =>
        element.matches(motionOwnedSelector) || Boolean(element.querySelector(motionOwnedSelector));

      const belongsToMotionOwner = (element: Element) =>
        isMotionOwned(element) || Boolean(element.closest(motionOwnedSelector));

      document.querySelectorAll<HTMLElement>('main section').forEach((section, sectionIndex) => {
        section.dataset.scrollMotionSection = String(sectionIndex);
        const sectionReveal = section.matches('[data-reveal], .reveal') ? [section] : [];
        const existing = [
          ...sectionReveal,
          ...Array.from(section.querySelectorAll<HTMLElement>('[data-reveal], .reveal')),
        ];

        // Never stack the global reveal over a component that already owns its
        // animation timeline. This keeps marquees, diagrams and interactive
        // scenes smooth instead of making them animate twice.
        existing.filter(belongsToMotionOwner).forEach((element) => {
          element.classList.remove('reveal', 'reveal-up', 'reveal-fade', 'reveal-scale');
          element.removeAttribute('data-reveal');
        });

        const activeExisting = existing.filter((element) => !belongsToMotionOwner(element));

        // Sections without explicit reveal markup still get an entrance on their
        // direct content blocks. Components with their own continuous animation
        // retain full ownership of their timing.
        if (activeExisting.length === 0) {
          const shell = section.querySelector<HTMLElement>(':scope > .container, :scope > [class*="shell"]') || section;
          Array.from(shell.children)
            .filter((child): child is HTMLElement =>
              child instanceof HTMLElement
              && !child.matches('script,style,[aria-hidden="true"]')
              && !/ambient|background|overlay/i.test(child.className)
              && !belongsToMotionOwner(child)
            )
            .slice(0, 8)
            .forEach((child) => child.classList.add('reveal'));
        }

        // Cards and rows enter in a short cascade instead of appearing as one
        // static slab. Semantic targets keep the effect predictable and avoid
        // touching decorative layers.
        Array.from(section.querySelectorAll<HTMLElement>(
          'article, details, figure, li, tbody > tr, [class*="-card"], [class*="_card"], [class~="card"]'
        ))
          .filter((element) =>
            !element.matches('[data-reveal], .reveal')
            && !belongsToMotionOwner(element)
          )
          .slice(0, 14)
          .forEach((element, index) => {
            element.classList.add('reveal', 'motion-enhanced', 'motion-pop');
            element.style.setProperty('--reveal-delay', `${Math.min((index % 7) * 54, 324)}ms`);
          });

        const reveals = [
          ...(section.matches('[data-reveal], .reveal') ? [section] : []),
          ...Array.from(section.querySelectorAll<HTMLElement>('[data-reveal], .reveal')),
        ]
          .filter((element) => !belongsToMotionOwner(element));

        reveals.forEach((element, index) => {
          element.classList.add('motion-enhanced');

          const looksLikeCard = element.matches('article,li,details,figure')
            || /card|table|faq|portrait|schema|panel|grid/i.test(element.className);
          const looksLikeMedia = element.matches('figure,picture')
            || Boolean(element.querySelector(':scope > img, :scope > video'));

          if (looksLikeCard) element.classList.add('motion-pop');
          else if (looksLikeMedia || index % 2 === 1) element.classList.add('motion-slide-right');
          else element.classList.add('motion-slide-left');

          if (!element.style.getPropertyValue('--reveal-delay')) {
            element.style.setProperty('--reveal-delay', `${Math.min(index * 58, 348)}ms`);
          }
        });
      });

      const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal], .reveal'));
      const revealPasses = new WeakMap<HTMLElement, number>();
      const revealFrames = new WeakMap<HTMLElement, number>();
      const revealStyles = ['rise', 'drift-left', 'drift-right', 'focus'];
      const revealOrder = new WeakMap<HTMLElement, number>();
      revealElements.forEach((element, index) => revealOrder.set(element, index));

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealElements.forEach((element) => {
          element.classList.add('visible', 'is-visible');
        });
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const element = entry.target as HTMLElement;
              if (entry.isIntersecting) {
                const section = element.closest<HTMLElement>('section');
                const sectionIndex = Number(section?.dataset.scrollMotionSection || 0);
                const pass = revealPasses.get(element) || 0;
                const itemIndex = revealOrder.get(element) || 0;
                element.dataset.motionStyle = revealStyles[(sectionIndex + itemIndex + pass) % revealStyles.length];
                revealPasses.set(element, pass + 1);
                const frame = (revealFrames.get(element) || 0) + 1;
                revealFrames.set(element, frame);
                element.classList.remove('visible', 'is-visible');
                window.requestAnimationFrame(() => {
                  const bounds = element.getBoundingClientRect();
                  if (revealFrames.get(element) === frame && bounds.bottom > 0 && bounds.top < window.innerHeight) {
                    element.classList.add('visible', 'is-visible');
                  }
                });
              } else {
                revealFrames.set(element, (revealFrames.get(element) || 0) + 1);
                element.classList.remove('visible', 'is-visible');
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -55px 0px' }
        );

        revealElements.forEach((element, index) => {
          element.classList.remove('visible', 'is-visible');
          const sectionIndex = Number(element.closest<HTMLElement>('section')?.dataset.scrollMotionSection || 0);
          element.dataset.motionStyle = revealStyles[(sectionIndex + index) % revealStyles.length];
          revealPasses.set(element, 0);
        });
        afterCmsReveal(() => revealElements.forEach((element) => observer.observe(element)));
      }
    </script>
  </body>
</html>
